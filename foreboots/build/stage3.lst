    35                                  %include "forebo64.h"
     1                              <1> ; =============================================================================
     2                              <1> ; ForeB - Forest Bootloader
     3                              <1> ; forebo64.h (NASM include) - Extended macros & structures
     4                              <1> ; =============================================================================
     5                              <1> ; Include after config.h. Adds macros for:
     6                              <1> ;   - E820 memory map collection
     7                              <1> ;   - LBA disk read with CHS fallback
     8                              <1> ;   - CPUID / long-mode capability detection
     9                              <1> ;   - 64-bit GDT and long-mode trampoline helpers
    10                              <1> ;   - ELF header structures for stage3
    11                              <1> ;
    12                              <1> ; These extend the original macro library in forebo.h.
    13                              <1> 
    14                              <1> %ifndef FOREBO64_H
    15                              <1> %define FOREBO64_H
    16                              <1> 
    17                              <1> ; =============================================================================
    18                              <1> ; MACRO: serial_print  string_label
    19                              <1> ; Initialize COM1 (FOREB_COM1_BASE) to 8N1/115200 and print a NUL-terminated
    20                              <1> ; string via LSR (THRE) polling. Self-contained: re-runs the idempotent port
    21                              <1> ; init on each call so it works whether or not the port was set up earlier.
    22                              <1> ; Assembles correctly in both 16-bit real mode (stage2) and 32-bit protected
    23                              <1> ; mode (stage3) - the string pointer register width follows __BITS__, and the
    24                              <1> ; in/out port I/O is identical in either mode. The string must be reachable
    25                              <1> ; through DS (stage2: DS=stage2 segment; stage3: flat DS base 0).
    26                              <1> ; Preserves ALL general-purpose registers and flags.
    27                              <1> ; =============================================================================
    28                              <1> %macro serial_print 1
    29                              <1>     pushf
    30                              <1>     pusha
    31                              <1>     ; --- COM1 8N1, divisor 1 (115200 baud) ---
    32                              <1>     mov  dx, FOREB_COM1_BASE + 1        ; IER: disable interrupts
    33                              <1>     xor  al, al
    34                              <1>     out  dx, al
    35                              <1>     mov  dx, FOREB_COM1_BASE + 3        ; LCR: enable DLAB
    36                              <1>     mov  al, 0x80
    37                              <1>     out  dx, al
    38                              <1>     mov  dx, FOREB_COM1_BASE + 0        ; DLL = 1
    39                              <1>     mov  al, 0x01
    40                              <1>     out  dx, al
    41                              <1>     mov  dx, FOREB_COM1_BASE + 1        ; DLM = 0
    42                              <1>     xor  al, al
    43                              <1>     out  dx, al
    44                              <1>     mov  dx, FOREB_COM1_BASE + 3        ; LCR: 8N1, DLAB off
    45                              <1>     mov  al, 0x03
    46                              <1>     out  dx, al
    47                              <1>     mov  dx, FOREB_COM1_BASE + 2        ; FCR: enable+clear FIFO, 14-byte
    48                              <1>     mov  al, 0xC7
    49                              <1>     out  dx, al
    50                              <1>     mov  dx, FOREB_COM1_BASE + 4        ; MCR: DTR|RTS|OUT2
    51                              <1>     mov  al, 0x0B
    52                              <1>     out  dx, al
    53                              <1>     ; --- print loop ---
    54                              <1> %if __BITS__ == 16
    55                              <1>     mov  si, %1
    56                              <1> %else
    57                              <1>     mov  esi, %1
    58                              <1> %endif
    59                              <1> %%sp_next:
    60                              <1> %if __BITS__ == 16
    61                              <1>     mov  al, [si]
    62                              <1>     inc  si
    63                              <1> %else
    64                              <1>     mov  al, [esi]
    65                              <1>     inc  esi
    66                              <1> %endif
    67                              <1>     test al, al
    68                              <1>     jz   %%sp_done
    69                              <1>     mov  bl, al                         ; hold char while polling LSR
    70                              <1> %%sp_wait:
    71                              <1>     mov  dx, FOREB_COM1_BASE + 5        ; LSR
    72                              <1>     in   al, dx
    73                              <1>     test al, 0x20                       ; THRE (transmit holding empty)
    74                              <1>     jz   %%sp_wait
    75                              <1>     mov  al, bl
    76                              <1>     mov  dx, FOREB_COM1_BASE + 0        ; THR
    77                              <1>     out  dx, al
    78                              <1>     jmp  %%sp_next
    79                              <1> %%sp_done:
    80                              <1>     popa
    81                              <1>     popf
    82                              <1> %endmacro
    83                              <1> 
    84                              <1> ; =============================================================================
    85                              <1> ; MACRO: e820_collect
    86                              <1> ; Collect INT 15h E820 memory map into foreboots_mmap_entry array at
    87                              <1> ; FOREB_MMAP_ADDRESS. Stores up to FOREB_MMAP_MAX entries.
    88                              <1> ; On return:
    89                              <1> ;   [boot_info + foreboots_boot_info.mmap_count] = number of entries
    90                              <1> ;   [boot_info + foreboots_boot_info.mmap_addr]   = FOREB_MMAP_ADDRESS
    91                              <1> ; Clobbers: EAX, EBX, ECX, EDX, ESI, EDI, ES, flags
    92                              <1> ; Assumes DS=0 for the destination buffer (physical addresses).
    93                              <1> ; =============================================================================
    94                              <1> %macro e820_collect 0
    95                              <1>     push    ds
    96                              <1>     push    es
    97                              <1>     pushad                          ; preserve all regs; EBP = entry counter
    98                              <1>     xor     ax, ax
    99                              <1>     mov     ds, ax
   100                              <1>     mov     es, ax
   101                              <1>     mov     edi, FOREB_MMAP_ADDRESS ; ES:DI -> current foreboots_mmap_entry slot
   102                              <1>     xor     ebx, ebx                ; continuation value (0 = start)
   103                              <1>     xor     ebp, ebp                ; EBP = entry count (saved across int 0x15)
   104                              <1> %%e820_loop:
   105                              <1>     cmp     ebp, FOREB_MMAP_MAX
   106                              <1>     jae     %%e820_done             ; table full
   107                              <1>     mov     eax, 0x0000E820
   108                              <1>     mov     ecx, 24
   109                              <1>     mov     dword [es:edi + 20], 1  ; default ACPI attr = valid, in the DEST slot
   110                              <1>     mov     edx, 0x534D4150         ; 'SMAP'
   111                              <1>     ; INT 15h/E820 writes the entry straight to ES:DI (= this array slot). The
   112                              <1>     ; previous version pointed the BIOS at the array but then overwrote the slot
   113                              <1>     ; with an uninitialised scratch buffer, yielding a 0-byte memory map.
   114                              <1>     int     0x15
   115                              <1>     jc      %%e820_done             ; carry = end / error
   116                              <1>     cmp     eax, 0x534D4150         ; BIOS must return 'SMAP'
   117                              <1>     jne     %%e820_done
   118                              <1>     cmp     ecx, 20
   119                              <1>     jb      %%e820_next             ; entry too small; don't count it
   120                              <1>     inc     ebp
   121                              <1>     add     edi, foreboots_mmap_entry_size   ; advance to the next slot
   122                              <1> %%e820_next:
   123                              <1>     test    ebx, ebx
   124                              <1>     jz      %%e820_done
   125                              <1>     jmp     %%e820_loop
   126                              <1> 
   127                              <1> %%e820_done:
   128                              <1>     mov     [boot_info + foreboots_boot_info.mmap_count], ebp
   129                              <1>     mov     dword [boot_info + foreboots_boot_info.mmap_addr], FOREB_MMAP_ADDRESS
   130                              <1>     popad
   131                              <1>     pop     es
   132                              <1>     pop     ds
   133                              <1> %endmacro
   134                              <1> 
   135                              <1> ; =============================================================================
   136                              <1> ; MACRO: lba_read_one  drive_src
   137                              <1> ; Read ECX sectors (clamped to 63) from LBA EAX to physical address ESI using
   138                              <1> ; INT 13h AH=42h. Falls back to CHS (AH=02h, 1 sector at a time) if LBA
   139                              <1> ; extensions are unsupported by the BIOS.
   140                              <1> ;   EAX       = starting LBA
   141                              <1> ;   ECX       = sector count (clamped to 63 internally)
   142                              <1> ;   ESI       = physical destination address (seg:off derived as phys/16 : &0xF)
   143                              <1> ;   [drive_src] = memory location (DS=0 accessible) holding the BIOS drive byte
   144                              <1> ; On success CF=0; on failure CF=1. Preserves ALL caller registers.
   145                              <1> ; For reads larger than 63 sectors, call this in a loop (see stage2 disk_load).
   146                              <1> ; =============================================================================
   147                              <1> %macro lba_read_one 1
   148                              <1>     push    eax
   149                              <1>     push    ecx
   150                              <1>     push    edx
   151                              <1>     push    esi
   152                              <1>     push    edi
   153                              <1>     push    ebx
   154                              <1>     push    ebp
   155                              <1>     push    es
   156                              <1>     push    ds
   157                              <1>     xor     ax, ax
   158                              <1>     mov     ds, ax                      ; DS=0 for DAP / drive_src
   159                              <1>     ; Save LBA + count into the DAP first (before any INT 13h clobbers EAX)
   160                              <1>     mov     [DAP_BUF + 8], eax          ; LBA low
   161                              <1>     mov     dword [DAP_BUF + 12], 0     ; LBA high
   162                              <1>     mov     ebp, ecx                    ; EBP = sector count (preserve)
   163                              <1>     cmp     ebp, 63
   164                              <1>     jbe     %%lro_cnt_ok
   165                              <1>     mov     ebp, 63
   166                              <1> %%lro_cnt_ok:
   167                              <1>     ; Destination seg:off from ESI
   168                              <1>     mov     edx, esi
   169                              <1>     shr     edx, 4                      ; seg
   170                              <1>     mov     edi, esi
   171                              <1>     and     edi, 0x000F                 ; off
   172                              <1>     mov     word [DAP_BUF + 0], 0x0010
   173                              <1>     mov     [DAP_BUF + 4], di
   174                              <1>     mov     [DAP_BUF + 6], dx
   175                              <1>     ; Check LBA extensions support
   176                              <1>     mov     ah, 0x41
   177                              <1>     mov     bx, 0x55AA
   178                              <1>     mov     dl, [%1]
   179                              <1>     int     0x13
   180                              <1>     jc      %%lro_chs
   181                              <1>     cmp     bx, 0xAA55
   182                              <1>     jne     %%lro_chs
   183                              <1>     test    cl, 0x01
   184                              <1>     jz      %%lro_chs
   185                              <1>     ; --- LBA path: one INT 13h AH=42h call for all EBP sectors ---
   186                              <1>     mov     [DAP_BUF + 2], bp           ; count (word)
   187                              <1>     mov     si, DAP_BUF
   188                              <1>     mov     dl, [%1]
   189                              <1>     mov     ah, 0x42
   190                              <1>     int     0x13
   191                              <1>     jc      %%lro_fail
   192                              <1>     clc
   193                              <1>     jmp     %%lro_ret
   194                              <1>     ; --- CHS fallback: read EBP sectors, one per iteration ---
   195                              <1> %%lro_chs:
   196                              <1>     mov     [DAP_BUF + 2], bp           ; not used by CHS, keep for record
   197                              <1> %%lro_chs_loop:
   198                              <1>     test    ebp, ebp
   199                              <1>     jz      %%lro_ok
   200                              <1>     mov     eax, [DAP_BUF + 8]          ; current LBA
   201                              <1>     xor     edx, edx
   202                              <1>     mov     ecx, 63
   203                              <1>     div     ecx                         ; eax = LBA/63, edx = sector-1
   204                              <1>     inc     edx                         ; edx = sector
   205                              <1>     push    edx                         ; save sector
   206                              <1>     xor     edx, edx
   207                              <1>     mov     ecx, 16
   208                              <1>     div     ecx                         ; eax = cylinder, edx = head
   209                              <1>     push    edx                         ; save head
   210                              <1>     mov     ch, al                      ; CH = cyl low
   211                              <1>     mov     edx, eax
   212                              <1>     shr     edx, 8
   213                              <1>     and     edx, 0xC0                   ; high cyl bits
   214                              <1>     pop     eax                         ; head
   215                              <1>     mov     dh, al                      ; DH = head
   216                              <1>     pop     eax                         ; sector
   217                              <1>     mov     cl, al                      ; CL = sector (low 6 bits)
   218                              <1>     or      cl, dl                      ; CL |= high cyl bits
   219                              <1>     ; Buffer ES:BX from ESI
   220                              <1>     mov     eax, esi
   221                              <1>     shr     eax, 4                      ; seg
   222                              <1>     mov     edx, esi
   223                              <1>     and     edx, 0x0F                   ; off
   224                              <1>     push    es
   225                              <1>     mov     es, ax
   226                              <1>     mov     bx, dx                      ; BX = buffer offset
   227                              <1>     mov     dl, [%1]                    ; DL = drive (DH preserved)
   228                              <1>     mov     eax, 0x0201                 ; AH=02, AL=1 sector
   229                              <1>     int     0x13
   230                              <1>     pop     es
   231                              <1>     jc      %%lro_fail
   232                              <1>     inc     dword [DAP_BUF + 8]         ; LBA++
   233                              <1>     add     esi, 512                    ; dest += 512
   234                              <1>     dec     ebp
   235                              <1>     jmp     %%lro_chs_loop
   236                              <1> %%lro_ok:
   237                              <1>     clc
   238                              <1>     jmp     %%lro_ret
   239                              <1> %%lro_fail:
   240                              <1>     stc
   241                              <1> %%lro_ret:
   242                              <1>     pop     ds
   243                              <1>     pop     es
   244                              <1>     pop     ebp
   245                              <1>     pop     ebx
   246                              <1>     pop     edi
   247                              <1>     pop     esi
   248                              <1>     pop     edx
   249                              <1>     pop     ecx
   250                              <1>     pop     eax
   251                              <1> %endmacro
   252                              <1> 
   253                              <1> ; =============================================================================
   254                              <1> ; MACRO: detect_long_mode
   255                              <1> ; Detect CPUID and long-mode availability. Sets the cpuid_available,
   256                              <1> ; long_mode_available, pae_available fields in boot_info and the corresponding
   257                              <1> ; FOREB_BIF_* bits in flags. Falls back gracefully on 386/486.
   258                              <1> ; Clobbers: EAX, EBX, ECX, EDX, flags
   259                              <1> ; =============================================================================
   260                              <1> %macro detect_long_mode 0
   261                              <1>     push    ds
   262                              <1>     pushad
   263                              <1>     xor     ax, ax
   264                              <1>     mov     ds, ax                      ; DS=0 to access boot_info (physical 0x1000)
   265                              <1>     ; CPUID availability: flip ID bit (EFLAGS bit 21)
   266                              <1>     pushfd
   267                              <1>     pop     eax
   268                              <1>     mov     ecx, eax
   269                              <1>     xor     eax, 1 << 21
   270                              <1>     push    eax
   271                              <1>     popfd
   272                              <1>     pushfd
   273                              <1>     pop     eax
   274                              <1>     push    ecx
   275                              <1>     popfd
   276                              <1>     cmp     eax, ecx
   277                              <1>     je      %%no_cpuid
   278                              <1>     ; CPUID present
   279                              <1>     mov     dword [boot_info + foreboots_boot_info.cpuid_available], 1
   280                              <1>     or      dword [boot_info + foreboots_boot_info.flags], FOREB_BIF_CPUID
   281                              <1> 
   282                              <1>     ; PAE: CPUID(1) -> EDX bit 6
   283                              <1>     mov     eax, 1
   284                              <1>     cpuid
   285                              <1>     test    edx, 1 << 6
   286                              <1>     jz      %%no_pae
   287                              <1>     mov     dword [boot_info + foreboots_boot_info.pae_available], 1
   288                              <1>     or      dword [boot_info + foreboots_boot_info.flags], FOREB_BIF_PAE
   289                              <1> %%no_pae:
   290                              <1>     ; Extended CPUID for long mode: need 0x80000001
   291                              <1>     mov     eax, 0x80000000
   292                              <1>     cpuid
   293                              <1>     cmp     eax, 0x80000001
   294                              <1>     jb      %%done
   295                              <1>     mov     eax, 0x80000001
   296                              <1>     cpuid
   297                              <1>     test    edx, 1 << 29                 ; LM bit
   298                              <1>     jz      %%done
   299                              <1>     mov     dword [boot_info + foreboots_boot_info.long_mode_available], 1
   300                              <1>     or      dword [boot_info + foreboots_boot_info.flags], FOREB_BIF_LONG_MODE
   301                              <1>     jmp     %%done
   302                              <1> %%no_cpuid:
   303                              <1>     mov     dword [boot_info + foreboots_boot_info.cpuid_available], 0
   304                              <1>     mov     dword [boot_info + foreboots_boot_info.long_mode_available], 0
   305                              <1>     mov     dword [boot_info + foreboots_boot_info.pae_available], 0
   306                              <1> %%done:
   307                              <1>     popad
   308                              <1>     pop     ds
   309                              <1> %endmacro

     1                                  ; =============================================================================
     2                                  ; ForeB - Forest Bootloader  Stage 3
     3                                  ; stage3.asm - 32-bit protected-mode ELF loader + multiboot1 handoff
     4                                  ; =============================================================================
     5                                  ; Build:
     6                                  ;   nasm -f bin -o stage3.bin stage3.asm
     7                                  ;
     8                                  ; Loaded by stage2 at physical address STAGE3_LOAD_PHYS (0x5000), 16 sectors.
     9                                  ; Entered in 32-bit protected mode with flat segments (DS=ES=SS=0x10, base 0,
    10                                  ; limit 4 GB) by stage2's .pm32 trampoline, which passes:
    11                                  ;   ESI = physical address of foreboots_boot_info
    12                                  ;   EDI = physical address of multiboot_info_t (kernel handoff struct)
    13                                  ;
    14                                  ; Stage 3 responsibilities:
    15                                  ;   1. Parse the kernel ELF (ELF32 or ELF64) loaded at boot_info.kernel_load_addr
    16                                  ;   2. Copy each PT_LOAD segment to its physical address (p_paddr), zero-fill
    17                                  ;      the BSS (p_memsz - p_filesz)
    18                                  ;   3. Record the ELF entry point and ELF class in boot_info
    19                                  ;   4. Hand off to the kernel EXACTLY as GRUB does:
    20                                  ;        EAX = 0x2BADB002 (MULTIBOOT1_MAGIC)
    21                                  ;        EBX = &multiboot_info_t
    22                                  ;        EIP = kernel ELF entry
    23                                  ;      The Forest OS kernel enters in 32-bit PM (even the 64-bit kernel does
    24                                  ;      its own long-mode transition in src/boot64.asm), so this is the default
    25                                  ;      and correct path for both ARCH=32 and ARCH=64.
    26                                  ;   5. Optional long-mode trampoline (FOREB_FORCE_LONG_MODE=1): if the CPU
    27                                  ;      supports long mode and the kernel is ELF64, set up paging/PAE/long-mode
    28                                  ;      and jump to the 64-bit entry. Disabled by default (current kernel does
    29                                  ;      its own transition). Falls back to 32-bit PM entry if unavailable.
    30                                  ; =============================================================================
    31                                  
    32                                  [BITS 32]
    33                                  
    34                                  %include "config.h"
     1                              <1> ; =============================================================================
     2                              <1> ; ForeB - Forest Bootloader
     3                              <1> ; config.h (NASM include) - Boot Configuration Constants & Struct Layouts
     4                              <1> ; =============================================================================
     5                              <1> ; Included by stage1.asm, stage2.asm, stage3.asm via %include.
     6                              <1> ;
     7                              <1> ; Every tunable below is wrapped in %ifndef so the main build can override it
     8                              <1> ; on the NASM command line with -D, e.g.:
     9                              <1> ;     nasm -f bin -DFOREBO_DEFAULT_WIDTH=1280 -DFOREBO_DEFAULT_HEIGHT=720 ...
    10                              <1> ;
    11                              <1> ; All addresses are PHYSICAL (real-mode / flat PM) unless noted.
    12                              <1> ; =============================================================================
    13                              <1> 
    14                              <1> %ifndef FOREB_CONFIG_H
    15                              <1> %define FOREB_CONFIG_H
    16                              <1> 
    17                              <1> ; -----------------------------------------------------------------------------
    18                              <1> ; ForeB version
    19                              <1> ; -----------------------------------------------------------------------------
    20                              <1> %ifndef FOREB_VERSION_MAJOR
    21                              <1> %define FOREB_VERSION_MAJOR    2
    22                              <1> %endif
    23                              <1> %ifndef FOREB_VERSION_MINOR
    24                              <1> %define FOREB_VERSION_MINOR    0
    25                              <1> %endif
    26                              <1> 
    27                              <1> ; -----------------------------------------------------------------------------
    28                              <1> ; Disk Layout (LBA sectors, 512 bytes each)
    29                              <1> ; -----------------------------------------------------------------------------
    30                              <1> ;   Sector  0          : Stage 1 (MBR, 512 bytes + partition table + 0xAA55)
    31                              <1> ;   Sectors 1..16      : Stage 2  (16 sectors = 8192 bytes, real-mode GUI/BIOS)
    32                              <1> ;   Sectors 17..32     : Stage 3  (16 sectors = 8192 bytes, PM/long-mode trampoline)
    33                              <1> ;   Sector  48+        : Kernel ELF image (raw file, parsed by stage3)
    34                              <1> ;   Sector  (48+K)..   : Optional initrd (if FOREB_INITRD_START_SECTOR != 0)
    35                              <1> %ifndef STAGE2_START_SECTOR
    36                              <1> %define STAGE2_START_SECTOR    1
    37                              <1> %endif
    38                              <1> %ifndef STAGE2_SECTOR_COUNT
    39                              <1> %define STAGE2_SECTOR_COUNT    16
    40                              <1> %endif
    41                              <1> %ifndef STAGE2_LOAD_SEG
    42                              <1> %define STAGE2_LOAD_SEG        0x0800      ; physical 0x8000
    43                              <1> %endif
    44                              <1> %ifndef STAGE2_LOAD_OFF
    45                              <1> %define STAGE2_LOAD_OFF        0x0000
    46                              <1> %endif
    47                              <1> 
    48                              <1> %ifndef STAGE3_START_SECTOR
    49                              <1> %define STAGE3_START_SECTOR    17
    50                              <1> %endif
    51                              <1> %ifndef STAGE3_SECTOR_COUNT
    52                              <1> %define STAGE3_SECTOR_COUNT    16
    53                              <1> %endif
    54                              <1> %ifndef STAGE3_LOAD_SEG
    55                              <1> %define STAGE3_LOAD_SEG        0x0500      ; physical 0x5000
    56                              <1> %endif
    57                              <1> %ifndef STAGE3_LOAD_OFF
    58                              <1> %define STAGE3_LOAD_OFF        0x0000
    59                              <1> %endif
    60                              <1> %define STAGE3_LOAD_PHYS       (STAGE3_LOAD_SEG * 16 + STAGE3_LOAD_OFF)
    61                              <1> 
    62                              <1> %ifndef KERNEL_START_SECTOR
    63                              <1> %define KERNEL_START_SECTOR    48
    64                              <1> %endif
    65                              <1> %ifndef KERNEL_LOAD_SEG
    66                              <1> %define KERNEL_LOAD_SEG        0x1000      ; physical 0x10000 (ELF file buffer)
    67                              <1> %endif
    68                              <1> %ifndef KERNEL_LOAD_OFF
    69                              <1> %define KERNEL_LOAD_OFF        0x0000
    70                              <1> %endif
    71                              <1> %define KERNEL_LOAD_PHYS       (KERNEL_LOAD_SEG * 16 + KERNEL_LOAD_OFF)
    72                              <1> %ifndef KERNEL_MAX_SECTORS
    73                              <1> %define KERNEL_MAX_SECTORS     512         ; (legacy) old whole-file load cap
    74                              <1> %endif
    75                              <1> %ifndef KERNEL_MAX_BYTES
    76                              <1> %define KERNEL_MAX_BYTES       (KERNEL_MAX_SECTORS * 512)
    77                              <1> %endif
    78                              <1> 
    79                              <1> ; ---------------------------------------------------------------------------
    80                              <1> ; Streaming kernel loader (stage2) — loads arbitrarily large kernels of any
    81                              <1> ; size directly to each PT_LOAD segment's physical address, GRUB-style, with
    82                              <1> ; no whole-file buffer. BIOS INT 13h can only DMA to real-mode-addressable
    83                              <1> ; low memory (<1 MiB), so segments are read into a low bounce buffer and then
    84                              <1> ; copied up to their (possibly >1 MiB) destinations via unreal mode (FS flat).
    85                              <1> ;
    86                              <1> ;   KERNEL_HDR_BUF      : low buffer holding the ELF header + program headers
    87                              <1> ;   KERNEL_HDR_SECTORS  : how many leading kernel sectors to slurp for headers
    88                              <1> ;   KERNEL_BOUNCE_BUF   : low buffer that each segment is streamed through
    89                              <1> ;   KERNEL_BOUNCE_SECTORS: sectors per INT 13h chunk (<=63 for a single call)
    90                              <1> ; Both buffers live in free conventional RAM (0x10000..0x27FFF, below 640 KiB)
    91                              <1> ; and never overlap stage2 (0x8000) / stage3 (0x5000) / boot_info (0x1000).
    92                              <1> ; ---------------------------------------------------------------------------
    93                              <1> %ifndef KERNEL_HDR_BUF
    94                              <1> %define KERNEL_HDR_BUF         0x00010000
    95                              <1> %endif
    96                              <1> %ifndef KERNEL_HDR_SECTORS
    97                              <1> %define KERNEL_HDR_SECTORS     32          ; 16 KiB of ELF header + phdr table
    98                              <1> %endif
    99                              <1> %ifndef KERNEL_BOUNCE_BUF
   100                              <1> %define KERNEL_BOUNCE_BUF      0x00020000
   101                              <1> %endif
   102                              <1> %ifndef KERNEL_BOUNCE_SECTORS
   103                              <1> %define KERNEL_BOUNCE_SECTORS  63          ; 31.5 KiB per disk read
   104                              <1> %endif
   105                              <1> 
   106                              <1> ; Optional initrd. Set to 0 to disable. If non-zero, stage2 loads it to
   107                              <1> ; INITRD_LOAD_PHYS and stage3 registers it as multiboot module 0.
   108                              <1> %ifndef FOREB_INITRD_START_SECTOR
   109                              <1> %define FOREB_INITRD_START_SECTOR 0
   110                              <1> %endif
   111                              <1> %ifndef INITRD_LOAD_SEG
   112                              <1> %define INITRD_LOAD_SEG        0x4000      ; physical 0x40000
   113                              <1> %endif
   114                              <1> %ifndef INITRD_LOAD_OFF
   115                              <1> %define INITRD_LOAD_OFF        0x0000
   116                              <1> %endif
   117                              <1> %define INITRD_LOAD_PHYS       (INITRD_LOAD_SEG * 16 + INITRD_LOAD_OFF)
   118                              <1> %ifndef INITRD_MAX_SECTORS
   119                              <1> %define INITRD_MAX_SECTORS     512
   120                              <1> %endif
   121                              <1> 
   122                              <1> ; GRUB chain-load sector (legacy fallback, 0 = disabled)
   123                              <1> %ifndef GRUB_CHAINLOAD_SECTOR
   124                              <1> %define GRUB_CHAINLOAD_SECTOR  0
   125                              <1> %endif
   126                              <1> 
   127                              <1> ; -----------------------------------------------------------------------------
   128                              <1> ; Boot menu tunables
   129                              <1> ; -----------------------------------------------------------------------------
   130                              <1> %ifndef FOREB_DEFAULT_TIMEOUT
   131                              <1> %define FOREB_DEFAULT_TIMEOUT  5           ; seconds before auto-boot
   132                              <1> %endif
   133                              <1> %ifndef FOREB_DEFAULT_ENTRY
   134                              <1> %define FOREB_DEFAULT_ENTRY    0           ; 0-based default selection
   135                              <1> %endif
   136                              <1> 
   137                              <1> ; Boot menu entries (indices)
   138                              <1> %define ENTRY_DEFAULT          0           ; Forest OS (default, best VBE)
   139                              <1> %define ENTRY_NOFB             1           ; Forest OS (text mode, no framebuffer)
   140                              <1> %define ENTRY_SAFE             2           ; Forest OS (safe mode)
   141                              <1> %define ENTRY_REBOOT           3           ; Reboot
   142                              <1> %define BOOT_ENTRY_COUNT       4
   143                              <1> 
   144                              <1> ; -----------------------------------------------------------------------------
   145                              <1> ; VBE / video tunables
   146                              <1> ; -----------------------------------------------------------------------------
   147                              <1> ; Preferred mode. stage2 enumerates all VBE modes and picks the best match for
   148                              <1> ; (FOREB_DEFAULT_WIDTH x FOREB_DEFAULT_HEIGHT x FOREB_DEFAULT_BPP), then walks
   149                              <1> ; the fallback chain below if unavailable, finally falling back to text 03h.
   150                              <1> %ifndef FOREB_DEFAULT_WIDTH
   151                              <1> %define FOREB_DEFAULT_WIDTH    1920
   152                              <1> %endif
   153                              <1> %ifndef FOREB_DEFAULT_HEIGHT
   154                              <1> %define FOREB_DEFAULT_HEIGHT   1080
   155                              <1> %endif
   156                              <1> %ifndef FOREB_DEFAULT_BPP
   157                              <1> %define FOREB_DEFAULT_BPP      32
   158                              <1> %endif
   159                              <1> 
   160                              <1> ; Text mode fallback (VGA INT 10h mode)
   161                              <1> %define VGA_TEXT_MODE          0x0003
   162                              <1> 
   163                              <1> ; Framebuffer-mode fallback chain. stage2 first tries the preferred
   164                              <1> ; FOREB_DEFAULT_* resolution; if the BIOS/VBE cannot provide it, it walks down
   165                              <1> ; to this smaller, near-universal linear mode before finally dropping to text
   166                              <1> ; 03h. These are additive tunables (a %ifndef override lets the build pick a
   167                              <1> ; different fallback); they do not change existing mode-selection logic.
   168                              <1> %ifndef FOREB_FB_FALLBACK_WIDTH
   169                              <1> %define FOREB_FB_FALLBACK_WIDTH   1024
   170                              <1> %endif
   171                              <1> %ifndef FOREB_FB_FALLBACK_HEIGHT
   172                              <1> %define FOREB_FB_FALLBACK_HEIGHT  768
   173                              <1> %endif
   174                              <1> %ifndef FOREB_FB_FALLBACK_BPP
   175                              <1> %define FOREB_FB_FALLBACK_BPP     32
   176                              <1> %endif
   177                              <1> ; Last-resort linear mode before text: 640x480, allowed BPP floor.
   178                              <1> %ifndef FOREB_FB_MIN_WIDTH
   179                              <1> %define FOREB_FB_MIN_WIDTH        640
   180                              <1> %endif
   181                              <1> %ifndef FOREB_FB_MIN_HEIGHT
   182                              <1> %define FOREB_FB_MIN_HEIGHT       480
   183                              <1> %endif
   184                              <1> %ifndef FOREB_FB_MIN_BPP
   185                              <1> %define FOREB_FB_MIN_BPP          16
   186                              <1> %endif
   187                              <1> 
   188                              <1> ; -----------------------------------------------------------------------------
   189                              <1> ; Serial debug (COM1) - proof-of-progress banners on the BIOS boot path
   190                              <1> ; -----------------------------------------------------------------------------
   191                              <1> ; When FOREB_SERIAL_DEBUG is non-zero, stage2/stage3 emit a short banner over
   192                              <1> ; COM1 (8N1) so `qemu ... -serial stdio` shows the loader is making progress.
   193                              <1> ; Default ON; override with -DFOREB_SERIAL_DEBUG=0 to silence.
   194                              <1> %ifndef FOREB_SERIAL_DEBUG
   195                              <1> %define FOREB_SERIAL_DEBUG     1
   196                              <1> %endif
   197                              <1> %ifndef FOREB_COM1_BASE
   198                              <1> %define FOREB_COM1_BASE        0x3F8       ; COM1 I/O port base
   199                              <1> %endif
   200                              <1> 
   201                              <1> ; -----------------------------------------------------------------------------
   202                              <1> ; Boot info struct address (ForeB's own rich structure)
   203                              <1> ; -----------------------------------------------------------------------------
   204                              <1> %ifndef BOOT_INFO_ADDRESS
   205                              <1> %define BOOT_INFO_ADDRESS      0x00001000  ; foreboots_boot_info
   206                              <1> %endif
   207                              <1> %ifndef FOREB_MMAP_ADDRESS
   208                              <1> %define FOREB_MMAP_ADDRESS     0x00001100  ; foreboots_mmap_entry[FOREB_MMAP_MAX]
   209                              <1> %endif
   210                              <1> %ifndef MB_MMAP_ADDRESS
   211                              <1> %define MB_MMAP_ADDRESS        0x00001400  ; multiboot1 mmap entries
   212                              <1> %endif
   213                              <1> %ifndef MULTIBOOT_INFO_ADDR
   214                              <1> %define MULTIBOOT_INFO_ADDR    0x00001800  ; multiboot_info_t (kernel handoff)
   215                              <1> %endif
   216                              <1> %ifndef FOREB_MMAP_MAX
   217                              <1> %define FOREB_MMAP_MAX         32          ; max E820 entries stored
   218                              <1> %endif
   219                              <1> 
   220                              <1> ; E820 scratch buffer (one entry, 32 bytes) for INT 15h E820 calls
   221                              <1> %ifndef E820_SCRATCH
   222                              <1> %define E820_SCRATCH           0x00000520
   223                              <1> %endif
   224                              <1> 
   225                              <1> ; -----------------------------------------------------------------------------
   226                              <1> ; Low-memory buffer layout
   227                              <1> ; -----------------------------------------------------------------------------
   228                              <1> %ifndef DAP_BUF
   229                              <1> %define DAP_BUF                0x00000500  ; Disk Address Packet (16 bytes)
   230                              <1> %endif
   231                              <1> ; LBA base offset for El Torito no-emulation CD boot.  Stage1 fills this
   232                              <1> ; dword with (boot_image_lba * 4) when a valid boot info table is detected,
   233                              <1> ; 0 for hard disk boot.  Stage2's disk_load adds it to every LBA read.
   234                              <1> %ifndef LBA_BASE_OFFSET
   235                              <1> %define LBA_BASE_OFFSET        0x00000510  ; dword: 512-byte sector offset (0=HDD)
   236                              <1> %endif
   237                              <1> ; El Torito boot info table field offsets (relative to boot image start)
   238                              <1> %define BTI_PVD_LBA            8           ; dword: PVD LBA in 2048-byte sectors
   239                              <1> %define BTI_BOOT_IMAGE_LBA     12          ; dword: boot image LBA (2048-byte)
   240                              <1> %define ISO9660_PVD_LBA        16          ; PVD is always at sector 16
   241                              <1> %ifndef VBEINFO_OFF
   242                              <1> %define VBEINFO_OFF            0x00002000  ; VBE controller info (512 bytes)
   243                              <1> %endif
   244                              <1> %ifndef VBEMODEINFO_OFF
   245                              <1> %define VBEMODEINFO_OFF        0x00002200  ; VBE mode info (256 bytes)
   246                              <1> %endif
   247                              <1> %ifndef PALETTE_BUF
   248                              <1> %define PALETTE_BUF            0x00002400  ; DAC palette (768 bytes)
   249                              <1> %endif
   250                              <1> 
   251                              <1> ; Stack for stage1 (grows down from 0x7C00)
   252                              <1> %ifndef STACK_TOP
   253                              <1> %define STACK_TOP              0x7C00
   254                              <1> %endif
   255                              <1> 
   256                              <1> ; -----------------------------------------------------------------------------
   257                              <1> ; Menu colors (8bpp palette indices; reprogrammed by stage2)
   258                              <1> ; -----------------------------------------------------------------------------
   259                              <1> %define FOREB_BG               16
   260                              <1> %define FOREB_PANEL            17
   261                              <1> %define FOREB_BORDER           18
   262                              <1> %define FOREB_SELECT           19
   263                              <1> %define FOREB_TITLE            20
   264                              <1> %define FOREB_TEXT             21
   265                              <1> %define FOREB_DIM              22
   266                              <1> %define FOREB_TIMER            23
   267                              <1> %define FOREB_WHITE            24
   268                              <1> %define FOREB_SHADOW           25
   269                              <1> %define FOREB_TREE1            26
   270                              <1> %define FOREB_TREE2            27
   271                              <1> %define FOREB_TREE3            28
   272                              <1> 
   273                              <1> ; Text-mode colors (VGA attribute, low nibble fg, high nibble bg)
   274                              <1> %define TEXT_ATTR_GREEN        0x0A
   275                              <1> %define TEXT_ATTR_LGREEN       0x0B
   276                              <1> %define TEXT_ATTR_WHITE        0x0F
   277                              <1> %define TEXT_ATTR_HIGHLIGHT    0x30        ; black on cyan
   278                              <1> 
   279                              <1> ; -----------------------------------------------------------------------------
   280                              <1> ; UI layout (pixels, designed for >= 800x600; clamped at runtime)
   281                              <1> ; -----------------------------------------------------------------------------
   282                              <1> %define MENU_X                 160
   283                              <1> %define MENU_Y                 160
   284                              <1> %define MENU_W                 480
   285                              <1> %define MENU_H                 300
   286                              <1> %define TITLE_X                200
   287                              <1> %define TITLE_Y                60
   288                              <1> %define TIMER_X                340
   289                              <1> %define TIMER_Y                480
   290                              <1> %define ENTRY_Y_START          240
   291                              <1> %define ENTRY_HEIGHT           32
   292                              <1> %define LOGO_X                 340
   293                              <1> %define LOGO_Y                 80
   294                              <1> 
   295                              <1> ; -----------------------------------------------------------------------------
   296                              <1> ; CPU / architecture detection
   297                              <1> ; -----------------------------------------------------------------------------
   298                              <1> ; If non-zero, stage3 will set up long mode itself and jump to a 64-bit entry.
   299                              <1> ; The current Forest OS kernel enters in 32-bit PM and does its own long-mode
   300                              <1> ; transition (see src/boot64.asm), so this defaults to 0 (disabled).
   301                              <1> %ifndef FOREB_FORCE_LONG_MODE
   302                              <1> %define FOREB_FORCE_LONG_MODE  0
   303                              <1> %endif
   304                              <1> 
   305                              <1> ; -----------------------------------------------------------------------------
   306                              <1> ; Magic values
   307                              <1> ; -----------------------------------------------------------------------------
   308                              <1> %define FOREB_BOOT_INFO_MAGIC  0x464F5242  ; "FORB"
   309                              <1> %define FOREB_BOOT_INFO_VER    0x00020000  ; v2.0
   310                              <1> 
   311                              <1> %define MULTIBOOT1_MAGIC       0x2BADB002  ; passed to kernel in EAX
   312                              <1> %define MULTIBOOT1_HEADER_MAGIC 0x1BADB002
   313                              <1> %define MULTIBOOT2_MAGIC       0x36d76289
   314                              <1> 
   315                              <1> ; Multiboot1 info flags
   316                              <1> %define MB_FLAG_MEM            0x00000001
   317                              <1> %define MB_FLAG_BOOT_DEVICE    0x00000002
   318                              <1> %define MB_FLAG_CMDLINE        0x00000004
   319                              <1> %define MB_FLAG_MODS           0x00000008
   320                              <1> %define MB_FLAG_MMAP           0x00000040
   321                              <1> %define MB_FLAG_BOOTLOADER     0x00000200
   322                              <1> %define MB_FLAG_FRAMEBUFFER    0x00001000
   323                              <1> 
   324                              <1> ; E820 memory types
   325                              <1> %define E820_USABLE            1
   326                              <1> %define E820_RESERVED          2
   327                              <1> %define E820_ACPI_RECLAIM      3
   328                              <1> %define E820_ACPI_NVS          4
   329                              <1> %define E820_BAD               5
   330                              <1> 
   331                              <1> ; VBE MemoryModel values
   332                              <1> %define VBE_MODEL_TEXT         0
   333                              <1> %define VBE_MODEL_CGA          1
   334                              <1> %define VBE_MODEL_HERCULES     2
   335                              <1> %define VBE_MODEL_PLANAR       3
   336                              <1> %define VBE_MODEL_PACKED       4
   337                              <1> %define VBE_MODEL_DIRECT       6
   338                              <1> %define VBE_MODEL_YUV          7
   339                              <1> 
   340                              <1> ; VBE ModeAttributes bits
   341                              <1> %define VBE_ATTR_SUPPORTED     0x0001
   342                              <1> %define VBE_ATTR_LFB           0x0080
   343                              <1> %define VBE_ATTR_GRAPHICS      0x0010
   344                              <1> 
   345                              <1> %define BIOS_VBE_LINEAR        0x4000
   346                              <1> 
   347                              <1> ; Keyboard scan codes
   348                              <1> %define KEY_UP                 0x48
   349                              <1> %define KEY_DOWN               0x50
   350                              <1> %define KEY_ENTER              0x1C
   351                              <1> %define KEY_ESCAPE             0x01
   352                              <1> 
   353                              <1> ; =============================================================================
   354                              <1> ; Structure: foreboots_boot_info  (ForeB's rich boot info, at BOOT_INFO_ADDRESS)
   355                              <1> ; Documented C layout in foreboots/README.md. Must stay in sync.
   356                              <1> ; =============================================================================
   357                              <1> struc foreboots_boot_info
   358 00000000 ????????            <1>     .magic              resd 1      ; FOREB_BOOT_INFO_MAGIC ("FORB")
   359 00000004 ????????            <1>     .version            resd 1      ; FOREB_BOOT_INFO_VER
   360 00000008 ????????            <1>     .flags              resd 1      ; FOREB_BIF_* below
   361 0000000C ????????            <1>     .boot_disk          resd 1      ; BIOS boot drive number (DL)
   362 00000010 ????????            <1>     .cmdline            resd 1      ; physical addr of cmdline string
   363 00000014 ????????            <1>     .boot_loader_name   resd 1      ; physical addr of bootloader name string
   364 00000018 ????????            <1>     .mem_lower          resd 1      ; KiB of usable memory below 1 MiB
   365 0000001C ????????            <1>     .mem_upper          resd 1      ; KiB of usable memory above 1 MiB
   366 00000020 ????????            <1>     .mmap_count         resd 1      ; number of valid entries at mmap_addr
   367 00000024 ????????            <1>     .mmap_addr          resd 1      ; physical addr of foreboots_mmap_entry[]
   368                              <1>     ; Framebuffer (filled when flags & FOREB_BIF_FRAMEBUFFER)
   369 00000028 ????????????????    <1>     .framebuffer_addr   resq 1      ; 64-bit physical LFB address (0 if text)
   370 00000030 ????????            <1>     .framebuffer_pitch  resd 1      ; bytes per scanline
   371 00000034 ????????            <1>     .framebuffer_width  resd 1
   372 00000038 ????????            <1>     .framebuffer_height resd 1
   373 0000003C ????????            <1>     .framebuffer_bpp    resd 1
   374 00000040 ????????            <1>     .framebuffer_type   resd 1      ; 0=indexed, 1=RGB, 2=EGA text
   375 00000044 ????                <1>     .vbe_mode           resw 1      ; VBE mode number set (0 if text)
   376 00000046 ????                <1>     .vbe_pad            resw 1
   377                              <1>     ; CPU capability detection
   378 00000048 ????????            <1>     .cpuid_available    resd 1
   379 0000004C ????????            <1>     .long_mode_available resd 1
   380 00000050 ????????            <1>     .pae_available      resd 1
   381                              <1>     ; Kernel image info (filled by stage2, used by stage3)
   382 00000054 ????????            <1>     .kernel_load_addr   resd 1      ; physical addr of raw ELF file buffer
   383 00000058 ????????            <1>     .kernel_size        resd 1      ; bytes loaded
   384 0000005C ????????            <1>     .kernel_entry       resd 1      ; ELF e_entry (physical, set by stage3)
   385 00000060 ????????            <1>     .kernel_is64bit     resd 1      ; 1 if ELF64, 0 if ELF32 (set by stage3)
   386                              <1>     ; Initrd
   387 00000064 ????????            <1>     .initrd_addr        resd 1      ; physical addr (0 if none)
   388 00000068 ????????            <1>     .initrd_size        resd 1
   389                              <1>     ; Selected boot entry index + mode flags
   390 0000006C ????????            <1>     .boot_entry         resd 1      ; ENTRY_* selected in menu
   391 00000070 ????????            <1>     .no_framebuffer     resd 1      ; 1 if text-mode boot requested
   392 00000074 ????????            <1>     .safe_mode          resd 1      ; 1 if safe-mode boot requested
   393                              <1>     ; Reserved for growth
   394 00000078 <res 20h>           <1>     .reserved           resd 8
   395                              <1> endstruc
   396                              <1> 
   397                              <1> ; foreboots_boot_info.flags bits
   398                              <1> %define FOREB_BIF_MMAP         0x00000001
   399                              <1> %define FOREB_BIF_FRAMEBUFFER  0x00000002
   400                              <1> %define FOREB_BIF_CMDLINE      0x00000004
   401                              <1> %define FOREB_BIF_LONG_MODE    0x00000008
   402                              <1> %define FOREB_BIF_CPUID        0x00000010
   403                              <1> %define FOREB_BIF_PAE          0x00000020
   404                              <1> %define FOREB_BIF_INITRD       0x00000040
   405                              <1> %define FOREB_BIF_NO_FB        0x00000080
   406                              <1> %define FOREB_BIF_SAFE         0x00000100
   407                              <1> ; Set by stage2 when it has already streamed every PT_LOAD segment to its
   408                              <1> ; physical address (arbitrary-size kernel loader). stage3 then skips its own
   409                              <1> ; in-memory ELF copy and jumps straight to boot_info.kernel_entry.
   410                              <1> %define FOREB_BIF_KERNEL_PRELOADED 0x00000200
   411                              <1> 
   412                              <1> ; =============================================================================
   413                              <1> ; Structure: foreboots_mmap_entry (ForeB's 64-bit-safe E820 entry, 24 bytes)
   414                              <1> ; =============================================================================
   415                              <1> struc foreboots_mmap_entry
   416 00000000 ????????????????    <1>     .base               resq 1      ; 64-bit base address
   417 00000008 ????????????????    <1>     .length             resq 1      ; 64-bit length
   418 00000010 ????????            <1>     .type               resd 1      ; E820 type (1=usable, 2=reserved, ...)
   419 00000014 ????????            <1>     .acpi               resd 1      ; ACPI 3.0 extended attributes
   420                              <1> endstruc
   421                              <1> 
   422                              <1> ; =============================================================================
   423                              <1> ; Structure: multiboot1 mmap entry (24 bytes, size field = 20)
   424                              <1> ; =============================================================================
   425                              <1> struc mb_mmap_entry
   426 00000000 ????????            <1>     .size               resd 1      ; = sizeof(entry) - 4 = 20
   427 00000004 ????????            <1>     .addr_low           resd 1
   428 00000008 ????????            <1>     .addr_high          resd 1
   429 0000000C ????????            <1>     .len_low            resd 1
   430 00000010 ????????            <1>     .len_high           resd 1
   431 00000014 ????????            <1>     .type               resd 1
   432                              <1> endstruc
   433                              <1> 
   434                              <1> ; =============================================================================
   435                              <1> ; Structure: multiboot1 info (passed to kernel in EBX) - matches kernel's
   436                              <1> ; src/include/multiboot.h multiboot_info_t
   437                              <1> ; =============================================================================
   438                              <1> struc mb_info
   439 00000000 ????????            <1>     .flags              resd 1
   440 00000004 ????????            <1>     .mem_lower          resd 1
   441 00000008 ????????            <1>     .mem_upper          resd 1
   442 0000000C ????????            <1>     .boot_device        resd 1
   443 00000010 ????????            <1>     .cmdline            resd 1
   444 00000014 ????????            <1>     .mods_count         resd 1
   445 00000018 ????????            <1>     .mods_addr          resd 1
   446 0000001C <res 10h>           <1>     .syms               resb 16
   447 0000002C ????????            <1>     .mmap_length        resd 1
   448 00000030 ????????            <1>     .mmap_addr          resd 1
   449 00000034 ????????            <1>     .drives_length      resd 1
   450 00000038 ????????            <1>     .drives_addr        resd 1
   451 0000003C ????????            <1>     .config_table       resd 1
   452 00000040 ????????            <1>     .boot_loader_name   resd 1
   453 00000044 ????????            <1>     .apm_table          resd 1
   454 00000048 ????????            <1>     .vbe_control_info   resd 1
   455 0000004C ????????            <1>     .vbe_mode_info      resd 1
   456 00000050 ????                <1>     .vbe_mode           resw 1
   457 00000052 ????                <1>     .vbe_interface_seg  resw 1
   458 00000054 ????                <1>     .vbe_interface_off  resw 1
   459 00000056 ????                <1>     .vbe_interface_len  resw 1
   460 00000058 ????????????????    <1>     .framebuffer_addr   resq 1      ; 64-bit
   461 00000060 ????????            <1>     .framebuffer_pitch  resd 1
   462 00000064 ????????            <1>     .framebuffer_width  resd 1
   463 00000068 ????????            <1>     .framebuffer_height resd 1
   464 0000006C ??                  <1>     .framebuffer_bpp    resb 1
   465 0000006D ??                  <1>     .framebuffer_type   resb 1
   466 0000006E ????                <1>     .framebuffer_color_info resw 1
   467                              <1> endstruc
   468                              <1> 
   469                              <1> ; =============================================================================
   470                              <1> ; Structure: multiboot1 module entry (for initrd)
   471                              <1> ; =============================================================================
   472                              <1> struc mb_module
   473 00000000 ????????            <1>     .mod_start          resd 1
   474 00000004 ????????            <1>     .mod_end            resd 1
   475 00000008 ????????            <1>     .string             resd 1
   476 0000000C ????????            <1>     .reserved           resd 1
   477                              <1> endstruc
   478                              <1> 
   479                              <1> ; Computed struct sizes (NASM struc does not auto-define a *_size symbol)
   480                              <1> %define foreboots_boot_info_size     152
   481                              <1> %define foreboots_mmap_entry_size    24
   482                              <1> %define mb_mmap_entry_size           24
   483                              <1> %define mb_info_size                 112
   484                              <1> %define mb_module_size               16
   485                              <1> 
   486                              <1> ; ELF constants (used by stage3)
   487                              <1> %define ELFCLASS32          1
   488                              <1> %define ELFCLASS64          2
   489                              <1> %define ELFDATA2LSB         1
   490                              <1> %define EM_386              3
   491                              <1> %define EM_X86_64           62
   492                              <1> %define PT_LOAD             1
   493                              <1> 

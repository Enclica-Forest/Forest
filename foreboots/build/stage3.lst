    37                                  [ORG STAGE3_LOAD_PHYS]
    38                                  
    39                                  ; =============================================================================
    40                                  ; Entry
    41                                  ; =============================================================================
    42                                  stage3_start:
    43 00000000 89F5                        mov  ebp, esi                    ; EBP = foreboots_boot_info*
    44 00000002 89FB                        mov  ebx, edi                    ; EBX = multiboot_info_t* (handoff in EBX)
    45                                  
    46                                      ; --- If stage2 already streamed the kernel to its PT_LOAD segments
    47                                      ;     (arbitrary-size loader), skip ELF parsing and jump straight to the
    48                                      ;     recorded entry point. ---
    49 00000004 F7450800020000              test dword [ebp + foreboots_boot_info.flags], FOREB_BIF_KERNEL_PRELOADED
    50 0000000B 7408                        jz   .parse_elf
    51 0000000D 8B455C                      mov  eax, [ebp + foreboots_boot_info.kernel_entry]
    52 00000010 E953010000                  jmp  .elf_loaded
    53                                  .parse_elf:
    54                                  
    55                                      ; --- Load kernel ELF base ---
    56 00000015 8B7554                      mov  esi, [ebp + foreboots_boot_info.kernel_load_addr]
    57                                  
    58                                      ; --- ELF magic check: 0x7F 'E' 'L' 'F' ---
    59 00000018 813E7F454C46                cmp  dword [esi + 0], 0x464C457F
    60 0000001E 0F8529010000                jne  .not_elf
    61 00000024 8A4604                      mov  al, [esi + 4]               ; EI_CLASS
    62 00000027 3C01                        cmp  al, ELFCLASS32
    63 00000029 740D                        je   .elf32
    64 0000002B 3C02                        cmp  al, ELFCLASS64
    65 0000002D 0F8491000000                je   .elf64
    66 00000033 E915010000                  jmp  .not_elf
    67                                  
    68                                  ; -----------------------------------------------------------------------------
    69                                  ; ELF32 program-header load
    70                                  ; -----------------------------------------------------------------------------
    71                                  .elf32:
    72 00000038 8935[D0010000]              mov  [s3_elfbase], esi
    73 0000003E 0FB74E2C                    movzx ecx, word [esi + Elf32_Ehdr.e_phnum]
    74 00000042 890D[D8010000]              mov  [s3_count], ecx
    75 00000048 0FB7462A                    movzx eax, word [esi + Elf32_Ehdr.e_phentsize]
    76 0000004C A3[DC010000]                mov  [s3_entsize], eax
    77 00000051 8B461C                      mov  eax, [esi + Elf32_Ehdr.e_phoff]
    78 00000054 01F0                        add  eax, esi
    79 00000056 A3[D4010000]                mov  [s3_phdr], eax
    80                                  .ph32_loop:
    81 0000005B 8B0D[D8010000]              mov  ecx, [s3_count]
    82 00000061 85C9                        test ecx, ecx
    83 00000063 744A                        jz   .ph32_done
    84 00000065 8B3D[D4010000]              mov  edi, [s3_phdr]
    85 0000006B 833F01                      cmp  dword [edi + Elf32_Phdr.p_type], PT_LOAD
    86 0000006E 7527                        jne  .ph32_next
    87                                      ; source = elfbase + p_offset
    88 00000070 8B35[D0010000]              mov  esi, [s3_elfbase]
    89 00000076 037704                      add  esi, [edi + Elf32_Phdr.p_offset]
    90                                      ; dest = p_paddr, count = p_filesz
    91 00000079 8B470C                      mov  eax, [edi + Elf32_Phdr.p_paddr]
    92 0000007C 8B4F10                      mov  ecx, [edi + Elf32_Phdr.p_filesz]
    93 0000007F 89FA                        mov  edx, edi                    ; save phdr pointer
    94 00000081 89C7                        mov  edi, eax                    ; dest
    95 00000083 F3A4                        rep  movsb                       ; copy file bytes
    96                                      ; zero-fill BSS (p_memsz - p_filesz)
    97 00000085 8B4A14                      mov  ecx, [edx + Elf32_Phdr.p_memsz]
    98 00000088 2B4A10                      sub  ecx, [edx + Elf32_Phdr.p_filesz]
    99 0000008B 760A                        jbe  .ph32_nobss
   100 0000008D 8B7A0C                      mov  edi, [edx + Elf32_Phdr.p_paddr]
   101 00000090 037A10                      add  edi, [edx + Elf32_Phdr.p_filesz]
   102 00000093 31C0                        xor  eax, eax
   103 00000095 F3AA                        rep  stosb
   104                                  .ph32_nobss:
   105                                  .ph32_next:
   106 00000097 A1[D4010000]                mov  eax, [s3_phdr]
   107 0000009C 0305[DC010000]              add  eax, [s3_entsize]
   108 000000A2 A3[D4010000]                mov  [s3_phdr], eax
   109 000000A7 FF0D[D8010000]              dec  dword [s3_count]
   110 000000AD EBAC                        jmp  .ph32_loop
   111                                  .ph32_done:
   112 000000AF 8B35[D0010000]              mov  esi, [s3_elfbase]
   113 000000B5 8B4618                      mov  eax, [esi + Elf32_Ehdr.e_entry]
   114 000000B8 C7456000000000              mov  dword [ebp + foreboots_boot_info.kernel_is64bit], 0
   115 000000BF E9A4000000                  jmp  .elf_loaded

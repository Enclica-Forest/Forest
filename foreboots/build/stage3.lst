   268                                  ; Size assertion
   269                                  ; =============================================================================
   270                                  stage3_end:
   271                                  
   272                                  %if (stage3_end - stage3_start) > (STAGE3_SECTOR_COUNT * 512)
   273                                      %error "stage3.asm exceeds maximum size!"

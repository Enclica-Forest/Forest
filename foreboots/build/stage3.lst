   184                                  
   185                                  %if FOREB_FORCE_LONG_MODE
   186                                      ; Optional long-mode trampoline. Only if the CPU supports long mode AND
   187                                      ; the kernel is 64-bit ELF. Otherwise fall through to 32-bit PM entry.
   188                                      cmp  dword [ebp + foreboots_boot_info.long_mode_available], 0
   189                                      je   .handoff32
   190                                      cmp  dword [ebp + foreboots_boot_info.kernel_is64bit], 0
   191                                      je   .handoff32
   192                                      jmp  enter_long_mode
   193                                  .handoff32:
   194                                  %endif
   195                                  
   196                                      ; --- Default 32-bit protected-mode handoff (GRUB-compatible) ---
   197                                      ; Mask every PIC IRQ before handoff, exactly as GRUB does. The kernel's
   198                                      ; early entry does `sti` with only a page-fault handler installed, so a
   199                                      ; live BIOS timer IRQ (IRQ0) would fault into an empty IDT and triple-fault
   200                                      ; before it can program the PIC/IDT itself.
   201 000001C0 B0FF                        mov  al, 0xFF
   202 000001C2 E6A1                        out  0xA1, al                    ; mask all slave  PIC (IRQ 8..15)
   203 000001C4 E621                        out  0x21, al                    ; mask all master PIC (IRQ 0..7)
   204                                      ; EAX = MULTIBOOT1_MAGIC, EBX = &multiboot_info_t, EIP = kernel entry
   205 000001C6 B802B0AD2B                  mov  eax, MULTIBOOT1_MAGIC
   206                                      ; EBX already holds multiboot_info_t*
   207 000001CB FF655C                      jmp  dword [ebp + foreboots_boot_info.kernel_entry]
   208                                  
   209                                  ; =============================================================================
   210                                  ; Optional long-mode trampoline (assembled only when FOREB_FORCE_LONG_MODE=1).
   211                                  ; Identity-maps the low 2 MiB (enough to reach the kernel at 0x100000), enables
   212                                  ; PAE + long mode, loads a 64-bit GDT, and jumps to the kernel entry in 64-bit
   213                                  ; mode. Page tables are built at 0x10000 (the kernel file buffer, now unused).
   214                                  ; =============================================================================
   215                                  %if FOREB_FORCE_LONG_MODE
   216                                  enter_long_mode:
   217                                      ; Build PML4 at 0x10000, PDPT at 0x11000, PD at 0x12000 (the kernel file
   218                                      ; buffer is no longer needed after ELF parsing).
   219                                      mov  dword [0x10000], 0x11000 | 0x03       ; PML4[0] -> PDPT (P|W)
   220                                      mov  dword [0x10004], 0
   221                                      mov  dword [0x11000], 0x12000 | 0x03       ; PDPT[0] -> PD (P|W)
   222                                      mov  dword [0x11004], 0
   223                                      mov  dword [0x12000], 0x00000083           ; PD[0] -> 2 MiB page @0 (P|W|PS)
   224                                      mov  dword [0x12004], 0
   225                                      mov  eax, 0x10000
   226                                      mov  cr3, eax                              ; load CR3
   227                                      mov  eax, cr4
   228                                      or   eax, 1 << 5                           ; CR4.PAE
   229                                      mov  cr4, eax
   230                                      mov  ecx, 0xC0000080                       ; EFER
   231                                      rdmsr
   232                                      or   eax, 1 << 8                           ; EFER.LME
   233                                      wrmsr
   234                                      mov  eax, cr0
   235                                      or   eax, 1 << 31                          ; CR0.PG -> activate long mode
   236                                      mov  cr0, eax
   237                                      ; Far-jump to the kernel entry via the 64-bit code segment. The CPU enters
   238                                      ; 64-bit mode at the entry point. EAX = magic, EBX = multiboot_info.
   239                                      lgdt [gdt64_desc]
   240                                      mov  eax, MULTIBOOT1_MAGIC                 ; EAX = 0x2BADB002
   241                                      ; EBX already holds multiboot_info_t*
   242                                      mov  edx, [ebp + foreboots_boot_info.kernel_entry]
   243                                      push dword gdt64_code
   244                                      push edx
   245                                      retf                                       ; -> gdt64_code:entry (64-bit)
   246                                  
   247                                  align 8
   248                                  GDT64_ENTRIES
   249                                  gdt64_desc:
   250                                      dw  gdt64_end - gdt64_start - 1
   251                                      dd  gdt64_start
   252                                  %endif

   118                                  ; ELF64 program-header load (uses low 32 bits; Forest OS kernel is below 4 GB)
   119                                  ; -----------------------------------------------------------------------------
   120                                  .elf64:
   121 000000C4 8935[D0010000]              mov  [s3_elfbase], esi
   122 000000CA 0FB74E38                    movzx ecx, word [esi + Elf64_Ehdr.e_phnum]
   123 000000CE 890D[D8010000]              mov  [s3_count], ecx
   124 000000D4 0FB74636                    movzx eax, word [esi + Elf64_Ehdr.e_phentsize]
   125 000000D8 A3[DC010000]                mov  [s3_entsize], eax
   126 000000DD 8B4620                      mov  eax, [esi + Elf64_Ehdr.e_phoff]
   127 000000E0 01F0                        add  eax, esi
   128 000000E2 A3[D4010000]                mov  [s3_phdr], eax
   129                                  .ph64_loop:
   130 000000E7 8B0D[D8010000]              mov  ecx, [s3_count]
   131 000000ED 85C9                        test ecx, ecx
   132 000000EF 744A                        jz   .ph64_done
   133 000000F1 8B3D[D4010000]              mov  edi, [s3_phdr]
   134 000000F7 833F01                      cmp  dword [edi + Elf64_Phdr.p_type], PT_LOAD
   135 000000FA 7527                        jne  .ph64_next
   136 000000FC 8B35[D0010000]              mov  esi, [s3_elfbase]
   137 00000102 037708                      add  esi, [edi + Elf64_Phdr.p_offset]
   138 00000105 8B4718                      mov  eax, [edi + Elf64_Phdr.p_paddr]
   139 00000108 8B4F20                      mov  ecx, [edi + Elf64_Phdr.p_filesz]
   140 0000010B 89FA                        mov  edx, edi
   141 0000010D 89C7                        mov  edi, eax
   142 0000010F F3A4                        rep  movsb
   143 00000111 8B4A28                      mov  ecx, [edx + Elf64_Phdr.p_memsz]
   144 00000114 2B4A20                      sub  ecx, [edx + Elf64_Phdr.p_filesz]
   145 00000117 760A                        jbe  .ph64_nobss
   146 00000119 8B7A18                      mov  edi, [edx + Elf64_Phdr.p_paddr]
   147 0000011C 037A20                      add  edi, [edx + Elf64_Phdr.p_filesz]
   148 0000011F 31C0                        xor  eax, eax
   149 00000121 F3AA                        rep  stosb
   150                                  .ph64_nobss:
   151                                  .ph64_next:
   152 00000123 A1[D4010000]                mov  eax, [s3_phdr]
   153 00000128 0305[DC010000]              add  eax, [s3_entsize]
   154 0000012E A3[D4010000]                mov  [s3_phdr], eax
   155 00000133 FF0D[D8010000]              dec  dword [s3_count]
   156 00000139 EBAC                        jmp  .ph64_loop
   157                                  .ph64_done:
   158 0000013B 8B35[D0010000]              mov  esi, [s3_elfbase]
   159 00000141 8B4618                      mov  eax, [esi + Elf64_Ehdr.e_entry]
   160 00000144 C7456001000000              mov  dword [ebp + foreboots_boot_info.kernel_is64bit], 1
   161 0000014B EB1B                        jmp  .elf_loaded
   162                                  
   163                                  ; -----------------------------------------------------------------------------
   164                                  ; Not an ELF: treat as a flat raw binary. Copy it to 0x100000 and enter there.
   165                                  ; -----------------------------------------------------------------------------
   166                                  .not_elf:
   167 0000014D 8B7554                      mov  esi, [ebp + foreboots_boot_info.kernel_load_addr]
   168 00000150 BF00001000                  mov  edi, 0x00100000
   169 00000155 8B4D58                      mov  ecx, [ebp + foreboots_boot_info.kernel_size]
   170 00000158 89CA                        mov  edx, ecx
   171 0000015A F3A4                        rep  movsb
   172 0000015C B800001000                  mov  eax, 0x00100000
   173 00000161 C7456000000000              mov  dword [ebp + foreboots_boot_info.kernel_is64bit], 0
   174                                  
   175                                  ; -----------------------------------------------------------------------------
   176                                  ; ELF loaded; EAX = kernel entry point. Hand off to the kernel.
   177                                  ; -----------------------------------------------------------------------------
   178                                  .elf_loaded:
   179 00000168 89455C                      mov  [ebp + foreboots_boot_info.kernel_entry], eax

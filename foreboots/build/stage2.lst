  1107 00000C89 C706[7215]3601              mov  word [fb_y], ENTRY_Y_START + 70
  1108 00000C8F C706[7415]9401              mov  word [fb_w], MENU_W - 76
  1109 00000C95 C706[7615]1200              mov  word [fb_h], 18
  1110 00000C9B C606[7815]12                mov  byte [fb_c], FOREB_BORDER
  1111 00000CA0 E8C7F9                      call rect_outline
  1112 00000CA3 C706[7015]C800              mov  word [fb_x], MENU_X + 40
  1113 00000CA9 C706[7215]3801              mov  word [fb_y], ENTRY_Y_START + 72
  1114 00000CAF C706[7415]9001              mov  word [fb_w], MENU_W - 80
  1115 00000CB5 C706[7615]0E00              mov  word [fb_h], 14
  1116 00000CBB C606[7815]13                mov  byte [fb_c], FOREB_SELECT
  1117 00000CC0 E847F9                      call fill_box
  1118 00000CC3 C3                          ret
  1119                                  %endif ; ===== end disabled VBE code =====

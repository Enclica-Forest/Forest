   246                                  %if 1  ; ===== VBE graphical code — disabled (text mode only) =====
   247                                  ; ============================================================================
   248                                  ; preference table at [BX] (DS=0x0800). Each entry: width, height, bpp (words);
   249                                  ; table terminated by a zero width. Fills screen_* (stage2 data) and the
   250                                  ; boot_info framebuffer fields (ES=0). Sets vesa_ok and FOREB_BIF_FRAMEBUFFER.
   251                                  ; On failure: sets text mode 03h and clears framebuffer info.

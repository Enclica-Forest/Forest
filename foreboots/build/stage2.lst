  1904                                  ; ============================================================================
  1905                                  ; Disk loading: LBA reads with CHS fallback, chunked to 63 sectors per call.
  1906                                  ;   EAX = starting LBA (relative to boot image), ECX = total sectors,
  1907                                  ;   ESI = physical destination.
  1908                                  ; The CD LBA base offset (stored at LBA_BASE_OFFSET by stage1) is added to
  1909                                  ; EAX once so the read hits the correct ISO sector on El Torito no-emulation
  1910                                  ; boot.  On hard disk the offset is 0 and this is a no-op.
  1911                                  ; Returns CF=0 on success, CF=1 on error. Preserves EBX/EDX, advances EAX/ECX/ESI.
  1912                                  ; ============================================================================
  1913                                  disk_load:
  1914 00000D8D 6653                        push ebx
  1915 00000D8F 6652                        push edx
  1916 00000D91 266603061005                add  eax, [es:LBA_BASE_OFFSET]   ; add CD base offset (0 for hard disk)
  1917 00000D97 6689CB                      mov  ebx, ecx                  ; EBX = remaining sectors
  1918                                  .dl_loop:
  1919 00000D9A 6685DB                      test ebx, ebx
  1920 00000D9D 0F842B01                    jz   .dl_done
  1921 00000DA1 6689D9                      mov  ecx, ebx
  1922 00000DA4 6683F93F                    cmp  ecx, 63
  1923 00000DA8 7606                        jbe  .dl_chunk_ok
  1924 00000DAA 66B93F000000                mov  ecx, 63
  1925                                  .dl_chunk_ok:
  1926 00000DB0 6653                        push ebx
  1927                                      lba_read_one (boot_info + foreboots_boot_info.boot_disk)

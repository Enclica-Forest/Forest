    41                                  %include "forebo.h"
     1                              <1> ; =============================================================================
     2                              <1> ; ForeB - Forest Bootloader
     3                              <1> ; forebo.h (NASM include) - Shared Macros and Definitions
     4                              <1> ; =============================================================================
     5                              <1> ; Include this file after config.h in stage2.asm
     6                              <1> 
     7                              <1> %ifndef FOREBO_H
     8                              <1> %define FOREBO_H
     9                              <1> 
    10                              <1> ; =============================================================================
    11                              <1> ; MACRO: print_str
    12                              <1> ; Print a null-terminated string in real mode via INT 10h AH=0Eh (teletype)
    13                              <1> ; Usage: print_str label_of_string
    14                              <1> ; Clobbers: AX, BX, SI
    15                              <1> ; =============================================================================
    16                              <1> %macro print_str 1
    17                              <1>     push si
    18                              <1>     mov  si, %1
    19                              <1>     call _print_str_impl
    20                              <1>     pop  si
    21                              <1> %endmacro
    22                              <1> 
    23                              <1> ; =============================================================================
    24                              <1> ; MACRO: print_char
    25                              <1> ; Print a single ASCII character in real mode
    26                              <1> ; Usage: print_char 'X'
    27                              <1> ; Clobbers: AX, BX
    28                              <1> ; =============================================================================
    29                              <1> %macro print_char 1
    30                              <1>     mov  al, %1
    31                              <1>     mov  ah, 0x0E
    32                              <1>     mov  bh, 0
    33                              <1>     mov  bl, 0x0F
    34                              <1>     int  0x10
    35                              <1> %endmacro
    36                              <1> 
    37                              <1> ; =============================================================================
    38                              <1> ; MACRO: plot_pixel
    39                              <1> ; Write a byte (color index) to the linear framebuffer in 8bpp mode.
    40                              <1> ; This macro is expanded inline; for real code call the subroutine.
    41                              <1> ; Usage: plot_pixel x_reg, y_reg, color_reg
    42                              <1> ;        where x_reg, y_reg are 16-bit registers holding coordinates,
    43                              <1> ;        color_reg is an 8-bit register holding the palette index.
    44                              <1> ; ES must point to the LFB segment (set once before calling).
    45                              <1> ; Clobbers: EDI
    46                              <1> ; =============================================================================
    47                              <1> %macro plot_pixel 3
    48                              <1>     ; edi = y * SCREEN_WIDTH + x
    49                              <1>     movzx edi, word %2          ; edi = y
    50                              <1>     imul  edi, SCREEN_WIDTH     ; edi = y * width
    51                              <1>     movzx eax, word %1          ; eax = x
    52                              <1>     add   edi, eax              ; edi = y*w + x
    53                              <1>     mov   byte [es:edi], %3    ; write color
    54                              <1> %endmacro
    55                              <1> 
    56                              <1> ; =============================================================================
    57                              <1> ; MACRO: fill_rect
    58                              <1> ; Fill a rectangular region with a color.
    59                              <1> ; Parameters: x, y, w, h, color  (all immediate or registers)
    60                              <1> ; This calls the fill_rect subroutine with parameters on stack.
    61                              <1> ; Clobbers: EAX, ECX, EDX, EDI
    62                              <1> ; =============================================================================
    63                              <1> %macro fill_rect 5
    64                              <1>     push word %5
    65                              <1>     push word %4
    66                              <1>     push word %3
    67                              <1>     push word %2
    68                              <1>     push word %1
    69                              <1>     call _fill_rect_impl
    70                              <1>     add  sp, 10
    71                              <1> %endmacro
    72                              <1> 
    73                              <1> ; =============================================================================
    74                              <1> ; MACRO: draw_hline
    75                              <1> ; Draw a horizontal line.
    76                              <1> ; Parameters: x, y, length, color
    77                              <1> ; =============================================================================
    78                              <1> %macro draw_hline 4
    79                              <1>     push word %4
    80                              <1>     push word %3
    81                              <1>     push word %2
    82                              <1>     push word %1
    83                              <1>     call _draw_hline_impl
    84                              <1>     add  sp, 8
    85                              <1> %endmacro
    86                              <1> 
    87                              <1> ; =============================================================================
    88                              <1> ; MACRO: draw_vline
    89                              <1> ; Draw a vertical line.
    90                              <1> ; Parameters: x, y, length, color
    91                              <1> ; =============================================================================
    92                              <1> %macro draw_vline 4
    93                              <1>     push word %4
    94                              <1>     push word %3
    95                              <1>     push word %2
    96                              <1>     push word %1
    97                              <1>     call _draw_vline_impl
    98                              <1>     add  sp, 8
    99                              <1> %endmacro
   100                              <1> 
   101                              <1> ; =============================================================================
   102                              <1> ; MACRO: draw_rect_outline
   103                              <1> ; Draw a hollow rectangle (border only).
   104                              <1> ; Parameters: x, y, w, h, color
   105                              <1> ; =============================================================================
   106                              <1> %macro draw_rect_outline 5
   107                              <1>     push word %5
   108                              <1>     push word %4
   109                              <1>     push word %3
   110                              <1>     push word %2
   111                              <1>     push word %1
   112                              <1>     call _draw_rect_outline_impl
   113                              <1>     add  sp, 10
   114                              <1> %endmacro
   115                              <1> 
   116                              <1> ; =============================================================================
   117                              <1> ; MACRO: draw_text
   118                              <1> ; Draw a string of text at pixel position using the built-in 8x8 font.
   119                              <1> ; Parameters: x, y, color, string_label
   120                              <1> ; =============================================================================
   121                              <1> %macro draw_text 4
   122                              <1>     push word %3
   123                              <1>     push word %2
   124                              <1>     push word %1
   125                              <1>     push word %4
   126                              <1>     call _draw_text_impl
   127                              <1>     add  sp, 8
   128                              <1> %endmacro
   129                              <1> 
   130                              <1> ; =============================================================================
   131                              <1> ; MACRO: delay_ticks
   132                              <1> ; Spin-wait for approximately N timer ticks (18.2 Hz BIOS timer).
   133                              <1> ; Parameters: tick_count (immediate)
   134                              <1> ; =============================================================================
   135                              <1> %macro delay_ticks 1
   136                              <1>     push ax
   137                              <1>     push cx
   138                              <1>     push dx
   139                              <1>     mov  cx, %1
   140                              <1>     call _delay_ticks_impl
   141                              <1>     pop  dx
   142                              <1>     pop  cx
   143                              <1>     pop  ax
   144                              <1> %endmacro
   145                              <1> 
   146                              <1> ; =============================================================================
   147                              <1> ; Structure: VBE Controller Info (returned by INT 10h AX=4F00h)
   148                              <1> ; Total: 512 bytes, placed at VBEINFO_OFF
   149                              <1> ; =============================================================================
   150                              <1> struc VBEControllerInfo
   151 00000000 ????????            <1>     .Signature      resb 4      ; "VESA"
   152 00000004 ????                <1>     .Version        resw 1      ; VBE version (e.g. 0x0300 = VBE 3.0)
   153 00000006 ????????            <1>     .OEMStringPtr   resd 1      ; Far pointer to OEM string
   154 0000000A ????????            <1>     .Capabilities   resd 1
   155 0000000E ????????            <1>     .VideoModePtr   resd 1      ; Far pointer to video mode list
   156 00000012 ????                <1>     .TotalMemory    resw 1      ; in 64 KiB blocks
   157 00000014 ????                <1>     .OEMSoftwareRev resw 1
   158 00000016 ????????            <1>     .OEMVendorNamePtr resd 1
   159 0000001A ????????            <1>     .OEMProductNamePtr resd 1
   160 0000001E ????????            <1>     .OEMProductRevPtr  resd 1
   161 00000022 <res DEh>           <1>     .Reserved       resb 222
   162 00000100 <res 100h>          <1>     .OEMData        resb 256
   163                              <1> endstruc
   164                              <1> 
   165                              <1> ; =============================================================================
   166                              <1> ; Structure: VBE Mode Info (returned by INT 10h AX=4F01h)
   167                              <1> ; Total: 256 bytes, placed at VBEMODEINFO_OFF
   168                              <1> ; =============================================================================
   169                              <1> struc VBEModeInfo
   170 00000000 ????                <1>     .ModeAttributes     resw 1      ; Mode attributes
   171 00000002 ??                  <1>     .WinAAttributes     resb 1
   172 00000003 ??                  <1>     .WinBAttributes     resb 1
   173 00000004 ????                <1>     .WinGranularity     resw 1      ; Window granularity (KiB)
   174 00000006 ????                <1>     .WinSize            resw 1      ; Window size (KiB)
   175 00000008 ????                <1>     .WinASegment        resw 1
   176 0000000A ????                <1>     .WinBSegment        resw 1
   177 0000000C ????????            <1>     .WinFuncPtr         resd 1
   178 00000010 ????                <1>     .BytesPerScanLine   resw 1
   179                              <1>     ; VBE 1.2+
   180 00000012 ????                <1>     .XResolution        resw 1
   181 00000014 ????                <1>     .YResolution        resw 1
   182 00000016 ??                  <1>     .XCharSize          resb 1
   183 00000017 ??                  <1>     .YCharSize          resb 1
   184 00000018 ??                  <1>     .NumberOfPlanes     resb 1
   185 00000019 ??                  <1>     .BitsPerPixel       resb 1
   186 0000001A ??                  <1>     .NumberOfBanks      resb 1
   187 0000001B ??                  <1>     .MemoryModel        resb 1
   188 0000001C ??                  <1>     .BankSize           resb 1
   189 0000001D ??                  <1>     .NumberOfImagePages resb 1
   190 0000001E ??                  <1>     .Reserved1          resb 1
   191                              <1>     ; Direct color info
   192 0000001F ??                  <1>     .RedMaskSize        resb 1
   193 00000020 ??                  <1>     .RedFieldPosition   resb 1
   194 00000021 ??                  <1>     .GreenMaskSize      resb 1
   195 00000022 ??                  <1>     .GreenFieldPosition resb 1
   196 00000023 ??                  <1>     .BlueMaskSize       resb 1
   197 00000024 ??                  <1>     .BlueFieldPosition  resb 1
   198 00000025 ??                  <1>     .RsvdMaskSize       resb 1
   199 00000026 ??                  <1>     .RsvdFieldPosition  resb 1
   200 00000027 ??                  <1>     .DirectColorModeInfo resb 1
   201                              <1>     ; VBE 2.0+
   202 00000028 ????????            <1>     .PhysBasePtr        resd 1      ; Physical address of linear framebuffer
   203 0000002C ????????            <1>     .Reserved2          resd 1
   204 00000030 ????                <1>     .Reserved3          resw 1
   205                              <1>     ; VBE 3.0+
   206 00000032 ????                <1>     .LinBytesPerScanLine resw 1
   207 00000034 ??                  <1>     .BnkNumberOfImagePages resb 1
   208 00000035 ??                  <1>     .LinNumberOfImagePages resb 1
   209 00000036 ??                  <1>     .LinRedMaskSize     resb 1
   210 00000037 ??                  <1>     .LinRedFieldPosition resb 1
   211 00000038 ??                  <1>     .LinGreenMaskSize   resb 1
   212 00000039 ??                  <1>     .LinGreenFieldPosition resb 1
   213 0000003A ??                  <1>     .LinBlueMaskSize    resb 1
   214 0000003B ??                  <1>     .LinBlueFieldPosition resb 1
   215 0000003C ??                  <1>     .LinRsvdMaskSize    resb 1
   216 0000003D ??                  <1>     .LinRsvdFieldPosition resb 1
   217 0000003E ????????            <1>     .MaxPixelClock      resd 1
   218 00000042 <res BEh>           <1>     .Reserved4          resb 190
   219                              <1> endstruc
   220                              <1> 
   221                              <1> ; =============================================================================
   222                              <1> ; Structure: Disk Address Packet (for INT 13h AH=42h extended read)
   223                              <1> ; =============================================================================
   224                              <1> struc DAP
   225 00000000 ??                  <1>     .Size       resb 1          ; Size of DAP (0x10)
   226 00000001 ??                  <1>     .Zero       resb 1          ; Must be 0
   227 00000002 ????                <1>     .Count      resw 1          ; Number of sectors to read
   228 00000004 ????                <1>     .Offset     resw 1          ; Destination offset
   229 00000006 ????                <1>     .Segment    resw 1          ; Destination segment
   230 00000008 ????????            <1>     .LBALow     resd 1          ; LBA low 32 bits
   231 0000000C ????????            <1>     .LBAHigh    resd 1          ; LBA high 32 bits (usually 0)
   232                              <1> endstruc
   233                              <1> 
   234                              <1> ; =============================================================================
   235                              <1> ; Structure: Multiboot 1 Info (passed to kernel in EBX)
   236                              <1> ; =============================================================================
   237                              <1> struc MBInfo
   238 00000000 ????????            <1>     .flags          resd 1      ; flags
   239 00000004 ????????            <1>     .mem_lower      resd 1      ; available memory below 1MB (KiB)
   240 00000008 ????????            <1>     .mem_upper      resd 1      ; available memory above 1MB (KiB)
   241 0000000C ????????            <1>     .boot_device    resd 1      ; BIOS boot device
   242 00000010 ????????            <1>     .cmdline        resd 1      ; pointer to kernel command line
   243 00000014 ????????            <1>     .mods_count     resd 1      ; number of boot modules
   244 00000018 ????????            <1>     .mods_addr      resd 1      ; physical address of module list
   245 0000001C <res 10h>           <1>     .syms           resb 16     ; symbol table or elf section header info
   246 0000002C ????????            <1>     .mmap_length    resd 1      ; memory map length
   247 00000030 ????????            <1>     .mmap_addr      resd 1      ; memory map address
   248 00000034 ????????            <1>     .drives_length  resd 1
   249 00000038 ????????            <1>     .drives_addr    resd 1
   250 0000003C ????????            <1>     .config_table   resd 1
   251 00000040 ????????            <1>     .boot_loader_name resd 1    ; pointer to bootloader name string
   252 00000044 ????????            <1>     .apm_table      resd 1
   253 00000048 ????????            <1>     .vbe_control_info resd 1
   254 0000004C ????????            <1>     .vbe_mode_info  resd 1
   255 00000050 ????                <1>     .vbe_mode       resw 1
   256 00000052 ????                <1>     .vbe_interface_seg resw 1
   257 00000054 ????                <1>     .vbe_interface_off resw 1
   258 00000056 ????                <1>     .vbe_interface_len resw 1
   259                              <1> endstruc
   260                              <1> 
   261                              <1> %endif ; FOREBO_H
    42                                  %include "forebo64.h"
     1                              <1> ; =============================================================================
     2                              <1> ; ForeB - Forest Bootloader
     3                              <1> ; forebo64.h (NASM include) - Extended macros & structures
     4                              <1> ; =============================================================================
     5                              <1> ; Include after config.h. Adds macros for:
     6                              <1> ;   - E820 memory map collection
     7                              <1> ;   - LBA disk read with CHS fallback
     8                              <1> ;   - CPUID / long-mode capability detection
     9                              <1> ;   - 64-bit GDT and long-mode trampoline helpers
    10                              <1> ;   - ELF header structures for stage3
    11                              <1> ;
    12                              <1> ; These extend the original macro library in forebo.h.
    13                              <1> 
    14                              <1> %ifndef FOREBO64_H
    15                              <1> %define FOREBO64_H
    16                              <1> 
    17                              <1> ; =============================================================================
    18                              <1> ; MACRO: serial_print  string_label
    19                              <1> ; Initialize COM1 (FOREB_COM1_BASE) to 8N1/115200 and print a NUL-terminated
    20                              <1> ; string via LSR (THRE) polling. Self-contained: re-runs the idempotent port
    21                              <1> ; init on each call so it works whether or not the port was set up earlier.
    22                              <1> ; Assembles correctly in both 16-bit real mode (stage2) and 32-bit protected
    23                              <1> ; mode (stage3) - the string pointer register width follows __BITS__, and the
    24                              <1> ; in/out port I/O is identical in either mode. The string must be reachable
    25                              <1> ; through DS (stage2: DS=stage2 segment; stage3: flat DS base 0).
    26                              <1> ; Preserves ALL general-purpose registers and flags.
    27                              <1> ; =============================================================================
    28                              <1> %macro serial_print 1
    29                              <1>     pushf
    30                              <1>     pusha
    31                              <1>     ; --- COM1 8N1, divisor 1 (115200 baud) ---
    32                              <1>     mov  dx, FOREB_COM1_BASE + 1        ; IER: disable interrupts
    33                              <1>     xor  al, al
    34                              <1>     out  dx, al
    35                              <1>     mov  dx, FOREB_COM1_BASE + 3        ; LCR: enable DLAB
    36                              <1>     mov  al, 0x80
    37                              <1>     out  dx, al
    38                              <1>     mov  dx, FOREB_COM1_BASE + 0        ; DLL = 1
    39                              <1>     mov  al, 0x01
    40                              <1>     out  dx, al
    41                              <1>     mov  dx, FOREB_COM1_BASE + 1        ; DLM = 0
    42                              <1>     xor  al, al
    43                              <1>     out  dx, al
    44                              <1>     mov  dx, FOREB_COM1_BASE + 3        ; LCR: 8N1, DLAB off
    45                              <1>     mov  al, 0x03
    46                              <1>     out  dx, al
    47                              <1>     mov  dx, FOREB_COM1_BASE + 2        ; FCR: enable+clear FIFO, 14-byte
    48                              <1>     mov  al, 0xC7
    49                              <1>     out  dx, al
    50                              <1>     mov  dx, FOREB_COM1_BASE + 4        ; MCR: DTR|RTS|OUT2
    51                              <1>     mov  al, 0x0B
    52                              <1>     out  dx, al
    53                              <1>     ; --- print loop ---
    54                              <1> %if __BITS__ == 16
    55                              <1>     mov  si, %1
    56                              <1> %else
    57                              <1>     mov  esi, %1
    58                              <1> %endif
    59                              <1> %%sp_next:
    60                              <1> %if __BITS__ == 16
    61                              <1>     mov  al, [si]
    62                              <1>     inc  si
    63                              <1> %else
    64                              <1>     mov  al, [esi]
    65                              <1>     inc  esi
    66                              <1> %endif
    67                              <1>     test al, al
    68                              <1>     jz   %%sp_done
    69                              <1>     mov  bl, al                         ; hold char while polling LSR
    70                              <1> %%sp_wait:
    71                              <1>     mov  dx, FOREB_COM1_BASE + 5        ; LSR
    72                              <1>     in   al, dx
    73                              <1>     test al, 0x20                       ; THRE (transmit holding empty)
    74                              <1>     jz   %%sp_wait
    75                              <1>     mov  al, bl
    76                              <1>     mov  dx, FOREB_COM1_BASE + 0        ; THR
    77                              <1>     out  dx, al
    78                              <1>     jmp  %%sp_next
    79                              <1> %%sp_done:
    80                              <1>     popa
    81                              <1>     popf
    82                              <1> %endmacro
    83                              <1> 
    84                              <1> ; =============================================================================
    85                              <1> ; MACRO: e820_collect
    86                              <1> ; Collect INT 15h E820 memory map into foreboots_mmap_entry array at
    87                              <1> ; FOREB_MMAP_ADDRESS. Stores up to FOREB_MMAP_MAX entries.
    88                              <1> ; On return:
    89                              <1> ;   [boot_info + foreboots_boot_info.mmap_count] = number of entries
    90                              <1> ;   [boot_info + foreboots_boot_info.mmap_addr]   = FOREB_MMAP_ADDRESS
    91                              <1> ; Clobbers: EAX, EBX, ECX, EDX, ESI, EDI, ES, flags
    92                              <1> ; Assumes DS=0 for the destination buffer (physical addresses).
    93                              <1> ; =============================================================================
    94                              <1> %macro e820_collect 0
    95                              <1>     push    ds
    96                              <1>     push    es
    97                              <1>     pushad                          ; preserve all regs; EBP = entry counter
    98                              <1>     xor     ax, ax
    99                              <1>     mov     ds, ax
   100                              <1>     mov     es, ax
   101                              <1>     mov     edi, FOREB_MMAP_ADDRESS ; ES:DI -> current foreboots_mmap_entry slot
   102                              <1>     xor     ebx, ebx                ; continuation value (0 = start)
   103                              <1>     xor     ebp, ebp                ; EBP = entry count (saved across int 0x15)
   104                              <1> %%e820_loop:
   105                              <1>     cmp     ebp, FOREB_MMAP_MAX
   106                              <1>     jae     %%e820_done             ; table full
   107                              <1>     mov     eax, 0x0000E820
   108                              <1>     mov     ecx, 24
   109                              <1>     mov     dword [es:edi + 20], 1  ; default ACPI attr = valid, in the DEST slot
   110                              <1>     mov     edx, 0x534D4150         ; 'SMAP'
   111                              <1>     ; INT 15h/E820 writes the entry straight to ES:DI (= this array slot). The
   112                              <1>     ; previous version pointed the BIOS at the array but then overwrote the slot
   113                              <1>     ; with an uninitialised scratch buffer, yielding a 0-byte memory map.
   114                              <1>     int     0x15
   115                              <1>     jc      %%e820_done             ; carry = end / error
   116                              <1>     cmp     eax, 0x534D4150         ; BIOS must return 'SMAP'
   117                              <1>     jne     %%e820_done
   118                              <1>     cmp     ecx, 20
   119                              <1>     jb      %%e820_next             ; entry too small; don't count it
   120                              <1>     inc     ebp
   121                              <1>     add     edi, foreboots_mmap_entry_size   ; advance to the next slot
   122                              <1> %%e820_next:
   123                              <1>     test    ebx, ebx
   124                              <1>     jz      %%e820_done
   125                              <1>     jmp     %%e820_loop
   126                              <1> 
   127                              <1> %%e820_done:
   128                              <1>     mov     [boot_info + foreboots_boot_info.mmap_count], ebp
   129                              <1>     mov     dword [boot_info + foreboots_boot_info.mmap_addr], FOREB_MMAP_ADDRESS
   130                              <1>     popad
   131                              <1>     pop     es
   132                              <1>     pop     ds
   133                              <1> %endmacro
   134                              <1> 
   135                              <1> ; =============================================================================
   136                              <1> ; MACRO: lba_read_one  drive_src
   137                              <1> ; Read ECX sectors (clamped to 63) from LBA EAX to physical address ESI using
   138                              <1> ; INT 13h AH=42h. Falls back to CHS (AH=02h, 1 sector at a time) if LBA
   139                              <1> ; extensions are unsupported by the BIOS.
   140                              <1> ;   EAX       = starting LBA
   141                              <1> ;   ECX       = sector count (clamped to 63 internally)
   142                              <1> ;   ESI       = physical destination address (seg:off derived as phys/16 : &0xF)
   143                              <1> ;   [drive_src] = memory location (DS=0 accessible) holding the BIOS drive byte
   144                              <1> ; On success CF=0; on failure CF=1. Preserves ALL caller registers.
   145                              <1> ; For reads larger than 63 sectors, call this in a loop (see stage2 disk_load).
   146                              <1> ; =============================================================================
   147                              <1> %macro lba_read_one 1
   148                              <1>     push    eax
   149                              <1>     push    ecx
   150                              <1>     push    edx
   151                              <1>     push    esi
   152                              <1>     push    edi
   153                              <1>     push    ebx
   154                              <1>     push    ebp
   155                              <1>     push    es
   156                              <1>     push    ds
   157                              <1>     xor     ax, ax
   158                              <1>     mov     ds, ax                      ; DS=0 for DAP / drive_src
   159                              <1>     ; Save LBA + count into the DAP first (before any INT 13h clobbers EAX)
   160                              <1>     mov     [DAP_BUF + 8], eax          ; LBA low
   161                              <1>     mov     dword [DAP_BUF + 12], 0     ; LBA high
   162                              <1>     mov     ebp, ecx                    ; EBP = sector count (preserve)
   163                              <1>     cmp     ebp, 63
   164                              <1>     jbe     %%lro_cnt_ok
   165                              <1>     mov     ebp, 63
   166                              <1> %%lro_cnt_ok:
   167                              <1>     ; Destination seg:off from ESI
   168                              <1>     mov     edx, esi
   169                              <1>     shr     edx, 4                      ; seg
   170                              <1>     mov     edi, esi
   171                              <1>     and     edi, 0x000F                 ; off
   172                              <1>     mov     word [DAP_BUF + 0], 0x0010
   173                              <1>     mov     [DAP_BUF + 4], di
   174                              <1>     mov     [DAP_BUF + 6], dx
   175                              <1>     ; Check LBA extensions support
   176                              <1>     mov     ah, 0x41
   177                              <1>     mov     bx, 0x55AA
   178                              <1>     mov     dl, [%1]
   179                              <1>     int     0x13
   180                              <1>     jc      %%lro_chs
   181                              <1>     cmp     bx, 0xAA55
   182                              <1>     jne     %%lro_chs
   183                              <1>     test    cl, 0x01
   184                              <1>     jz      %%lro_chs
   185                              <1>     ; --- LBA path: one INT 13h AH=42h call for all EBP sectors ---
   186                              <1>     mov     [DAP_BUF + 2], bp           ; count (word)
   187                              <1>     mov     si, DAP_BUF
   188                              <1>     mov     dl, [%1]
   189                              <1>     mov     ah, 0x42
   190                              <1>     int     0x13
   191                              <1>     jc      %%lro_fail
   192                              <1>     clc
   193                              <1>     jmp     %%lro_ret
   194                              <1>     ; --- CHS fallback: read EBP sectors, one per iteration ---
   195                              <1> %%lro_chs:
   196                              <1>     mov     [DAP_BUF + 2], bp           ; not used by CHS, keep for record
   197                              <1> %%lro_chs_loop:
   198                              <1>     test    ebp, ebp
   199                              <1>     jz      %%lro_ok
   200                              <1>     mov     eax, [DAP_BUF + 8]          ; current LBA
   201                              <1>     xor     edx, edx
   202                              <1>     mov     ecx, 63
   203                              <1>     div     ecx                         ; eax = LBA/63, edx = sector-1
   204                              <1>     inc     edx                         ; edx = sector
   205                              <1>     push    edx                         ; save sector
   206                              <1>     xor     edx, edx
   207                              <1>     mov     ecx, 16
   208                              <1>     div     ecx                         ; eax = cylinder, edx = head
   209                              <1>     push    edx                         ; save head
   210                              <1>     mov     ch, al                      ; CH = cyl low
   211                              <1>     mov     edx, eax
   212                              <1>     shr     edx, 8
   213                              <1>     and     edx, 0xC0                   ; high cyl bits
   214                              <1>     pop     eax                         ; head
   215                              <1>     mov     dh, al                      ; DH = head
   216                              <1>     pop     eax                         ; sector
   217                              <1>     mov     cl, al                      ; CL = sector (low 6 bits)
   218                              <1>     or      cl, dl                      ; CL |= high cyl bits
   219                              <1>     ; Buffer ES:BX from ESI
   220                              <1>     mov     eax, esi
   221                              <1>     shr     eax, 4                      ; seg
   222                              <1>     mov     edx, esi
   223                              <1>     and     edx, 0x0F                   ; off
   224                              <1>     push    es
   225                              <1>     mov     es, ax
   226                              <1>     mov     bx, dx                      ; BX = buffer offset
   227                              <1>     mov     dl, [%1]                    ; DL = drive (DH preserved)
   228                              <1>     mov     eax, 0x0201                 ; AH=02, AL=1 sector
   229                              <1>     int     0x13
   230                              <1>     pop     es
   231                              <1>     jc      %%lro_fail
   232                              <1>     inc     dword [DAP_BUF + 8]         ; LBA++
   233                              <1>     add     esi, 512                    ; dest += 512
   234                              <1>     dec     ebp
   235                              <1>     jmp     %%lro_chs_loop
   236                              <1> %%lro_ok:
   237                              <1>     clc
   238                              <1>     jmp     %%lro_ret
   239                              <1> %%lro_fail:
   240                              <1>     stc
   241                              <1> %%lro_ret:
   242                              <1>     pop     ds
   243                              <1>     pop     es
   244                              <1>     pop     ebp
   245                              <1>     pop     ebx
   246                              <1>     pop     edi
   247                              <1>     pop     esi
   248                              <1>     pop     edx
   249                              <1>     pop     ecx
   250                              <1>     pop     eax
   251                              <1> %endmacro
   252                              <1> 
   253                              <1> ; =============================================================================
   254                              <1> ; MACRO: detect_long_mode
   255                              <1> ; Detect CPUID and long-mode availability. Sets the cpuid_available,
   256                              <1> ; long_mode_available, pae_available fields in boot_info and the corresponding
   257                              <1> ; FOREB_BIF_* bits in flags. Falls back gracefully on 386/486.
   258                              <1> ; Clobbers: EAX, EBX, ECX, EDX, flags
   259                              <1> ; =============================================================================
   260                              <1> %macro detect_long_mode 0
   261                              <1>     push    ds
   262                              <1>     pushad
   263                              <1>     xor     ax, ax
   264                              <1>     mov     ds, ax                      ; DS=0 to access boot_info (physical 0x1000)
   265                              <1>     ; CPUID availability: flip ID bit (EFLAGS bit 21)
   266                              <1>     pushfd
   267                              <1>     pop     eax
   268                              <1>     mov     ecx, eax
   269                              <1>     xor     eax, 1 << 21
   270                              <1>     push    eax
   271                              <1>     popfd
   272                              <1>     pushfd
   273                              <1>     pop     eax
   274                              <1>     push    ecx
   275                              <1>     popfd
   276                              <1>     cmp     eax, ecx
   277                              <1>     je      %%no_cpuid
   278                              <1>     ; CPUID present
   279                              <1>     mov     dword [boot_info + foreboots_boot_info.cpuid_available], 1
   280                              <1>     or      dword [boot_info + foreboots_boot_info.flags], FOREB_BIF_CPUID
   281                              <1> 
   282                              <1>     ; PAE: CPUID(1) -> EDX bit 6
   283                              <1>     mov     eax, 1
   284                              <1>     cpuid
   285                              <1>     test    edx, 1 << 6
   286                              <1>     jz      %%no_pae
   287                              <1>     mov     dword [boot_info + foreboots_boot_info.pae_available], 1
   288                              <1>     or      dword [boot_info + foreboots_boot_info.flags], FOREB_BIF_PAE
   289                              <1> %%no_pae:
   290                              <1>     ; Extended CPUID for long mode: need 0x80000001
   291                              <1>     mov     eax, 0x80000000
   292                              <1>     cpuid
   293                              <1>     cmp     eax, 0x80000001
   294                              <1>     jb      %%done
   295                              <1>     mov     eax, 0x80000001
   296                              <1>     cpuid
   297                              <1>     test    edx, 1 << 29                 ; LM bit
   298                              <1>     jz      %%done
   299                              <1>     mov     dword [boot_info + foreboots_boot_info.long_mode_available], 1
   300                              <1>     or      dword [boot_info + foreboots_boot_info.flags], FOREB_BIF_LONG_MODE
   301                              <1>     jmp     %%done
   302                              <1> %%no_cpuid:
   303                              <1>     mov     dword [boot_info + foreboots_boot_info.cpuid_available], 0
   304                              <1>     mov     dword [boot_info + foreboots_boot_info.long_mode_available], 0
   305                              <1>     mov     dword [boot_info + foreboots_boot_info.pae_available], 0
   306                              <1> %%done:
   307                              <1>     popad
   308                              <1>     pop     ds
   309                              <1> %endmacro
   310                              <1> 
   311                              <1> ; =============================================================================
   312                              <1> ; Structure: ELF32 header (stage3 uses this to load the kernel)
   313                              <1> ; =============================================================================
   314                              <1> struc Elf32_Ehdr
   315 00000000 <res 10h>           <1>     .e_ident            resb 16
   316 00000010 ????                <1>     .e_type             resw 1
   317 00000012 ????                <1>     .e_machine          resw 1
   318 00000014 ????????            <1>     .e_version          resd 1
   319 00000018 ????????            <1>     .e_entry            resd 1
   320 0000001C ????????            <1>     .e_phoff            resd 1
   321 00000020 ????????            <1>     .e_shoff            resd 1
   322 00000024 ????????            <1>     .e_flags            resd 1
   323 00000028 ????                <1>     .e_ehsize           resw 1
   324 0000002A ????                <1>     .e_phentsize        resw 1
   325 0000002C ????                <1>     .e_phnum            resw 1
   326 0000002E ????                <1>     .e_shentsize        resw 1
   327 00000030 ????                <1>     .e_shnum            resw 1
   328 00000032 ????                <1>     .e_shstrndx         resw 1
   329                              <1> endstruc
   330                              <1> 
   331                              <1> struc Elf32_Phdr
   332 00000000 ????????            <1>     .p_type             resd 1
   333 00000004 ????????            <1>     .p_offset           resd 1
   334 00000008 ????????            <1>     .p_vaddr            resd 1
   335 0000000C ????????            <1>     .p_paddr            resd 1
   336 00000010 ????????            <1>     .p_filesz           resd 1
   337 00000014 ????????            <1>     .p_memsz            resd 1
   338 00000018 ????????            <1>     .p_flags            resd 1
   339 0000001C ????????            <1>     .p_align            resd 1
   340                              <1> endstruc
   341                              <1> 
   342                              <1> ; =============================================================================
   343                              <1> ; Structure: ELF64 header (stage3 uses this to load the 64-bit kernel)
   344                              <1> ; =============================================================================
   345                              <1> struc Elf64_Ehdr
   346 00000000 <res 10h>           <1>     .e_ident            resb 16
   347 00000010 ????                <1>     .e_type             resw 1
   348 00000012 ????                <1>     .e_machine          resw 1
   349 00000014 ????????            <1>     .e_version          resd 1
   350 00000018 ????????????????    <1>     .e_entry            resq 1
   351 00000020 ????????????????    <1>     .e_phoff            resq 1
   352 00000028 ????????????????    <1>     .e_shoff            resq 1
   353 00000030 ????????            <1>     .e_flags            resd 1
   354 00000034 ????                <1>     .e_ehsize           resw 1
   355 00000036 ????                <1>     .e_phentsize        resw 1
   356 00000038 ????                <1>     .e_phnum            resw 1
   357 0000003A ????                <1>     .e_shentsize        resw 1
   358 0000003C ????                <1>     .e_shnum            resw 1
   359 0000003E ????                <1>     .e_shstrndx         resw 1
   360                              <1> endstruc
   361                              <1> 
   362                              <1> struc Elf64_Phdr
   363 00000000 ????????            <1>     .p_type             resd 1
   364 00000004 ????????            <1>     .p_flags            resd 1
   365 00000008 ????????????????    <1>     .p_offset           resq 1
   366 00000010 ????????????????    <1>     .p_vaddr            resq 1
   367 00000018 ????????????????    <1>     .p_paddr            resq 1
   368 00000020 ????????????????    <1>     .p_filesz           resq 1
   369 00000028 ????????????????    <1>     .p_memsz            resq 1
   370 00000030 ????????????????    <1>     .p_align            resq 1
   371                              <1> endstruc
   372                              <1> 
   373                              <1> ; =============================================================================
   374                              <1> ; 64-bit GDT for the optional long-mode trampoline in stage3.
   375                              <1> ; Code: 0x00AF9A000000FFFF (L+DB+P+R/W/exec, 64-bit)
   376                              <1> ; Data: 0x00CF92000000FFFF (G+DB+P+R/W, flat 4GB)
   377                              <1> ; =============================================================================
   378                              <1> %macro GDT64_ENTRIES 0
   379                              <1> gdt64_start:
   380                              <1>     dq  0x0000000000000000              ; null
   381                              <1> gdt64_code: equ $ - gdt64_start
   382                              <1>     dq  0x00AF9A000000FFFF              ; 64-bit code
   383                              <1> gdt64_data: equ $ - gdt64_start
   384                              <1>     dq  0x00CF92000000FFFF              ; 64-bit data (compatibility)
   385                              <1> gdt64_end:
   386                              <1> %endmacro
   387                              <1> 
   388                              <1> %endif ; FOREBO64_H
    43                                  
    44                                  ; Fixed physical addresses accessed with ES=0 / DS=0
    45                                  boot_info       equ BOOT_INFO_ADDRESS
    46                                  foreb_mmap      equ FOREB_MMAP_ADDRESS
    47                                  mb_mmap         equ MB_MMAP_ADDRESS
    48                                  mb_info_addr    equ MULTIBOOT_INFO_ADDR
    49                                  
    50                                  ; =============================================================================
    51                                  ; Stage 2 header: short jump + magic + version
    52                                  ; =============================================================================
    53                                  stage2_start:
    54 00000000 EB0D                        jmp  short stage2_main
    55 00000002 B1FE                        dw   0xFEB1                       ; checked by stage1 (word at offset 2)
    56 00000004 466F7265422076322E-         db  "ForeB v2.0", 0
    56 0000000D 3000               
    57                                  
    58                                  ; =============================================================================
    59                                  ; MAIN ENTRY POINT
    60                                  ; =============================================================================
    61                                  stage2_main:
    62 0000000F 0E                          push cs
    63 00000010 1F                          pop  ds                          ; DS = 0x0800 (stage2 data)
    64 00000011 31C0                        xor  ax, ax
    65 00000013 8EC0                        mov  es, ax                      ; ES = 0x0000 (low memory)
    66 00000015 B80070                      mov  ax, 0x7000
    67 00000018 8ED0                        mov  ss, ax
    68 0000001A BCFEFF                      mov  sp, 0xFFFE
    69 0000001D FB                          sti
    70                                  
    71                                  %if FOREB_SERIAL_DEBUG
    72                                      serial_print str_serial_stage2   ; proof-of-progress on -serial stdio
    29 0000001E 9C                  <1>  pushf
    30 0000001F 60                  <1>  pusha
    31                              <1> 
    32 00000020 BAF903              <1>  mov dx, FOREB_COM1_BASE + 1
    33 00000023 30C0                <1>  xor al, al
    34 00000025 EE                  <1>  out dx, al
    35 00000026 BAFB03              <1>  mov dx, FOREB_COM1_BASE + 3
    36 00000029 B080                <1>  mov al, 0x80
    37 0000002B EE                  <1>  out dx, al
    38 0000002C BAF803              <1>  mov dx, FOREB_COM1_BASE + 0
    39 0000002F B001                <1>  mov al, 0x01
    40 00000031 EE                  <1>  out dx, al
    41 00000032 BAF903              <1>  mov dx, FOREB_COM1_BASE + 1
    42 00000035 30C0                <1>  xor al, al
    43 00000037 EE                  <1>  out dx, al
    44 00000038 BAFB03              <1>  mov dx, FOREB_COM1_BASE + 3
    45 0000003B B003                <1>  mov al, 0x03
    46 0000003D EE                  <1>  out dx, al
    47 0000003E BAFA03              <1>  mov dx, FOREB_COM1_BASE + 2
    48 00000041 B0C7                <1>  mov al, 0xC7
    49 00000043 EE                  <1>  out dx, al
    50 00000044 BAFC03              <1>  mov dx, FOREB_COM1_BASE + 4

  1879                                  ; bios_print: null-terminated string SI via INT 10h teletype (DS=0x0800)
  1880                                  ; ============================================================================
  1881                                  bios_print:
  1882 00000D73 50                          push ax
  1883 00000D74 53                          push bx
  1884 00000D75 1E                          push ds
  1885 00000D76 0E                          push cs
  1886 00000D77 1F                          pop  ds

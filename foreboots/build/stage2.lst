   968                                  ; ============================================================================
   969                                  ; vesa_menu: graphical forest boot menu. Returns AX = selected entry.
   970                                  ; Sets an 8bpp VBE mode, programs the forest DAC palette, draws the menu from
   971                                  ; 16-bit protected-mode excursions and reads keys/timer in real mode. For a boot
   972                                  ; entry it then paints the in-place graphical load indicator and LEAVES the
   973                                  ; framebuffer up so it stays visible while the kernel streams in; vesa_teardown
   974                                  ; (called after load_kernel, before the handoff) restores text mode 03h and
   975                                  ; clears the framebuffer info so the multiboot handoff is byte-identical to the
   976                                  ; proven text-mode path. Falls back to the text menu when no VBE mode is found.
   977                                  ; ============================================================================
   978                                  vesa_menu:
   979 00000B3C BB[9215]                    mov  bx, fb_prefs_menu
   980 00000B3F E891F7                      call setup_vesa                  ; real mode; sets vesa_ok + mode + lfb + geom
   981 00000B42 803E[2F15]00                cmp  byte [vesa_ok], 0
   982 00000B47 7420                        je   .vm_text
   983 00000B49 E8C0F9                      call program_palette             ; real mode INT 10h: forest DAC (8bpp)
   984 00000B4C C706[8115][280C]            mov  word [pm_fn], pm_all         ; paint full chrome once
   985 00000B52 E87300                      call run_in_pm
   986 00000B55 E8FEFE                      call boot_menu_loop              ; AX = selected entry (real-mode input)
   987 00000B58 83F803                      cmp  ax, ENTRY_REBOOT            ; reboot entry loads nothing
   988 00000B5B 730B                        jae  .vm_ret
   989 00000B5D 50                          push ax
   990 00000B5E C706[8115][4C0C]            mov  word [pm_fn], pm_loading    ; in-place graphical load indicator
   991 00000B64 E86100                      call run_in_pm
   992 00000B67 58                          pop  ax
   993                                  .vm_ret:
   994 00000B68 C3                          ret
   995                                  .vm_text:
   996 00000B69 E85801                      call text_mode_menu
   997 00000B6C C3                          ret
   998                                  
   999                                  ; ============================================================================
  1000                                  ; vesa_teardown: restore text mode 03h and clear framebuffer info (no-op if the
  1001                                  ; graphical menu was never entered). Called after the kernel is loaded so the
  1002                                  ; loading screen stays visible during the disk read, and so the multiboot
  1003                                  ; handoff matches the proven text-mode path exactly.
  1004                                  ; ============================================================================
  1005                                  vesa_teardown:
  1006 00000B6D 803E[2F15]00                cmp  byte [vesa_ok], 0
  1007 00000B72 7453                        je   .vt_done
  1008 00000B74 B80300                      mov  ax, 0x0003
  1009 00000B77 CD10                        int  0x10
  1010 00000B79 06                          push es
  1011 00000B7A 31C9                        xor  cx, cx
  1012 00000B7C 8EC1                        mov  es, cx
  1013 00000B7E 266683260810FD              and  dword [es:boot_info + foreboots_boot_info.flags], 0xFFFFFFFD
  1014 00000B85 2666C7062810000000-         mov  dword [es:boot_info + foreboots_boot_info.framebuffer_addr], 0
  1014 00000B8E 00                 
  1015 00000B8F 2666C7062C10000000-         mov  dword [es:boot_info + foreboots_boot_info.framebuffer_addr + 4], 0
  1015 00000B98 00                 
  1016 00000B99 2666C7063410000000-         mov  dword [es:boot_info + foreboots_boot_info.framebuffer_width], 0
  1016 00000BA2 00                 
  1017 00000BA3 2666C7063810000000-         mov  dword [es:boot_info + foreboots_boot_info.framebuffer_height], 0
  1017 00000BAC 00                 
  1018 00000BAD 2666C7063C10000000-         mov  dword [es:boot_info + foreboots_boot_info.framebuffer_bpp], 0
  1018 00000BB6 00                 
  1019 00000BB7 2666C7064010020000-         mov  dword [es:boot_info + foreboots_boot_info.framebuffer_type], 2
  1019 00000BC0 00                 
  1020 00000BC1 07                          pop  es
  1021 00000BC2 C606[2F15]00                mov  byte [vesa_ok], 0
  1022                                  .vt_done:
  1023 00000BC7 C3                          ret
  1024                                  
  1025                                  ; ============================================================================
  1026                                  ; run_in_pm: run the 16-bit draw routine at [pm_fn] from PROTECTED mode.
  1027                                  ; LFB stores (fs:[phys]) are invisible in real/unreal mode on QEMU but work in
  1028                                  ; protected mode, so each repaint briefly enters 16-bit PM with:
  1029                                  ;   CS  = 0x18 (16-bit code, base 0x8000)   -> ORG-relative code runs correctly
  1030                                  ;   DS/ES = 0x20 (data, base 0x8000)        -> variable/string access unchanged
  1031                                  ;   FS  = 0x10 (flat, base 0)               -> LFB at its physical address
  1032                                  ;   SS  = 0x28 (data, base 0x70000)         -> same physical stack as real mode
  1033                                  ; SP is never changed, so real-mode CALL/RET framing is preserved.
  1034                                  ; ============================================================================
  1035                                  run_in_pm:
  1036 00000BC8 9C                          pushf
  1037 00000BC9 FA                          cli
  1038 00000BCA 0F010E[8315]                sidt [rp_idt]                    ; save real-mode IVT pointer
  1039 00000BCF 0F0116[2815]                lgdt [gdt_pm_desc]
  1040 00000BD4 0F20C0                      mov  eax, cr0
  1041 00000BD7 6683C801                    or   eax, 1
  1042 00000BDB 0F22C0                      mov  cr0, eax
  1043 00000BDE EA[E30B]1800                jmp  0x0018:.pm                  ; load 16-bit PM code selector (base 0x8000)
  1044                                  .pm:
  1045 00000BE3 B82000                      mov  ax, 0x0020
  1046 00000BE6 8ED8                        mov  ds, ax
  1047 00000BE8 8EC0                        mov  es, ax
  1048 00000BEA B81000                      mov  ax, 0x0010
  1049 00000BED 8EE0                        mov  fs, ax
  1050 00000BEF B82800                      mov  ax, 0x0028
  1051 00000BF2 8ED0                        mov  ss, ax
  1052 00000BF4 FF16[8115]                  call [pm_fn]                     ; draw (writes LFB via fs:[phys])
  1053 00000BF8 FA                          cli
  1054 00000BF9 B82800                      mov  ax, 0x0028                  ; 64K-limit data selectors for real return
  1055 00000BFC 8ED8                        mov  ds, ax
  1056 00000BFE 8EC0                        mov  es, ax
  1057 00000C00 8EE0                        mov  fs, ax
  1058 00000C02 8EE8                        mov  gs, ax
  1059 00000C04 0F20C0                      mov  eax, cr0
  1060 00000C07 6683E0FE                    and  eax, 0xFFFFFFFE
  1061 00000C0B 0F22C0                      mov  cr0, eax
  1062 00000C0E EA[130C]0008                jmp  0x0800:.real                ; reload CS with a real-mode segment
  1063                                  .real:
  1064 00000C13 B80070                      mov  ax, 0x7000
  1065 00000C16 8ED0                        mov  ss, ax                      ; restore real-mode stack (SP preserved)
  1066 00000C18 B80008                      mov  ax, 0x0800
  1067 00000C1B 8ED8                        mov  ds, ax
  1068 00000C1D 31C0                        xor  ax, ax
  1069 00000C1F 8EC0                        mov  es, ax
  1070 00000C21 0F011E[8315]                lidt [rp_idt]                    ; restore real-mode IVT
  1071 00000C26 9D                          popf
  1072 00000C27 C3                          ret
  1073                                  
  1074                                  ; PM draw dispatch targets (executed inside run_in_pm, 16-bit PM).
  1075                                  pm_all:
  1076 00000C28 E856FB                      call draw_background
  1077 00000C2B E874FB                      call draw_tree_logo
  1078 00000C2E E8FCFB                      call draw_title_bar
  1079 00000C31 E84BFC                      call draw_menu_panel
  1080 00000C34 E8C0FC                      call draw_boot_entries
  1081 00000C37 E886FD                      call draw_footer
  1082 00000C3A E8C4FD                      call draw_timer_display
  1083 00000C3D C3                          ret
  1084                                  pm_menu:
  1085 00000C3E E83EFC                      call draw_menu_panel
  1086 00000C41 E8B3FC                      call draw_boot_entries
  1087 00000C44 E8BAFD                      call draw_timer_display
  1088 00000C47 C3                          ret
  1089                                  pm_timer:
  1090 00000C48 E8B6FD                      call draw_timer_display
  1091 00000C4B C3                          ret

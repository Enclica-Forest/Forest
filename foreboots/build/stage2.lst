   261 000002E7 CD10                        int  0x10
   262 000002E9 83F84F                      cmp  ax, 0x004F
   263 000002EC 7538                        jne  .svs_fail
   264 000002EE 2666813E0020564553-         cmp  dword [es:VBEINFO_OFF], 0x41534556   ; "VESA"
   264 000002F7 41                 

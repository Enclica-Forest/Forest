  1888 00000D78 AC                          lodsb
  1889 00000D79 84C0                        test al, al
  1890 00000D7B 740C                        jz   .bp_done
  1891 00000D7D B40E                        mov  ah, 0x0E
  1892 00000D7F 31DB                        xor  bx, bx
  1893 00000D81 B307                        mov  bl, 0x07
  1894 00000D83 CD10                        int  0x10
  1895 00000D85 0E                          push cs
  1896 00000D86 1F                          pop  ds
  1897 00000D87 EBEF                        jmp  .bp_loop
  1898                                  .bp_done:
  1899 00000D89 1F                          pop  ds
  1900 00000D8A 5B                          pop  bx
  1901 00000D8B 58                          pop  ax
  1902 00000D8C C3                          ret

  2462                                  ; ============================================================================
  2463                                  ; enter_pm_and_jump_stage3: load PM GDT, enable PE, far-jump to 32-bit, then
  2464                                  ; jump to stage3 at STAGE3_LOAD_PHYS with ESI=boot_info, EDI=multiboot_info.
  2465                                  ; Does NOT change the video mode (the chosen VBE mode / text mode is kept so
  2466                                  ; the kernel receives the framebuffer state described in multiboot_info).
  2467                                  ; ============================================================================
  2468                                  enter_pm_and_jump_stage3:
  2469 000014B5 FA                          cli
  2470 000014B6 0F0116[2815]                lgdt [gdt_pm_desc]
  2471 000014BB E492                        in   al, 0x92
  2472 000014BD 0C02                        or   al, 0x02
  2473 000014BF E692                        out  0x92, al
  2474 000014C1 0F20C0                      mov  eax, cr0
  2475 000014C4 6683C801                    or   eax, 1
  2476 000014C8 0F22C0                      mov  cr0, eax
  2477                                      ; Far-jump to 32-bit PM. stage2 is loaded at physical 0x8000 but assembled
  2478                                      ; with ORG 0, so the flat-PM (GDT base=0) entry EIP must be the PHYSICAL
  2479                                      ; address (.pm32 + 0x8000), not the ORG-relative offset.
  2480 000014CB EA[D094]0800                jmp  0x0008:(.pm32 + 0x8000)
  2481                                  
  2482                                  [BITS 32]
  2483                                  .pm32:
  2484 000014D0 66B81000                    mov  ax, 0x0010
  2485 000014D4 8ED8                        mov  ds, ax
  2486 000014D6 8EC0                        mov  es, ax
  2487 000014D8 8EE0                        mov  fs, ax
  2488 000014DA 8EE8                        mov  gs, ax
  2489 000014DC 8ED0                        mov  ss, ax
  2490 000014DE BC00000900                  mov  esp, 0x00090000
  2491 000014E3 BE00100000                  mov  esi, BOOT_INFO_ADDRESS       ; ESI = foreboots_boot_info*
  2492 000014E8 BF00180000                  mov  edi, MULTIBOOT_INFO_ADDR     ; EDI = multiboot_info_t*
  2493                                      ; ABSOLUTE jump: stage2 is assembled ORG 0 but runs at phys 0x8000, so a
  2494                                      ; near `jmp STAGE3_LOAD_PHYS` (rel32) would land 0x8000 past stage3. Load
  2495                                      ; the absolute linear address into a register and jump indirect instead.
  2496 000014ED B800500000                  mov  eax, STAGE3_LOAD_PHYS
  2497 000014F2 FFE0                        jmp  eax                          ; -> stage3 entry (absolute)
  2498                                  
  2499                                  [BITS 16]

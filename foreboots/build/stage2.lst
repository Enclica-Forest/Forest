  1947                                  ; ============================================================================
  1948                                  ; load_stage3 / load_kernel / load_initrd
  1949                                  ; ============================================================================
  1950                                  load_stage3:
  1951 00000ED8 66B811000000                mov  eax, STAGE3_START_SECTOR
  1952 00000EDE 66B910000000                mov  ecx, STAGE3_SECTOR_COUNT
  1953 00000EE4 66BE00500000                mov  esi, STAGE3_LOAD_PHYS
  1954 00000EEA E8A0FE                      call disk_load
  1955 00000EED 7201                        jc   .ls3_fail
  1956 00000EEF C3                          ret
  1957                                  .ls3_fail:
  1958 00000EF0 BE[CC16]                    mov  si, str_s3err
  1959 00000EF3 E87DFE                      call bios_print
  1960 00000EF6 C3                          ret                        ; non-fatal: stage3 may already be in memory
  1961                                  
  1962                                  ; ============================================================================
  1963                                  ; load_kernel: stream the kernel ELF (at disk sector KERNEL_START_SECTOR)
  1964                                  ; directly into each PT_LOAD segment's physical address. Handles kernels of
  1965                                  ; ANY size, exactly like GRUB: instead of buffering the whole file, each
  1966                                  ; segment is read (in <=63-sector chunks) into a low bounce buffer and copied
  1967                                  ; up to its destination — which may be far above 1 MiB — via unreal mode
  1968                                  ; (FS = 4 GiB flat). No 256 KiB / low-memory limit.
  1969                                  ;
  1970                                  ; On success: boot_info.kernel_entry / .kernel_is64bit are set and the
  1971                                  ; FOREB_BIF_KERNEL_PRELOADED flag is raised so stage3 skips its own ELF copy.
  1972                                  ; Requires A20 enabled. Ensures unreal mode itself. Real mode, ES=0.
  1973                                  ; ============================================================================
  1974                                  ; ----------------------------------------------------------------------------
  1975                                  ; foreb_enable_unreal: put FS into "unreal mode" (base 0, 4 GiB limit) using the
  1976                                  ; active PM handoff GDT (gdt_pm_desc, flat data selector 0x10). Briefly enters
  1977                                  ; protected mode WITHOUT reloading CS, loads FS, then returns to real mode; the
  1978                                  ; FS descriptor cache keeps the 4 GiB limit so `mov [fs:e**]` reaches all RAM.
  1979                                  ; The real-mode IVT is left intact, so INT 13h keeps working afterwards.
  1980                                  ; Interrupts are disabled across the PE window. Preserves EAX/DS.
  1981                                  ; ----------------------------------------------------------------------------
  1982                                  foreb_enable_unreal:
  1983 00000EF7 FA                          cli
  1984 00000EF8 6650                        push eax
  1985 00000EFA 53                          push bx
  1986 00000EFB 0F0116[2815]                lgdt [gdt_pm_desc]
  1987 00000F00 0F20C0                      mov  eax, cr0
  1988 00000F03 6683C801                    or   eax, 1
  1989 00000F07 0F22C0                      mov  cr0, eax                    ; PE=1 (16-bit PM, CS cache unchanged)
  1990 00000F0A EB00                        jmp  $+2                         ; flush prefetch queue after mode switch
  1991 00000F0C BB1000                      mov  bx, 0x10
  1992 00000F0F 8EE3                        mov  fs, bx                      ; FS := flat 4 GiB data descriptor (sel 0x10)
  1993 00000F11 8EEB                        mov  gs, bx                      ; GS too (spare flat segment)
  1994 00000F13 0F20C0                      mov  eax, cr0
  1995 00000F16 6683E0FE                    and  eax, 0xFFFFFFFE
  1996 00000F1A 0F22C0                      mov  cr0, eax                    ; PE=0; FS/GS caches retain 4 GiB limit
  1997 00000F1D EB00                        jmp  $+2                         ; flush prefetch after returning to real mode
  1998 00000F1F 5B                          pop  bx
  1999 00000F20 6658                        pop  eax
  2000 00000F22 C606[3015]01                mov  byte [unreal_ok], 1
  2001 00000F27 C3                          ret                              ; leave IF as caller set it (load runs cli'd)
  2002                                  
  2003                                  ; ----------------------------------------------------------------------------
  2004                                  ; foreb_read: robust LBA disk read (INT 13h AH=42h) used by the kernel loader.
  2005                                  ; A direct DAP read like stage1's — no AH=41h precheck / CHS fallback (that
  2006                                  ; path in lba_read_one corrupts the sector count on some BIOSes). Reads to a
  2007                                  ; real-mode-addressable (<1 MiB) buffer; the caller blits up via unreal mode.
  2008                                  ;   In: EAX = LBA, CX = sector count (<=127), ESI = physical dest (<1 MiB).
  2009                                  ;   Uses drive boot_info.boot_disk.  Returns CF=1 on error. Preserves GP regs.
  2010                                  ; ----------------------------------------------------------------------------
  2011                                  foreb_read:
  2012 00000F28 6660                        pushad
  2013 00000F2A 1E                          push ds
  2014 00000F2B 06                          push es
  2015 00000F2C 31DB                        xor  bx, bx
  2016 00000F2E 8EDB                        mov  ds, bx                      ; DS=0 for DAP + boot_disk
  2017 00000F30 8EC3                        mov  es, bx
  2018 00000F32 BF0005                      mov  di, DAP_BUF
  2019 00000F35 C60510                      mov  byte  [di + 0], 0x10
  2020 00000F38 C6450100                    mov  byte  [di + 1], 0
  2021 00000F3C 894D02                      mov  [di + 2], cx                ; sector count
  2022 00000F3F 6689F2                      mov  edx, esi
  2023 00000F42 66C1EA04                    shr  edx, 4
  2024 00000F46 6689F3                      mov  ebx, esi
  2025 00000F49 6683E30F                    and  ebx, 0x0F
  2026 00000F4D 895D04                      mov  [di + 4], bx                ; dest offset
  2027 00000F50 895506                      mov  [di + 6], dx                ; dest segment
  2028 00000F53 66894508                    mov  [di + 8], eax               ; LBA (low 32)
  2029 00000F57 66C7450C00000000            mov  dword [di + 12], 0          ; LBA (high 32)
  2030 00000F5F 8A160C10                    mov  dl, [boot_info + foreboots_boot_info.boot_disk]
  2031 00000F63 BE0005                      mov  si, DAP_BUF
  2032 00000F66 B442                        mov  ah, 0x42
  2033 00000F68 CD13                        int  0x13                        ; CF survives the pops/popad below
  2034 00000F6A 07                          pop  es
  2035 00000F6B 1F                          pop  ds

  1093                                  ; streamed). No per-chunk text output, so nothing ever scrolls on the BIOS path.
  1094                                  pm_loading:
  1095 00000C4C C706[7015]A600              mov  word [fb_x], MENU_X + 6
  1096 00000C52 C706[7215]F000              mov  word [fb_y], ENTRY_Y_START
  1097 00000C58 C706[7415]D401              mov  word [fb_w], MENU_W - 12
  1098 00000C5E C706[7615]9600              mov  word [fb_h], 150
  1099 00000C64 C606[7815]11                mov  byte [fb_c], FOREB_PANEL
  1100 00000C69 E89EF9                      call fill_box
  1101 00000C6C C706[7B15]C800              mov  word [dc_x], MENU_X + 40
  1102 00000C72 C706[7D15]1C01              mov  word [dc_y], ENTRY_Y_START + 44
  1103 00000C78 C606[8015]14                mov  byte [dc_color], FOREB_TITLE

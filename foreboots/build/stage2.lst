   177 00000E00 BBAA55              <1>  mov bx, 0x55AA
   178 00000E03 8A160C10            <1>  mov dl, [%1]
   179 00000E07 CD13                <1>  int 0x13
   180 00000E09 721F                <1>  jc %%lro_chs
   181 00000E0B 81FB55AA            <1>  cmp bx, 0xAA55
   182 00000E0F 7519                <1>  jne %%lro_chs
   183 00000E11 F6C101              <1>  test cl, 0x01
   184 00000E14 7414                <1>  jz %%lro_chs

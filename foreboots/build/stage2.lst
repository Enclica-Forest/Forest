   271 00000308 660FB75704                  movzx edx, word [bx + 4]        ; bpp
   272 0000030D E86600                      call  find_vbe_mode             ; CF=0 on success
   273 00000310 7305                        jnc   .svs_done
   274 00000312 83C306                      add   bx, 6
   275 00000315 EBE3                        jmp   .svs_pref
   276                                  .svs_done:
   277 00000317 C606[2F15]01                mov  byte [vesa_ok], 1
   278 0000031C 2666830E081002              or   dword [es:boot_info + foreboots_boot_info.flags], FOREB_BIF_FRAMEBUFFER
   279 00000323 58                          pop  ax

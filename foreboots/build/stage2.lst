  1123                                  ; ============================================================================
  1124                                  text_mode_menu:
  1125 00000CC4 B80300                      mov  ax, 0x0003
  1126 00000CC7 CD10                        int  0x10
  1127 00000CC9 B401                        mov  ah, 0x01
  1128 00000CCB B90020                      mov  cx, 0x2000
  1129 00000CCE CD10                        int  0x10
  1130                                  .tm_redraw:
  1131 00000CD0 B80300                      mov  ax, 0x0003
  1132 00000CD3 CD10                        int  0x10
  1133 00000CD5 BE[2617]                    mov  si, str_textbanner
  1134 00000CD8 E89800                      call bios_print
  1135 00000CDB BE[B519]                    mov  si, str_nokernel
  1136 00000CDE E89200                      call bios_print
  1137 00000CE1 B90000                      mov  cx, 0
  1138                                  .tm_entries:
  1139 00000CE4 83F904                      cmp  cx, BOOT_ENTRY_COUNT
  1140 00000CE7 7D26                        jge  .tm_wait_key
  1141 00000CE9 3B0E[5C15]                  cmp  cx, [selected_entry]
  1142 00000CED 7505                        jne  .tm_no_arrow
  1143 00000CEF BE[021A]                    mov  si, str_arrow
  1144 00000CF2 EB03                        jmp  .tm_print_arrow
  1145                                  .tm_no_arrow:
  1146 00000CF4 BE[071A]                    mov  si, str_noarrow
  1147                                  .tm_print_arrow:
  1148 00000CF7 E87900                      call bios_print
  1149 00000CFA 0FB7D9                      movzx bx, cx
  1150 00000CFD D1E3                        shl   bx, 1
  1151 00000CFF 8BB7[AD1A]                  mov   si, [entry_labels + bx]
  1152 00000D03 E86D00                      call  bios_print
  1153 00000D06 BE[0C1A]                    mov   si, str_crlf
  1154 00000D09 E86700                      call  bios_print
  1155 00000D0C 41                          inc  cx
  1156 00000D0D EBD5                        jmp  .tm_entries
  1157                                  .tm_wait_key:
  1158 00000D0F BE[8018]                    mov  si, str_textfooter
  1159 00000D12 E85E00                      call bios_print
  1160 00000D15 B400                        mov  ah, 0x00
  1161 00000D17 CD16                        int  0x16
  1162 00000D19 E6E9                        out  0xE9, al             ; DEBUG: ASCII code of key
  1163 00000D1B 88E0                        mov  al, ah
  1164 00000D1D E6E9                        out  0xE9, al             ; DEBUG: scan code of key
  1165 00000D1F 0E                          push cs
  1166 00000D20 1F                          pop  ds
  1167 00000D21 80FC48                      cmp  ah, KEY_UP
  1168 00000D24 740C                        je   .tm_up
  1169 00000D26 80FC50                      cmp  ah, KEY_DOWN
  1170 00000D29 7419                        je   .tm_down
  1171 00000D2B 80FC1C                      cmp  ah, KEY_ENTER
  1172 00000D2E 742F                        je   .tm_done
  1173 00000D30 EBDD                        jmp  .tm_wait_key
  1174                                  .tm_up:
  1175 00000D32 B007                        mov  al, 0x07
  1176 00000D34 E83100                      call beep
  1177 00000D37 833E[5C15]00                cmp  word [selected_entry], 0
  1178 00000D3C 74D1                        je   .tm_wait_key
  1179 00000D3E FF0E[5C15]                  dec  word [selected_entry]
  1180 00000D42 EB8C                        jmp  .tm_redraw
  1181                                  .tm_down:
  1182 00000D44 B007                        mov  al, 0x07
  1183 00000D46 E81F00                      call beep
  1184 00000D49 FF06[5C15]                  inc  word [selected_entry]
  1185 00000D4D 833E[5C15]04                cmp  word [selected_entry], BOOT_ENTRY_COUNT
  1186 00000D52 0F8C7AFF                    jl   .tm_redraw
  1187 00000D56 C706[5C15]0000              mov  word [selected_entry], 0
  1188 00000D5C E971FF                      jmp  .tm_redraw
  1189                                  .tm_done:
  1190 00000D5F B00D                        mov  al, 0x0D
  1191 00000D61 E80400                      call beep
  1192 00000D64 A1[5C15]                    mov  ax, [selected_entry]
  1193 00000D67 C3                          ret
  1194                                  
  1195                                  ; ============================================================================
  1196                                  ; beep: output AL via INT 10h teletype (BEL=0x07 for standard beep)
  1197                                  ; ============================================================================
  1198                                  beep:
  1199 00000D68 50                          push ax
  1200 00000D69 53                          push bx
  1201 00000D6A B40E                        mov  ah, 0x0E
  1202 00000D6C 31DB                        xor  bx, bx
  1203 00000D6E CD10                        int  0x10
  1204 00000D70 5B                          pop  bx
  1205 00000D71 58                          pop  ax
  1206 00000D72 C3                          ret
  1207                                  
  1208                                  %if 0  ; ===== FORBSHELL recovery shell — removed to fit the graphical menu =====
  1209                                  ; ============================================================================
  1210                                  ; recovery_menu: FORB recovery interface. Returns to caller on "Retry" / Esc.
  1211                                  ; ============================================================================
  1212                                  recovery_menu:
  1213                                      mov  ax, 0x0003
  1214                                      int  0x10
  1215                                      mov  word [recov_sel], 0
  1216                                  .rm_redraw:
  1217                                      mov  ax, 0x0003
  1218                                      int  0x10
  1219                                      mov  si, str_recoverbanner
  1220                                      call bios_print
  1221                                      mov  cx, 0
  1222                                  .rm_entries:
  1223                                      cmp  cx, 4
  1224                                      jge  .rm_wait_key
  1225                                      cmp  cx, [recov_sel]
  1226                                      jne  .rm_no_arrow
  1227                                      mov  si, str_arrow
  1228                                      jmp  .rm_print
  1229                                  .rm_no_arrow:
  1230                                      mov  si, str_noarrow
  1231                                  .rm_print:
  1232                                      call bios_print
  1233                                      movzx bx, cx
  1234                                      shl   bx, 1
  1235                                      mov   si, [recov_labels + bx]
  1236                                      call  bios_print
  1237                                      mov   si, str_crlf
  1238                                      call  bios_print
  1239                                      inc  cx
  1240                                      jmp  .rm_entries
  1241                                  .rm_wait_key:
  1242                                      mov  si, str_recoverfooter
  1243                                      call bios_print
  1244                                      mov  ah, 0x00
  1245                                      int  0x16
  1246                                      cmp  ah, KEY_UP
  1247                                      je   .rm_up
  1248                                      cmp  ah, KEY_DOWN
  1249                                      je   .rm_down
  1250                                      cmp  ah, KEY_ENTER
  1251                                      je   .rm_select
  1252                                      cmp  ah, KEY_ESCAPE
  1253                                      je   .rm_exit
  1254                                      jmp  .rm_wait_key
  1255                                  .rm_up:
  1256                                      mov  al, 0x07
  1257                                      call beep
  1258                                      cmp  word [recov_sel], 0
  1259                                      je   .rm_wait_key
  1260                                      dec  word [recov_sel]
  1261                                      jmp  .rm_redraw
  1262                                  .rm_down:
  1263                                      mov  al, 0x07
  1264                                      call beep
  1265                                      inc  word [recov_sel]
  1266                                      cmp  word [recov_sel], 4
  1267                                      jl   .rm_redraw
  1268                                      mov  word [recov_sel], 0
  1269                                      jmp  .rm_redraw
  1270                                  .rm_select:
  1271                                      mov  al, 0x0D
  1272                                      call beep
  1273                                      mov  ax, [recov_sel]
  1274                                      cmp  ax, 0
  1275                                      je   forbshell            ; launch FORBSHELL
  1276                                      cmp  ax, 1
  1277                                      je   .rm_reboot
  1278                                      cmp  ax, 2
  1279                                      je   .rm_about
  1280                                      ret                        ; 3 = back to menu
  1281                                  .rm_reboot:
  1282                                      mov  si, str_rebooting
  1283                                      call bios_print
  1284                                      int  0x19
  1285                                      jmp  $
  1286                                  .rm_about:
  1287                                      mov  si, str_about
  1288                                      call bios_print
  1289                                      mov  ah, 0x00
  1290                                      int  0x16
  1291                                      jmp  .rm_redraw
  1292                                  .rm_exit:
  1293                                      ret
  1294                                  
  1295                                  ; ============================================================================
  1296                                  ; FORBSHELL — ForeB Recovery Shell
  1297                                  ; Full command-line interface for recovery and diagnostics.
  1298                                  ; ============================================================================
  1299                                  forbshell:
  1300                                      mov  ax, 0x0003
  1301                                      int  0x10
  1302                                      push cs
  1303                                      pop  ds
  1304                                      mov  al, 'S'              ; DEBUG: forbshell entered
  1305                                      out  0xE9, al
  1306                                      mov  byte [shell_exit], 0
  1307                                      mov  si, str_shell_banner
  1308                                      call bios_print
  1309                                  .fs_loop:
  1310                                      mov  si, str_shell_prompt
  1311                                      call bios_print
  1312                                      mov  di, cmd_buf
  1313                                      xor  cx, cx
  1314                                  .fs_read:
  1315                                      xor  ax, ax
  1316                                      int  0x16
  1317                                      xchg ax, bp              ; save keypress in BP (preserve AX for key checks)
  1318                                      push cs
  1319                                      pop  ds                  ; fix DS (INT may clobber it)
  1320                                      xchg ax, bp              ; restore keypress to AX
  1321                                      cmp  ah, 0x1C
  1322                                      je   .fs_enter
  1323                                      cmp  ah, 0x0E
  1324                                      je   .fs_bs
  1325                                      cmp  al, 0x20
  1326                                      jb   .fs_read
  1327                                      cmp  al, 0x7E
  1328                                      ja   .fs_read
  1329                                      cmp  cx, 78
  1330                                      jae  .fs_full
  1331                                      mov  [di], al
  1332                                      inc  di
  1333                                      inc  cx
  1334                                      mov  ah, 0x0E
  1335                                      int  0x10
  1336                                      push cs
  1337                                      pop  ds
  1338                                      jmp  .fs_read
  1339                                  .fs_bs:
  1340                                      test cx, cx
  1341                                      jz   .fs_read
  1342                                      dec  di
  1343                                      dec  cx
  1344                                      mov  al, 0x08
  1345                                      mov  ah, 0x0E
  1346                                      int  0x10
  1347                                      push cs
  1348                                      pop  ds
  1349                                      mov  al, 0x20
  1350                                      int  0x10
  1351                                      push cs
  1352                                      pop  ds
  1353                                      mov  al, 0x08
  1354                                      int  0x10
  1355                                      push cs
  1356                                      pop  ds
  1357                                      jmp  .fs_read
  1358                                  .fs_full:
  1359                                      mov  al, 0x07
  1360                                      mov  ah, 0x0E
  1361                                      int  0x10
  1362                                      jmp  .fs_read
  1363                                  .fs_enter:
  1364                                      mov  byte [di], 0
  1365                                      mov  si, str_crlf
  1366                                      call bios_print
  1367                                      cmp  byte [cmd_buf], 0
  1368                                      je   .fs_loop
  1369                                      call shell_dispatch
  1370                                      cmp  byte [shell_exit], 1
  1371                                      je   .fs_done
  1372                                      jmp  .fs_loop
  1373                                  .fs_done:
  1374                                      ret
  1375                                  
  1376                                  ; ============================================================================
  1377                                  ; shell_dispatch: parse cmd_buf, find matching command, call handler
  1378                                  ; ============================================================================
  1379                                  shell_dispatch:
  1380                                      push ax
  1381                                      push bx
  1382                                      push si
  1383                                      push di
  1384                                      push cs
  1385                                      pop  ds
  1386                                      mov  si, cmd_buf
  1387                                  .sd_skip:
  1388                                      cmp  byte [si], ' '
  1389                                      jne  .sd_find
  1390                                      inc  si
  1391                                      jmp  .sd_skip
  1392                                  .sd_find:
  1393                                      mov  bx, cmd_table
  1394                                  .sd_loop:
  1395                                      mov  di, [bx]
  1396                                      test di, di
  1397                                      jz   .sd_unknown
  1398                                      push si
  1399                                      push di
  1400                                      call shell_strcmp
  1401                                      pop  di
  1402                                      pop  si
  1403                                      je   .sd_match
  1404                                      add  bx, 4
  1405                                      jmp  .sd_loop
  1406                                  .sd_match:
  1407                                      call [bx + 2]
  1408                                      pop  di
  1409                                      pop  si
  1410                                      pop  bx
  1411                                      pop  ax
  1412                                      ret
  1413                                  .sd_unknown:
  1414                                      mov  si, str_unknown
  1415                                      call bios_print
  1416                                      mov  si, cmd_buf
  1417                                      call bios_print
  1418                                      mov  si, str_crlf
  1419                                      call bios_print
  1420                                      pop  di
  1421                                      pop  si
  1422                                      pop  bx
  1423                                      pop  ax
  1424                                      ret
  1425                                  
  1426                                  ; ============================================================================
  1427                                  ; shell_strcmp: case-insensitive null-terminated compare DS:SI vs DS:DI
  1428                                  ; Returns ZF=1 if equal. Clobbers AL, BL.
  1429                                  ; ============================================================================
  1430                                  shell_strcmp:
  1431                                  .sc_loop:
  1432                                      lodsb
  1433                                      mov  bl, [di]
  1434                                      inc  di
  1435                                      cmp  al, 'A'
  1436                                      jb   .sc_al
  1437                                      cmp  al, 'Z'
  1438                                      ja   .sc_al
  1439                                      add  al, 32
  1440                                  .sc_al:
  1441                                      cmp  bl, 'A'
  1442                                      jb   .sc_bl
  1443                                      cmp  bl, 'Z'
  1444                                      ja   .sc_bl
  1445                                      add  bl, 32
  1446                                  .sc_bl:
  1447                                      cmp  al, bl
  1448                                      jne  .sc_neq
  1449                                      test al, al
  1450                                      jz   .sc_eq
  1451                                      jmp  .sc_loop
  1452                                  .sc_eq:
  1453                                      ret
  1454                                  .sc_neq:
  1455                                      ret
  1456                                  
  1457                                  ; ============================================================================
  1458                                  ; print_hex32: print EAX as 8-digit hex (DS=0x0800, uses INT 10h)
  1459                                  ; ============================================================================
  1460                                  print_hex32:
  1461                                      push eax
  1462                                      push bx
  1463                                      push cx
  1464                                      mov  cx, 8
  1465                                  .ph_loop:
  1466                                      rol  eax, 4
  1467                                      mov  bl, al
  1468                                      and  bl, 0x0F
  1469                                      cmp  bl, 10
  1470                                      jb   .ph_dig
  1471                                      add  bl, 'A' - 10
  1472                                      jmp  .ph_out
  1473                                  .ph_dig:
  1474                                      add  bl, '0'
  1475                                  .ph_out:
  1476                                      mov  al, bl
  1477                                      mov  ah, 0x0E
  1478                                      int  0x10
  1479                                      loop .ph_loop
  1480                                      pop  cx
  1481                                      pop  bx
  1482                                      pop  eax
  1483                                      ret
  1484                                  
  1485                                  ; ============================================================================
  1486                                  ; print_dec: print AX as unsigned decimal
  1487                                  ; ============================================================================
  1488                                  print_dec:
  1489                                      push ax
  1490                                      push bx
  1491                                      push cx
  1492                                      push dx
  1493                                      mov  bx, 10
  1494                                      xor  cx, cx
  1495                                  .pd_loop:
  1496                                      xor  dx, dx
  1497                                      div  bx
  1498                                      push dx
  1499                                      inc  cx
  1500                                      test ax, ax
  1501                                      jnz  .pd_loop
  1502                                  .pd_print:
  1503                                      pop  ax
  1504                                      add  al, '0'
  1505                                      mov  ah, 0x0E
  1506                                      int  0x10
  1507                                      loop .pd_print
  1508                                      pop  dx
  1509                                      pop  cx
  1510                                      pop  bx
  1511                                      pop  ax
  1512                                      ret
  1513                                  
  1514                                  ; ============================================================================
  1515                                  ; print_hexbyte: print AL as 2-digit hex
  1516                                  ; ============================================================================
  1517                                  print_hexbyte:
  1518                                      push ax
  1519                                      push bx
  1520                                      push cx
  1521                                      mov  cx, 2
  1522                                  .phb_loop:
  1523                                      rol  al, 4
  1524                                      mov  bl, al
  1525                                      and  bl, 0x0F
  1526                                      cmp  bl, 10
  1527                                      jb   .phb_dig
  1528                                      add  bl, 'A' - 10
  1529                                      jmp  .phb_out
  1530                                  .phb_dig:
  1531                                      add  bl, '0'
  1532                                  .phb_out:
  1533                                      mov  al, bl
  1534                                      push cx
  1535                                      mov  ah, 0x0E
  1536                                      int  0x10
  1537                                      pop  cx
  1538                                      loop .phb_loop
  1539                                      pop  cx
  1540                                      pop  bx
  1541                                      pop  ax
  1542                                      ret
  1543                                  
  1544                                  ; ============================================================================
  1545                                  ; FORBSHELL command handlers
  1546                                  ; ============================================================================
  1547                                  cmd_help:
  1548                                      mov  si, str_help_text
  1549                                      call bios_print
  1550                                      ret
  1551                                  
  1552                                  cmd_ver:
  1553                                      mov  si, str_version
  1554                                      call bios_print
  1555                                      ret
  1556                                  
  1557                                  cmd_info:
  1558                                      push es
  1559                                      xor  ax, ax
  1560                                      mov  es, ax
  1561                                      mov  si, str_info_hdr
  1562                                      call bios_print
  1563                                      ; Magic
  1564                                      mov  si, str_info_magic
  1565                                      call bios_print
  1566                                      mov  eax, [es:boot_info + foreboots_boot_info.magic]
  1567                                      call print_hex32
  1568                                      mov  si, str_crlf
  1569                                      call bios_print
  1570                                      ; Memory
  1571                                      mov  si, str_info_mem
  1572                                      call bios_print
  1573                                      mov  ax, [es:boot_info + foreboots_boot_info.mem_lower]
  1574                                      call print_dec
  1575                                      mov  si, str_info_k_lower
  1576                                      call bios_print
  1577                                      mov  ax, [es:boot_info + foreboots_boot_info.mem_upper]
  1578                                      call print_dec
  1579                                      mov  si, str_info_k_upper
  1580                                      call bios_print
  1581                                      ; Disk
  1582                                      mov  si, str_info_disk
  1583                                      call bios_print
  1584                                      movzx eax, byte [es:boot_info + foreboots_boot_info.boot_disk]
  1585                                      call print_hex32
  1586                                      mov  si, str_crlf
  1587                                      call bios_print
  1588                                      ; E820 count
  1589                                      mov  si, str_info_mmap
  1590                                      call bios_print
  1591                                      mov  ax, [es:boot_info + foreboots_boot_info.mmap_count]
  1592                                      call print_dec
  1593                                      mov  si, str_crlf
  1594                                      call bios_print
  1595                                      pop  es
  1596                                      ret
  1597                                  
  1598                                  cmd_mem:
  1599                                      push es
  1600                                      xor  ax, ax
  1601                                      mov  es, ax
  1602                                      mov  si, str_mem_hdr
  1603                                      call bios_print
  1604                                      movzx cx, word [es:boot_info + foreboots_boot_info.mmap_count]
  1605                                      test cx, cx
  1606                                      jz   .cm_none
  1607                                      mov  si, foreb_mmap     ; ES:SI = mmap array at 0x1100
  1608                                  .cm_loop:
  1609                                      push cx
  1610                                      mov  si, str_mem_entry
  1611                                      call bios_print
  1612                                      ; Base (low 32 bits)
  1613                                      mov  eax, [es:si + foreboots_mmap_entry.base]
  1614                                      call print_hex32
  1615                                      mov  si, str_mem_sep
  1616                                      call bios_print
  1617                                      ; Length (low 32 bits)
  1618                                      mov  eax, [es:si + foreboots_mmap_entry.length]
  1619                                      call print_hex32
  1620                                      mov  si, str_mem_sep
  1621                                      call bios_print
  1622                                      ; Type
  1623                                      movzx eax, byte [es:si + foreboots_mmap_entry.type]
  1624                                      call print_hex32
  1625                                      mov  si, str_crlf
  1626                                      call bios_print
  1627                                      add  si, foreboots_mmap_entry_size
  1628                                      pop  cx
  1629                                      loop .cm_loop
  1630                                      pop  es
  1631                                      ret
  1632                                  .cm_none:
  1633                                      mov  si, str_mem_none
  1634                                      call bios_print
  1635                                      pop  es
  1636                                      ret
  1637                                  
  1638                                  cmd_cpu:
  1639                                      push es
  1640                                      xor  ax, ax
  1641                                      mov  es, ax
  1642                                      mov  si, str_cpu_hdr
  1643                                      call bios_print
  1644                                      mov  si, str_cpu_cpuid
  1645                                      call bios_print
  1646                                      mov  al, [es:boot_info + foreboots_boot_info.cpuid_available]
  1647                                      test al, al
  1648                                      jz   .cm_cpu_no
  1649                                      mov  si, str_yes
  1650                                      jmp  .cm_cpu_pr
  1651                                  .cm_cpu_no:
  1652                                      mov  si, str_no
  1653                                  .cm_cpu_pr:
  1654                                      call bios_print
  1655                                      mov  si, str_crlf
  1656                                      call bios_print
  1657                                      mov  si, str_cpu_lm
  1658                                      call bios_print
  1659                                      mov  al, [es:boot_info + foreboots_boot_info.long_mode_available]
  1660                                      test al, al
  1661                                      jz   .cm_lm_no
  1662                                      mov  si, str_yes
  1663                                      jmp  .cm_lm_pr
  1664                                  .cm_lm_no:
  1665                                      mov  si, str_no
  1666                                  .cm_lm_pr:
  1667                                      call bios_print
  1668                                      mov  si, str_crlf
  1669                                      call bios_print
  1670                                      mov  si, str_cpu_pae
  1671                                      call bios_print
  1672                                      mov  al, [es:boot_info + foreboots_boot_info.pae_available]
  1673                                      test al, al
  1674                                      jz   .cm_pae_no
  1675                                      mov  si, str_yes
  1676                                      jmp  .cm_pae_pr
  1677                                  .cm_pae_no:
  1678                                      mov  si, str_no
  1679                                  .cm_pae_pr:
  1680                                      call bios_print
  1681                                      mov  si, str_crlf
  1682                                      call bios_print
  1683                                      pop  es
  1684                                      ret
  1685                                  
  1686                                  cmd_disk:
  1687                                      push es
  1688                                      xor  ax, ax
  1689                                      mov  es, ax
  1690                                      mov  si, str_disk_hdr
  1691                                      call bios_print
  1692                                      mov  si, str_disk_drive
  1693                                      call bios_print
  1694                                      movzx eax, byte [es:boot_info + foreboots_boot_info.boot_disk]
  1695                                      call print_hex32
  1696                                      mov  si, str_crlf
  1697                                      call bios_print
  1698                                      mov  si, str_disk_lba
  1699                                      call bios_print
  1700                                      ; Check LBA support via INT 13h
  1701                                      mov  ah, 0x41
  1702                                      mov  bx, 0x55AA
  1703                                      mov  dl, [es:boot_info + foreboots_boot_info.boot_disk]
  1704                                      int  0x13
  1705                                      jc   .cd_no
  1706                                      cmp  bx, 0xAA55
  1707                                      jne  .cd_no
  1708                                      mov  si, str_yes
  1709                                      jmp  .cd_pr
  1710                                  .cd_no:
  1711                                      mov  si, str_no
  1712                                  .cd_pr:
  1713                                      call bios_print
  1714                                      mov  si, str_crlf
  1715                                      call bios_print
  1716                                      pop  es
  1717                                      ret
  1718                                  
  1719                                  cmd_clear:
  1720                                      mov  ax, 0x0003
  1721                                      int  0x10
  1722                                      ret
  1723                                  
  1724                                  cmd_reboot:
  1725                                      mov  si, str_rebooting
  1726                                      call bios_print
  1727                                      int  0x19
  1728                                      jmp  $
  1729                                  
  1730                                  cmd_about:
  1731                                      mov  si, str_about
  1732                                      call bios_print
  1733                                      ret
  1734                                  
  1735                                  cmd_date:
  1736                                      mov  si, str_date_hdr
  1737                                      call bios_print
  1738                                      ; Read RTC date/time from CMOS (BCD format)
  1739                                      mov  al, 0x04            ; Hours
  1740                                      out  0x70, al
  1741                                      in   al, 0x71
  1742                                      call print_hexbyte
  1743                                      mov  al, ':'
  1744                                      mov  ah, 0x0E
  1745                                      int  0x10
  1746                                      mov  al, 0x02            ; Minutes
  1747                                      out  0x70, al
  1748                                      in   al, 0x71
  1749                                      call print_hexbyte
  1750                                      mov  al, ':'
  1751                                      mov  ah, 0x0E
  1752                                      int  0x10
  1753                                      mov  al, 0x00            ; Seconds
  1754                                      out  0x70, al
  1755                                      in   al, 0x71
  1756                                      call print_hexbyte
  1757                                      mov  si, str_date_space
  1758                                      call bios_print
  1759                                      mov  al, 0x08            ; Month
  1760                                      out  0x70, al
  1761                                      in   al, 0x71
  1762                                      call print_hexbyte
  1763                                      mov  al, '/'
  1764                                      mov  ah, 0x0E
  1765                                      int  0x10
  1766                                      mov  al, 0x07            ; Day
  1767                                      out  0x70, al
  1768                                      in   al, 0x71
  1769                                      call print_hexbyte
  1770                                      mov  al, '/'
  1771                                      mov  ah, 0x0E
  1772                                      int  0x10
  1773                                      mov  al, 0x09            ; Year
  1774                                      out  0x70, al
  1775                                      in   al, 0x71
  1776                                      call print_hexbyte
  1777                                      mov  si, str_crlf
  1778                                      call bios_print
  1779                                      ret
  1780                                  
  1781                                  cmd_beep:
  1782                                      mov  al, 0x07
  1783                                      mov  ah, 0x0E
  1784                                      int  0x10
  1785                                      ret
  1786                                  
  1787                                  cmd_exit:
  1788                                      mov  byte [shell_exit], 1
  1789                                      mov  si, str_exit_msg
  1790                                      call bios_print
  1791                                      ret

  2501                                  ; Protected-mode GDT (32-bit flat code/data)
  2502 000014F4 90<rep 4h>              align 8
  2503                                  gdt_pm_start:
  2504 000014F8 0000000000000000            dq  0                             ; null (sel 0x00)
  2505                                      ; 32-bit flat code (sel 0x08): base 0, limit 4 GiB, G=1 D=1, access 0x9A.
  2506                                      ; NOTE: the last four fields MUST be bytes (db), not words — using dw here
  2507                                      ; produced 12-byte descriptors and misaligned selector 0x10.
  2508 00001500 FFFF0000                    dw  0xFFFF, 0x0000
  2509 00001504 009ACF00                    db  0x00, 0x9A, 0xCF, 0x00
  2510                                      ; 32-bit flat data (sel 0x10): base 0, limit 4 GiB, G=1 D=1, access 0x92.
  2511 00001508 FFFF0000                    dw  0xFFFF, 0x0000
  2512 0000150C 0092CF00                    db  0x00, 0x92, 0xCF, 0x00
  2513                                      ; 16-bit code (sel 0x18): base 0x8000, limit 64 KiB. Lets the ORG-0 draw
  2514                                      ; code run unchanged from PM; EIP = ORG-relative offset.
  2515 00001510 FFFF0080                    dw  0xFFFF, 0x8000
  2516 00001514 009A0000                    db  0x00, 0x9A, 0x00, 0x00
  2517                                      ; 16-bit data (sel 0x20): base 0x8000, limit 64 KiB. DS/ES so variable and
  2518                                      ; string accesses resolve to the same linear addresses as real mode.
  2519 00001518 FFFF0080                    dw  0xFFFF, 0x8000
  2520 0000151C 00920000                    db  0x00, 0x92, 0x00, 0x00
  2521                                      ; 16-bit data (sel 0x28): base 0x70000, limit 64 KiB. SS matches real-mode
  2522                                      ; SS=0x7000 so SP is valid across the transition (also used for real return).
  2523 00001520 FFFF0000                    dw  0xFFFF, 0x0000
  2524 00001524 07920000                    db  0x07, 0x92, 0x00, 0x00

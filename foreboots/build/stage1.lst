   408                              <1> %define FOREB_BIF_CMDLINE      0x00000004
   409                              <1> %define FOREB_BIF_LONG_MODE    0x00000008
   410                              <1> %define FOREB_BIF_CPUID        0x00000010
   411                              <1> %define FOREB_BIF_PAE          0x00000020
   412                              <1> %define FOREB_BIF_INITRD       0x00000040

    14                                  
    15                                  ; 64-byte header — xorriso -boot-info-table patches bytes 8-63 on CD.
    16 00000000 EB3E                            jmp  short _start
    17 00000002 00<rep 6h>                      times 6 db 0
    18 00000008 00000000                bti_pvd_lba:  dd 0            ; offset 8:  PVD LBA (16 on a valid ISO)
    19 0000000C 00000000                bti_boot_lba: dd 0            ; offset 12: boot image LBA (nonzero on CD)
    20 00000010 00<rep 30h>                     times 48 db 0
    21                                  
    22                                  _start:
    23 00000040 FA                          cli
    24 00000041 EA[4600]0000                jmp  0x0000:_normalize_cs
    25                                  
    26                                  _normalize_cs:
    27 00000046 6631C0                      xor  eax, eax
    28 00000049 8ED8                        mov  ds, ax
    29 0000004B 8EC0                        mov  es, ax
    30 0000004D 8ED0                        mov  ss, ax
    31 0000004F BC007C                      mov  sp, STACK_TOP
    32 00000052 FB                          sti
    33 00000053 8816[8C01]                  mov  [boot_drive], dl
    34                                  
    35                                      ; Relocate 0x7C00 -> 0x0600 (512 bytes)
    36 00000057 BE007C                      mov  si, 0x7C00
    37 0000005A BF0006                      mov  di, 0x0600
    38 0000005D B90001                      mov  cx, 256
    39 00000060 F3A5                        rep  movsw
    40 00000062 EA[678A]0000                jmp  0x0000:(_relocated - 0x7C00 + 0x0600)
    41                                  
    42                                  _relocated:
    43 00000067 6631C0                      xor  eax, eax
    44 0000006A 8ED8                        mov  ds, ax
    45 0000006C 8EC0                        mov  es, ax
    46 0000006E 66A31005                    mov  [LBA_BASE_OFFSET], eax
    47                                  
    48                                      ; Print boot message
    49 00000072 BE[8D8B]                    mov  si, 0x0600 + (msg_loading - 0x7C00)
    50 00000075 E80001                      call print_str
    51                                  
    52                                      ; --- El Torito detection: on CD, xorriso -boot-info-table patched the
    53                                      ;     header at 0x7C00 (boot image LBA != 0).  The BIOS already pre-loaded
    54                                      ;     the whole 48-sector blob at 0x7C00, so use the in-memory blob copy
    55                                      ;     path and do NOT issue INT 13h reads for the stages: on an emulated
    56                                      ;     El Torito drive those reads return mangled data (the 2-byte stage2
    57                                      ;     magic survives the corruption, so the old magic-only fallback never
    58                                      ;     fired and a corrupted stage2 ran). ---
    59 00000078 66A1[0C8A]                  mov  eax, [0x0600 + (bti_boot_lba - 0x7C00)]
    60 0000007C 6685C0                      test eax, eax
    61 0000007F 7402                        jz   .hdd_path
    62 00000081 EB74                        jmp  .try_blob
    63                                  
    64                                      ; --- HDD path: pull stage2 + stage3 off the boot disk via INT 13h
    65                                      ;     LBA extensions. On a real hard disk / USB / raw disk image the BIOS
    66                                      ;     only loaded sector 0 (this MBR), so we must read the rest ourselves.
    67                                      ;     If the read fails or the stage2 signature is absent, fall back to
    68                                      ;     the blob-copy path. ---
    69                                  .hdd_path:
    70 00000083 8A16[8C8B]                  mov  dl, [0x0600 + (boot_drive - 0x7C00)]
    71 00000087 BF0005                      mov  di, 0x0500                  ; DAP scratch (DS=0)
    72 0000008A C7051000                    mov  word [di], 0x0010           ; size=0x10, reserved=0
    73 0000008E C745021000                  mov  word [di + 2], STAGE2_SECTOR_COUNT
    74 00000093 C745040000                  mov  word  [di + 4], 0x0000      ; dest offset
    75 00000098 C745060008                  mov  word  [di + 6], STAGE2_LOAD_SEG   ; 0x0800 -> phys 0x8000
    76 0000009D 66C7450801000000            mov  dword [di + 8], STAGE2_START_SECTOR
    77 000000A5 66C7450C00000000            mov  dword [di + 12], 0
    78 000000AD BE0005                      mov  si, 0x0500
    79 000000B0 B442                        mov  ah, 0x42
    80 000000B2 CD13                        int  0x13
    81 000000B4 7241                        jc   .try_blob
    82 000000B6 66A10280                    mov  eax, [0x8002]             ; magic 0xFEB1 + "Fo" tag
    83 000000BA 663DB1FE466F                cmp  eax, 0x6f46feb1
    84 000000C0 7535                        jne  .try_blob
    85                                      ; stage2 landed — read stage3 (LBA 17..32) to 0x5000.
    86 000000C2 8A16[8C8B]                  mov  dl, [0x0600 + (boot_drive - 0x7C00)]
    87 000000C6 BF0005                      mov  di, 0x0500
    88 000000C9 C7051000                    mov  word [di], 0x0010
    89 000000CD C745021000                  mov  word [di + 2], STAGE3_SECTOR_COUNT
    90 000000D2 C745040000                  mov  word  [di + 4], 0x0000
    91 000000D7 C745060005                  mov  word  [di + 6], STAGE3_LOAD_SEG   ; 0x0500 -> phys 0x5000
    92 000000DC 66C7450811000000            mov  dword [di + 8], STAGE3_START_SECTOR
    93 000000E4 66C7450C00000000            mov  dword [di + 12], 0
    94 000000EC BE0005                      mov  si, 0x0500
    95 000000EF B442                        mov  ah, 0x42
    96 000000F1 CD13                        int  0x13
    97 000000F3 7231                        jc   .bad_s2
    98 000000F5 EB24                        jmp  .launch
    99                                  
   100                                  .try_blob:
   101                                      ; CD blob path: stage1@0x7C00, stage2@0x7E00, stage3@0x9E00.
   102                                      ; Copy stage3 first (no overlap), then stage2 (backward, overlap).
   103 000000F7 BE009E                      mov  si, 0x9E00
   104 000000FA BF0050                      mov  di, 0x5000
   105 000000FD B90020                      mov  cx, 8192
   106 00000100 F3A4                        rep  movsb
   107 00000102 FD                          std
   108 00000103 BEFF9D                      mov  si, 0x7E00 + 8191
   109 00000106 BFFF9F                      mov  di, 0x8000 + 8191
   110 00000109 B90020                      mov  cx, 8192
   111 0000010C F3A4                        rep  movsb
   112 0000010E FC                          cld
   113 0000010F 66A10280                    mov  eax, [0x8002]             ; magic 0xFEB1 + "Fo" tag
   114 00000113 663DB1FE466F                cmp  eax, 0x6f46feb1
   115 00000119 750B                        jne  .bad_s2
   116                                  
   117                                  .launch:
   118                                      ; Jump to stage2 — DL = boot drive
   119 0000011B 8A16[8C8B]                  mov  dl, [0x0600 + (boot_drive - 0x7C00)]
   120 0000011F 30F6                        xor  dh, dh
   121 00000121 EA00000008                  jmp  STAGE2_LOAD_SEG:0x0000
   122                                  
   123                                  .bad_s2:
   124 00000126 BE[A38B]                    mov  si, 0x0600 + (msg_bad_s2 - 0x7C00)
   125 00000129 EB00                        jmp  error_flash
   126                                  
   127                                  ; ============================================================================
   128                                  ; error_flash: SI = message (physical addr, DS=0). Never returns.
   129                                  ; Flashing red/white screen + beep + border + message.
   130                                  ; ============================================================================
   131                                  error_flash:
   132 0000012B B80300                      mov  ax, 0x0003
   133 0000012E CD10                        int  0x10
   134 00000130 6800B8                      push 0xB800
   135 00000133 07                          pop  es
   136 00000134 B34F                        mov  bl, 0x4F
   137                                  .ef_loop:
   138 00000136 88DF                        mov  bh, bl
   139 00000138 B80006                      mov  ax, 0x0600
   140 0000013B 31C9                        xor  cx, cx
   141 0000013D BA4F18                      mov  dx, 0x184F
   142 00000140 CD10                        int  0x10
   143 00000142 53                          push bx
   144 00000143 31FF                        xor  di, di
   145 00000145 B95000                      mov  cx, 80
   146 00000148 B0DB                        mov  al, 0xDB
   147 0000014A 88DC                        mov  ah, bl
   148 0000014C F3AB                        rep  stosw
   149 0000014E BF000F                      mov  di, 3840
   150 00000151 B95000                      mov  cx, 80
   151 00000154 F3AB                        rep  stosw
   152 00000156 30FF                        xor  bh, bh
   153 00000158 BA0A0B                      mov  dx, 0x0B0A
   154 0000015B B402                        mov  ah, 0x02
   155 0000015D CD10                        int  0x10
   156 0000015F E81600                      call print_str
   157 00000162 B007                        mov  al, 0x07
   158 00000164 B40E                        mov  ah, 0x0E
   159 00000166 CD10                        int  0x10
   160 00000168 5B                          pop  bx
   161 00000169 B90700                      mov  cx, 0x0007
   162 0000016C BA20A1                      mov  dx, 0xA120
   163 0000016F B486                        mov  ah, 0x86
   164 00000171 CD15                        int  0x15
   165 00000173 80F30F                      xor  bl, 0x0F
   166 00000176 EBBE                        jmp  .ef_loop
   167                                  
   168                                  ; ============================================================================
   169                                  ; print_str: null-terminated string at DS:SI via INT 10h teletype
   170                                  ; ============================================================================
   171                                  print_str:
   172 00000178 50                          push ax
   173 00000179 53                          push bx
   174                                  .ps_loop:
   175 0000017A AC                          lodsb
   176 0000017B 84C0                        test al, al
   177 0000017D 740A                        jz   .ps_done
   178 0000017F B40E                        mov  ah, 0x0E
   179 00000181 31DB                        xor  bx, bx
   180 00000183 B307                        mov  bl, 0x07
   181 00000185 CD10                        int  0x10
   182 00000187 EBF1                        jmp  .ps_loop
   183                                  .ps_done:
   184 00000189 5B                          pop  bx
   185 0000018A 58                          pop  ax
   186 0000018B C3                          ret

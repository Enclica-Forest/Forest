    14                                  
    15                                  ; 64-byte header — xorriso -boot-info-table patches bytes 8-63 on CD.
    16 00000000 EB3E                            jmp  short _start
    17 00000002 00<rep 3Eh>                     times 62 db 0
    18                                  
    19                                  _start:
    20 00000040 FA                          cli
    21 00000041 EA[4600]0000                jmp  0x0000:_normalize_cs
    22                                  
    23                                  _normalize_cs:
    24 00000046 6631C0                      xor  eax, eax
    25 00000049 8ED8                        mov  ds, ax
    26 0000004B 8EC0                        mov  es, ax
    27 0000004D 8ED0                        mov  ss, ax
    28 0000004F BC007C                      mov  sp, STACK_TOP
    29 00000052 FB                          sti
    30 00000053 8816[7F01]                  mov  [boot_drive], dl
    31                                  
    32                                      ; Relocate 0x7C00 -> 0x0600 (512 bytes)
    33 00000057 BE007C                      mov  si, 0x7C00
    34 0000005A BF0006                      mov  di, 0x0600
    35 0000005D B90001                      mov  cx, 256
    36 00000060 F3A5                        rep  movsw
    37 00000062 EA[678A]0000                jmp  0x0000:(_relocated - 0x7C00 + 0x0600)
    38                                  
    39                                  _relocated:
    40 00000067 6631C0                      xor  eax, eax
    41 0000006A 8ED8                        mov  ds, ax
    42 0000006C 8EC0                        mov  es, ax
    43 0000006E 66A31005                    mov  [LBA_BASE_OFFSET], eax
    44                                  
    45                                      ; Print boot message
    46 00000072 BE[808B]                    mov  si, 0x0600 + (msg_loading - 0x7C00)
    47 00000075 E8F300                      call print_str
    48                                  
    49                                      ; --- HDD path first: pull stage2 + stage3 off the boot disk via INT 13h
    50                                      ;     LBA extensions. On a real hard disk / USB / raw disk image the BIOS
    51                                      ;     only loaded sector 0 (this MBR), so we must read the rest ourselves.
    52                                      ;     If the read fails or the stage2 magic is absent (e.g. El Torito CD
    53                                      ;     no-emulation, where the BIOS pre-loaded the whole 48-sector blob at
    54                                      ;     0x7C00 and LBA math differs), fall back to the blob-copy path. ---
    55 00000078 8A16[7F8B]                  mov  dl, [0x0600 + (boot_drive - 0x7C00)]
    56 0000007C BF0005                      mov  di, 0x0500                  ; DAP scratch (DS=0)
    57 0000007F C60510                      mov  byte  [di + 0], 0x10        ; DAP size
    58 00000082 C6450100                    mov  byte  [di + 1], 0
    59 00000086 C745021000                  mov  word  [di + 2], STAGE2_SECTOR_COUNT
    60 0000008B C745040000                  mov  word  [di + 4], 0x0000      ; dest offset
    61 00000090 C745060008                  mov  word  [di + 6], STAGE2_LOAD_SEG   ; 0x0800 -> phys 0x8000
    62 00000095 66C7450801000000            mov  dword [di + 8], STAGE2_START_SECTOR
    63 0000009D 66C7450C00000000            mov  dword [di + 12], 0
    64 000000A5 BE0005                      mov  si, 0x0500
    65 000000A8 B442                        mov  ah, 0x42
    66 000000AA CD13                        int  0x13
    67 000000AC 7240                        jc   .try_blob
    68 000000AE A10280                      mov  ax, [0x8002]
    69 000000B1 3DB1FE                      cmp  ax, 0xFEB1
    70 000000B4 7538                        jne  .try_blob
    71                                      ; stage2 landed — read stage3 (LBA 17..32) to 0x5000.
    72 000000B6 8A16[7F8B]                  mov  dl, [0x0600 + (boot_drive - 0x7C00)]
    73 000000BA BF0005                      mov  di, 0x0500
    74 000000BD C60510                      mov  byte  [di + 0], 0x10
    75 000000C0 C6450100                    mov  byte  [di + 1], 0
    76 000000C4 C745021000                  mov  word  [di + 2], STAGE3_SECTOR_COUNT
    77 000000C9 C745040000                  mov  word  [di + 4], 0x0000
    78 000000CE C745060005                  mov  word  [di + 6], STAGE3_LOAD_SEG   ; 0x0500 -> phys 0x5000
    79 000000D3 66C7450811000000            mov  dword [di + 8], STAGE3_START_SECTOR
    80 000000DB 66C7450C00000000            mov  dword [di + 12], 0
    81 000000E3 BE0005                      mov  si, 0x0500
    82 000000E6 B442                        mov  ah, 0x42
    83 000000E8 CD13                        int  0x13
    84 000000EA 722D                        jc   .bad_s2
    85 000000EC EB20                        jmp  .launch
    86                                  
    87                                  .try_blob:
    88                                      ; CD blob path: stage1@0x7C00, stage2@0x7E00, stage3@0x9E00.
    89                                      ; Copy stage3 first (no overlap), then stage2 (backward, overlap).
    90 000000EE BE009E                      mov  si, 0x9E00
    91 000000F1 BF0050                      mov  di, 0x5000
    92 000000F4 B90020                      mov  cx, 8192
    93 000000F7 F3A4                        rep  movsb
    94 000000F9 FD                          std
    95 000000FA BEFF9D                      mov  si, 0x7E00 + 8191
    96 000000FD BFFF9F                      mov  di, 0x8000 + 8191
    97 00000100 B90020                      mov  cx, 8192
    98 00000103 F3A4                        rep  movsb
    99 00000105 FC                          cld
   100 00000106 A10280                      mov  ax, [0x8002]
   101 00000109 3DB1FE                      cmp  ax, 0xFEB1
   102 0000010C 750B                        jne  .bad_s2
   103                                  
   104                                  .launch:
   105                                      ; Jump to stage2 — DL = boot drive
   106 0000010E 8A16[7F8B]                  mov  dl, [0x0600 + (boot_drive - 0x7C00)]
   107 00000112 30F6                        xor  dh, dh
   108 00000114 EA00000008                  jmp  STAGE2_LOAD_SEG:0x0000
   109                                  
   110                                  .bad_s2:
   111 00000119 BE[988B]                    mov  si, 0x0600 + (msg_bad_s2 - 0x7C00)
   112 0000011C EB00                        jmp  error_flash
   113                                  
   114                                  ; ============================================================================
   115                                  ; error_flash: SI = message (physical addr, DS=0). Never returns.
   116                                  ; Flashing red/white screen + beep + border + message.
   117                                  ; ============================================================================
   118                                  error_flash:
   119 0000011E B80300                      mov  ax, 0x0003
   120 00000121 CD10                        int  0x10
   121 00000123 6800B8                      push 0xB800
   122 00000126 07                          pop  es
   123 00000127 B34F                        mov  bl, 0x4F
   124                                  .ef_loop:
   125 00000129 88DF                        mov  bh, bl
   126 0000012B B80006                      mov  ax, 0x0600
   127 0000012E 31C9                        xor  cx, cx
   128 00000130 BA4F18                      mov  dx, 0x184F
   129 00000133 CD10                        int  0x10
   130 00000135 53                          push bx
   131 00000136 31FF                        xor  di, di
   132 00000138 B95000                      mov  cx, 80
   133 0000013B B0DB                        mov  al, 0xDB
   134 0000013D 88DC                        mov  ah, bl
   135 0000013F F3AB                        rep  stosw
   136 00000141 BF000F                      mov  di, 3840
   137 00000144 B95000                      mov  cx, 80
   138 00000147 F3AB                        rep  stosw
   139 00000149 30FF                        xor  bh, bh
   140 0000014B BA0A0B                      mov  dx, 0x0B0A
   141 0000014E B402                        mov  ah, 0x02
   142 00000150 CD10                        int  0x10
   143 00000152 E81600                      call print_str
   144 00000155 B007                        mov  al, 0x07
   145 00000157 B40E                        mov  ah, 0x0E
   146 00000159 CD10                        int  0x10
   147 0000015B 5B                          pop  bx
   148 0000015C B90700                      mov  cx, 0x0007
   149 0000015F BA20A1                      mov  dx, 0xA120
   150 00000162 B486                        mov  ah, 0x86
   151 00000164 CD15                        int  0x15
   152 00000166 80F30F                      xor  bl, 0x0F
   153 00000169 EBBE                        jmp  .ef_loop
   154                                  
   155                                  ; ============================================================================
   156                                  ; print_str: null-terminated string at DS:SI via INT 10h teletype
   157                                  ; ============================================================================
   158                                  print_str:
   159 0000016B 50                          push ax
   160 0000016C 53                          push bx
   161                                  .ps_loop:
   162 0000016D AC                          lodsb
   163 0000016E 84C0                        test al, al
   164 00000170 740A                        jz   .ps_done
   165 00000172 B40E                        mov  ah, 0x0E
   166 00000174 31DB                        xor  bx, bx
   167 00000176 B307                        mov  bl, 0x07
   168 00000178 CD10                        int  0x10
   169 0000017A EBF1                        jmp  .ps_loop
   170                                  .ps_done:
   171 0000017C 5B                          pop  bx
   172 0000017D 58                          pop  ax
   173 0000017E C3                          ret

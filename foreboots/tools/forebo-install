# ===========================================================================
#  Diagnostics
# ===========================================================================
class Reporter:
    """Collects warnings/notes.  Warnings are echoed to stderr immediately
    (stdout stays clean for `generate`); notes only in verbose mode."""

    def __init__(self, verbose: bool = False) -> None:
        self.verbose = verbose
        self.warnings: List[str] = []
        self.notes: List[str] = []

    def warn(self, msg: str) -> None:
        self.warnings.append(msg)
        print("warning: " + msg, file=sys.stderr)

    def note(self, msg: str) -> None:
        self.notes.append(msg)
        if self.verbose:
            print("note: " + msg, file=sys.stderr)


def die(msg: str) -> int:
    print(TOOL + ": error: " + msg, file=sys.stderr)
    return 1


# ===========================================================================
#  Small helpers
# ===========================================================================
def sanitize_title(title: str) -> str:
    """Firmware default-path resolution splits on '/', so '/' inside a title
    is replaced by U+2215 DIVISION SLASH; double quotes become single."""
    return title.replace("/", "∕").replace('"', "'")


def normalize_esp_path(p: str) -> str:
    """Backslashes -> '/', exactly one leading '/'."""
    p = p.strip().replace("\\", "/")
    return "/" + p.lstrip("/")


def guess_icon(text: str, entry_type: str = "") -> str:
    """First-hit-wins keyword match; falls back to a per-type default."""
    hay = text.lower()
    for kw, icon in ICON_KEYWORDS:
        if kw in hay:
            return icon
    if entry_type == "linux":
        return "tux"
    if entry_type == "chainload":
        return "usb"
    if entry_type == "forest":
        return "os"
    return ""


def read_text(path: str) -> str:
    """Read a config file robustly (CRLF, weird encodings)."""
    with open(path, "rb") as f:
        data = f.read()
    text = data.decode("utf-8", errors="replace")
    return text.replace("\r\n", "\n").replace("\r", "\n")


def atomic_write(path: str, data: bytes) -> None:
    """Write via temp-file-then-rename inside the target directory."""
    d = os.path.dirname(path) or "."
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".forebo-install-")
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def run_cmd(cmd: Sequence[str], timeout: int = 15) -> Optional[str]:
    """Run a command, return stdout or None on any failure."""
    try:
        r = subprocess.run(list(cmd), capture_output=True, text=True,
                           timeout=timeout)
    except (OSError, subprocess.SubprocessError):
        return None
    if r.returncode != 0:
        return None
    return r.stdout


# ===========================================================================
#  ESP context (partition UUID lookup for limine guid()/uuid() schemes)
# ===========================================================================
def split_disk_part(dev: str) -> Tuple[Optional[str], Optional[str]]:
    """/dev/nvme1n1p1 -> (/dev/nvme1n1, 1); /dev/sda2 -> (/dev/sda, 2);
    /dev/mmcblk0p3 -> (/dev/mmcblk0, 3)."""
    m = re.match(r"^(/dev/nvme\d+n\d+|/dev/mmcblk\d+|/dev/loop\d+)p(\d+)$", dev)
    if m:
        return m.group(1), m.group(2)
    m = re.match(r"^(/dev/(?:sd|vd|hd|xvd)[a-z]+|/dev/[a-z]+[a-z])(\d+)$", dev)
    if m:
        return m.group(1), m.group(2)
    return None, None


class EspContext:
    def __init__(self, esp: str, reporter: Reporter) -> None:
        self.esp = esp
        self.reporter = reporter
        self._uuids: Optional[Set[str]] = None
        self._uuids_tried = False

    def esp_file(self, esp_path: str) -> str:
        """Map an ESP-absolute path to a host path."""
        return os.path.join(self.esp, esp_path.lstrip("/"))

    def partition_uuids(self) -> Optional[Set[str]]:
        """UUIDs/PARTUUIDs identifying the ESP partition, or None when they
        cannot be determined (offline, no findmnt/lsblk, ...)."""
        if self._uuids_tried:
            return self._uuids
        self._uuids_tried = True
        result: Set[str] = set()
        dev = None
        out = run_cmd(["findmnt", "-no", "SOURCE", self.esp])
        if out and out.strip():
            dev = out.strip().splitlines()[0].strip()
        if dev:
            out = run_cmd(["lsblk", "-no", "PARTUUID,UUID", dev])
            if out:
                result.update(t.lower() for t in out.split())
            disk, _part = split_disk_part(dev)
            if disk:
                out = run_cmd(["lsblk", "-no", "PTUUID", disk])
                if out:
                    result.update(t.lower() for t in out.split())
            byuuid = "/dev/disk/by-partuuid"
            try:
                if os.path.isdir(byuuid):
                    real = os.path.realpath(dev)
                    for name in os.listdir(byuuid):
                        if os.path.realpath(os.path.join(byuuid, name)) == real:
                            result.add(name.lower())
            except OSError:
                pass
        self._uuids = result if result else None
        return self._uuids

    def match_uuid(self, arg: str) -> Optional[bool]:
        """True: arg identifies the ESP.  False: clearly a different
        partition.  None: cannot tell (offline)."""
        uuids = self.partition_uuids()
        if uuids is None:
            return None
        return arg.strip().lower() in uuids


def detect_esp() -> Optional[str]:
    """First of /boot, /boot/efi, /efi that is a vfat mount per findmnt."""
    for cand in ("/boot", "/boot/efi", "/efi"):
        out = run_cmd(["findmnt", "-no", "FSTYPE", cand])
        if out and out.strip() == "vfat":
            return cand
    return None


# ===========================================================================
#  Limine path resolution
# ===========================================================================
SCHEME_RE = re.compile(r"^(\w+)\(([^)]*)\):(.*)$")
# Limine's content-hash annotation is `#<hex>` at the very end of a path.
# The grammar spec says {32,128}, but real limine-entry-tool snapshot paths
# carry concatenated hashes longer than 128 hex chars (see the Snapshot 906
# module_path in tools/tests/limine.conf, 170 chars) - so the upper bound is
# left open.  The 32-char floor protects real filenames ending in short
# hex-ish runs.  A `_sha256_<hex>` component INSIDE the name never matches
# (no '#', not at end) and is always kept.
HASH_RE = re.compile(r"#[0-9a-fA-F]{32,}$")


def resolve_limine_path(value: str, ctx: EspContext, rep: Reporter,
                        where: str = "") -> str:
    """Resolve a limine path spec to an ESP-absolute path.

    Strips the trailing `#<hex>` content-hash annotation but keeps a
    `_sha256_<hex>` component inside a filename (real on-disk name)."""
    v = value.strip()
    m = SCHEME_RE.match(v)
    if m:
        scheme, arg, rest = m.group(1).lower(), m.group(2).strip(), m.group(3)
        if scheme == "boot":
            pass
        elif scheme in ("guid", "uuid"):
            if arg:
                match = ctx.match_uuid(arg)
                if match is False:
                    rep.warn("%spath %r refers to partition %s which is not "
                             "the ESP; ForeB can only boot files from the "
                             "ESP - copy the file onto the ESP"
                             % (where, v, arg))
                elif match is None:
                    rep.note("%scannot verify partition %s for path %r "
                             "(offline); assuming it is the ESP"
                             % (where, arg, v))
        elif scheme in ("hdd", "cd"):
            rep.warn("%sunsupported scheme %s() in path %r; keeping the "
                     "path best-effort" % (where, scheme, v))
        else:
            rep.warn("%sunknown scheme %s() in path %r; keeping the path "
                     "best-effort" % (where, scheme, v))
        v = rest
    v = HASH_RE.sub("", v)
    return normalize_esp_path(v)


# ===========================================================================
#  Data model
# ===========================================================================
BOOT_KEYS = ("protocol", "path", "kernel_path", "image_path")


@dataclass
class Node:
    """Raw parsed node (limine).  An ENTRY when it has at least one boot
    key, otherwise a GROUP."""
    name: str
    depth: int = 0
    line: int = 0
    keys: Dict[str, object] = field(default_factory=dict)  # module_path: list
    children: List["Node"] = field(default_factory=list)

    def is_entry(self) -> bool:
        return any(k in self.keys for k in BOOT_KEYS)


@dataclass
class OutEntry:
    title: str
    type: str                                   # forest|linux|chainload
    kernel: str = ""
    modules: List[str] = field(default_factory=list)
    vmlinuz: str = ""
    initrd: str = ""
    chain: str = ""
    cmdline: str = ""
    icon: str = ""
    extra_comments: List[str] = field(default_factory=list)
    source_name: str = ""                       # e.g. systemd-boot filename


@dataclass
class OutGroup:
    title: str
    icon: str = ""
    children: List[object] = field(default_factory=list)  # OutGroup|OutEntry


@dataclass
class ParsedConfig:
    kind: str                                   # limine|grub|systemd-boot
    source_path: str
    timeout: Optional[int] = None
    remember_last: bool = False
    # default spec: ("index", N 1-based) | ("pattern", str) | ("path", str)
    default: Optional[Tuple[str, object]] = None
    wallpaper: Optional[str] = None             # resolved ESP-absolute path
    wallpaper_raw: Optional[str] = None
    roots: List[object] = field(default_factory=list)
    index_entries: List[Optional[OutEntry]] = field(default_factory=list)


# ===========================================================================
#  Limine parser + translator
# ===========================================================================
LIMINE_KNOWN_GLOBALS = {
    "timeout", "default_entry", "remember_last_entry", "wallpaper",
    "interface_branding", "interface_resolution", "interface_branding_color",
    "verbose", "hash_mismatch_panic", "randomize_memory", "max_resolution",
    "backdrop", "term_font", "term_font_scale", "term_margin",
    "term_margin_gradient", "graphics", "quiet",
}


def parse_limine(path: str, ctx: EspContext, rep: Reporter) -> ParsedConfig:
    text = read_text(path)
    cfg = ParsedConfig(kind="limine", source_path=path)
    roots: List[Node] = []
    stack: List[Node] = []
    globals_: Dict[str, str] = {}

    for lineno, raw in enumerate(text.splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("/"):
            m = re.match(r"^(/+)\+?(.*)$", line)
            if not m:  # unreachable, defensive
                rep.note("line %d: malformed header ignored: %r"
                         % (lineno, line))
                continue
            depth = len(m.group(1))
            name = m.group(2).strip()
            node = Node(name=name, depth=depth, line=lineno)
            # Parent = nearest preceding node with smaller depth that is not
            # an entry (entries are leaves; a depth-N node following a depth
            # N-1 *entry* belongs to that entry's parent group).
            while stack and stack[-1].depth >= depth:
                stack.pop()
            while stack and stack[-1].is_entry():
                stack.pop()
            if stack:
                stack[-1].children.append(node)
            else:
                roots.append(node)
            stack.append(node)
            continue
        m = re.match(r"^([A-Za-z0-9_]+)\s*:\s*(.*)$", line)
        if not m:
            rep.note("line %d: unrecognized line ignored: %r"
                     % (lineno, line))
            continue
        key, value = m.group(1).lower(), m.group(2).strip()
        if key == "comment":
            continue
        if stack:
            node = stack[-1]
            if key == "module_path":
                node.keys.setdefault("module_path", [])
                assert isinstance(node.keys["module_path"], list)
                node.keys["module_path"].append(value)
            else:
                node.keys[key] = value
        else:
            globals_[key] = value

    # ---- globals -----------------------------------------------------------
    for key, value in globals_.items():
        if key == "timeout":
            try:
                cfg.timeout = int(round(float(value)))
            except ValueError:
                rep.note("invalid timeout %r ignored" % value)
        elif key == "default_entry":
            try:
                cfg.default = ("index", int(value))
            except ValueError:
                rep.note("invalid default_entry %r ignored" % value)
        elif key == "remember_last_entry":
            cfg.remember_last = value.lower() in ("yes", "1", "true", "on")
        elif key == "wallpaper":
            if value:
                cfg.wallpaper_raw = value
                cfg.wallpaper = resolve_limine_path(value, ctx, rep,
                                                    "wallpaper: ")
        elif key in LIMINE_KNOWN_GLOBALS or key.startswith("term_"):
            rep.note("global %r ignored (cosmetic/unsupported)" % key)
        else:
            rep.note("unknown global %r ignored" % key)

    # ---- translate nodes ----------------------------------------------------
    def translate(node: Node) -> Optional[object]:
        where = "line %d: " % node.line
        if not node.is_entry():
            children = []
            for c in node.children:
                out = translate(c)
                if out is not None:
                    children.append(out)
            if not children and not node.keys:
                rep.note("%sgroup %r has no children and no keys; dropped"
                         % (where, node.name))
                return None
            title = sanitize_title(node.name)
            return OutGroup(title=title,
                            icon=guess_icon(node.name),
                            children=children)

        keys = node.keys
        proto = str(keys.get("protocol", "")).strip().lower()
        title = sanitize_title(node.name)

        def rp(v: str) -> str:
            return resolve_limine_path(v, ctx, rep, where)

        def cmdline() -> str:
            c = str(keys.get("cmdline", keys.get("kernel_cmdline", "")))
            return c.strip()

        def modules() -> List[str]:
            return [rp(m) for m in keys.get("module_path", [])]  # type: ignore

        entry: Optional[OutEntry] = None
        if proto == "linux":
            kpath = keys.get("kernel_path") or keys.get("path")
            if not kpath:
                rep.warn("%sentry %r: protocol=linux but no path; skipped"
                         % (where, node.name))
            else:
                mods = modules()
                extras = mods[1:]
                for e in extras:
                    rep.warn("%sentry %r: extra module %s is unsupported "
                             "for type=linux; emitted as a comment"
                             % (where, node.name, e))
                entry = OutEntry(title=title, type="linux",
                                 vmlinuz=rp(str(kpath)),
                                 initrd=mods[0] if mods else "",
                                 extra_comments=extras,
                                 cmdline=cmdline())
        elif proto in ("multiboot", "multiboot1", "multiboot2"):
            if proto == "multiboot2":
                rep.warn("%sentry %r: ForeB is multiboot1-only; a multiboot2 "
                         "kernel may not boot" % (where, node.name))
            kpath = keys.get("kernel_path") or keys.get("path")
            if not kpath:
                rep.warn("%sentry %r: protocol=%s but no kernel path; "
                         "skipped" % (where, node.name, proto))
            else:
                entry = OutEntry(title=title, type="forest",
                                 kernel=rp(str(kpath)),
                                 modules=modules(),
                                 cmdline=cmdline())
        elif proto == "efi_chainload":
            img = keys.get("image_path") or keys.get("path")
            if not img:
                rep.warn("%sentry %r: efi_chainload without image_path; "
                         "skipped" % (where, node.name))
            else:
                entry = OutEntry(title=title, type="chainload",
                                 chain=rp(str(img)), cmdline=cmdline())
        elif proto == "efi":
            p = keys.get("path")
            if not p:
                rep.warn("%sentry %r: protocol=efi but no path; skipped"
                         % (where, node.name))
            else:
                entry = OutEntry(title=title, type="chainload",
                                 chain=rp(str(p)), cmdline=cmdline())
        elif proto == "limine":
            p = keys.get("path")
            if not p:
                rep.warn("%sentry %r: protocol=limine but no path; skipped"
                         % (where, node.name))
            else:
                entry = OutEntry(title=title, type="chainload",
                                 chain=rp(str(p)), cmdline=cmdline())
        elif proto == "chainload":
            rep.warn("%sentry %r: legacy BIOS sector chainload is "
                     "unsupported on UEFI ForeB; skipped" % (where, node.name))
        else:
            if proto:
                rep.note("%sentry %r: unknown protocol %r; inferring type "
                         "from paths" % (where, node.name, proto))
            img = keys.get("image_path")
            p = keys.get("path")
            if img or (p and str(p).lower().endswith(".efi")):
                entry = OutEntry(title=title, type="chainload",
                                 chain=rp(str(img or p)), cmdline=cmdline())
            elif p:
                mods = modules()
                entry = OutEntry(title=title, type="linux",
                                 vmlinuz=rp(str(p)),
                                 initrd=mods[0] if mods else "",
                                 extra_comments=mods[1:],
                                 cmdline=cmdline())
            else:
                rep.warn("%sentry %r: no bootable path found; skipped"
                         % (where, node.name))
        if entry is not None:
            base = entry.vmlinuz or entry.kernel or entry.chain
            entry.icon = guess_icon(node.name + " " +
                                    os.path.basename(base), entry.type)
            cfg.index_entries.append(entry)
        return entry

    for n in roots:
        out = translate(n)
        if out is not None:
            cfg.roots.append(out)
    return cfg


# ===========================================================================
#  GRUB parser (best-effort)
# ===========================================================================
@dataclass
class GrubFrame:
    kind: str                                   # menuentry|submenu
    title: str
    classes: List[str]
    line: int
    directives: Dict[str, object] = field(default_factory=dict)
    children: List[object] = field(default_factory=list)


def _grub_clean_path(p: str, rep: Reporter, where: str) -> str:
    orig = p
    p = re.sub(r"^\([^)]*\)", "", p)            # (hd0,gpt1)/...
    p = re.sub(r"^\$\{?root\}?", "", p)         # $root/...
    p = p.strip()
    if orig != p or not p.startswith("/"):
        rep.warn("%spath %r does not look ESP-absolute; ForeB can only "
                 "boot files from the ESP - verify/copy it" % (where, orig))
    return normalize_esp_path(p)


def parse_grub(path: str, ctx: EspContext, rep: Reporter) -> ParsedConfig:
    del ctx  # grub paths are used verbatim (best-effort)
    text = read_text(path)
    cfg = ParsedConfig(kind="grub", source_path=path)
    rep.note("grub.cfg parsing is best-effort")
    frames: List[GrubFrame] = []
    pending: Optional[GrubFrame] = None
    set_default: Optional[str] = None
    set_timeout: Optional[str] = None

    def close_frame(frame: GrubFrame) -> None:
        node = finalize(frame)
        if node is None:
            return
        if frames:
            frames[-1].children.append(node)
        else:
            cfg.roots.append(node)

    def finalize(frame: GrubFrame) -> Optional[object]:
        where = "line %d: " % frame.line
        title = sanitize_title(frame.title)
        if frame.kind == "submenu":
            if not frame.children:
                rep.note("%ssubmenu %r is empty; dropped"
                         % (where, frame.title))
                return None
            return OutGroup(title=title,
                            icon=guess_icon(frame.title),
                            children=frame.children)
        d = frame.directives
        entry: Optional[OutEntry] = None
        if "chainloader" in d:
            entry = OutEntry(title=title, type="chainload",
                             chain=_grub_clean_path(str(d["chainloader"]),
                                                    rep, where))
        elif "linux" in d:
            linux_line = str(d["linux"])
            parts = linux_line.split(None, 1)
            vmlinuz = _grub_clean_path(parts[0], rep, where)
            cmd = parts[1].strip() if len(parts) > 1 else ""
            initrds = [str(x) for x in d.get("initrd", [])]  # type: ignore
            initrds = [_grub_clean_path(i, rep, where) for i in initrds]
            for extra in initrds[1:]:
                rep.warn("%sentry %r: extra initrd %s is unsupported; "
                         "emitted as a comment" % (where, frame.title, extra))
            entry = OutEntry(title=title, type="linux", vmlinuz=vmlinuz,
                             initrd=initrds[0] if initrds else "",
                             extra_comments=initrds[1:], cmdline=cmd)
        elif "multiboot" in d:
            mods = [_grub_clean_path(str(m), rep, where)
                    for m in d.get("module", [])]  # type: ignore
            entry = OutEntry(title=title, type="forest",
                             kernel=_grub_clean_path(str(d["multiboot"]),
                                                     rep, where),
                             modules=mods)
        else:
            rep.note("%smenuentry %r has no boot directive; skipped"
                     % (where, frame.title))
            return None
        hint = frame.title + " " + " ".join(frame.classes) + " " + \
            os.path.basename(entry.vmlinuz or entry.kernel or entry.chain)
        entry.icon = guess_icon(hint, entry.type)
        cfg.index_entries.append(entry)
        return entry

    for lineno, raw in enumerate(text.splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        m = re.match(r"^(menuentry|submenu)\b(.*)$", line)
        if m:
            kind, rest = m.group(1), m.group(2)
            tm = re.match(r"""\s*(["'])(.*?)\1""", rest)
            if not tm:
                rep.warn("line %d: could not parse %s title; block ignored"
                         % (lineno, kind))
                continue
            title = tm.group(2)
            after = rest[tm.end():]
            classes = re.findall(r"--class[=\s]+([^\s]+)", after)
            frame = GrubFrame(kind=kind, title=title, classes=classes,
                              line=lineno)
            opens = after.count("{")
            closes = after.count("}")
            if opens > 0:
                frames.append(frame)
                opens -= 1
            else:
                pending = frame
            delta = opens - closes
            while delta < 0 and frames:
                close_frame(frames.pop())
                delta += 1
            continue
        if pending is not None:
            if "{" in line:
                frames.append(pending)
                pending = None
                line = line.split("{", 1)[1].strip()
                if not line:
                    continue
            else:
                continue
        if frames and frames[-1].kind == "menuentry":
            content = line.split("}")[0].strip().rstrip(";").strip()
            if content:
                d = frames[-1].directives
                where = "line %d: " % lineno
                cm = re.match(r"^(linux|initrd|chainloader|multiboot|module)"
                              r"\s+(.*)$", content)
                if cm:
                    key, val = cm.group(1), cm.group(2).strip()
                    if key == "linux":
                        d.setdefault("linux", val)
                    elif key == "initrd":
                        d.setdefault("initrd", [])
                        assert isinstance(d["initrd"], list)
                        d["initrd"].extend(val.split())
                    elif key == "chainloader":
                        d.setdefault("chainloader", val)
                    elif key == "multiboot":
                        d.setdefault("multiboot", val)
                    elif key == "module":
                        d.setdefault("module", [])
                        assert isinstance(d["module"], list)
                        d["module"].append(val.split()[0])
                elif re.match(r"^(search|set\s+root|insmod|savedefault|"
                              r"recordfail|load_video|echo|sleep|"
                              r"if\b|fi\b|else|elif\b|then|menuentry_id_option"
                              r"|set\s+menuentry)", content):
                    pass  # explicitly ignored grub machinery
                else:
                    rep.note("%sgrub directive ignored: %r"
                             % (where, content))
        delta = line.count("{") - line.count("}")
        while delta < 0 and frames:
            close_frame(frames.pop())
            delta += 1
        if not frames and pending is None:
            sm = re.match(r"^set\s+(default|timeout)=(.*)$", line)
            if sm:
                val = sm.group(2).strip().strip('"').strip("'")
                if sm.group(1) == "default":
                    set_default = val
                else:
                    set_timeout = val
    if pending is not None:
        rep.note("line %d: %s %r never opened its block; dropped"
                 % (pending.line, pending.kind, pending.title))
    while frames:
        rep.note("line %d: unbalanced braces; %s %r closed at EOF"
                 % (frames[-1].line, frames[-1].kind, frames[-1].title))
        close_frame(frames.pop())

    # ---- globals ------------------------------------------------------------
    if set_timeout is not None:
        try:
            cfg.timeout = int(round(float(set_timeout)))
        except ValueError:
            rep.note("grub timeout %r ignored" % set_timeout)
    if set_default is not None:
        if set_default.isdigit():
            cfg.default = ("index", int(set_default) + 1)  # grub is 0-based
        else:
            # grub uses '>' as the submenu separator in saved defaults
            segs = [sanitize_title(s.strip())
                    for s in set_default.split(">") if s.strip()]
            if segs:
                cfg.default = ("path", "/".join(segs))
    return cfg


# ===========================================================================
#  systemd-boot parser
# ===========================================================================
def parse_systemd_boot(esp_dir: str, conf_path: str,
                       rep: Reporter) -> ParsedConfig:
    cfg = ParsedConfig(kind="systemd-boot", source_path=conf_path)
    default_pat: Optional[str] = None

    for lineno, raw in enumerate(read_text(conf_path).splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split(None, 1)
        key = parts[0].lower()
        val = parts[1].strip() if len(parts) > 1 else ""
        if key == "default":
            default_pat = val
        elif key == "timeout":
            try:
                cfg.timeout = int(round(float(val)))
            except ValueError:
                rep.note("line %d: loader.conf timeout %r ignored"
                         % (lineno, val))
        else:
            rep.note("line %d: loader.conf key %r ignored" % (lineno, key))

    entries_dir = os.path.join(esp_dir, "loader", "entries")
    try:
        names = sorted(n for n in os.listdir(entries_dir)
                       if n.endswith(".conf"))
    except OSError:
        names = []
        rep.warn("no loader/entries/*.conf found under %s" % esp_dir)

    for name in names:
        path = os.path.join(entries_dir, name)
        title = ""
        linux = efi = ""
        initrds: List[str] = []
        options: List[str] = []
        for lineno, raw in enumerate(read_text(path).splitlines(), 1):
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            parts = line.split(None, 1)
            key = parts[0].lower()
            val = parts[1].strip() if len(parts) > 1 else ""
            if key == "title":
                title = val
            elif key == "linux":
                linux = val
            elif key == "efi":
                efi = val
            elif key == "initrd":
                if val:
                    initrds.append(val)
            elif key == "options":
                options.append(val.strip())
            else:
                rep.note("%s line %d: key %r ignored" % (name, lineno, key))
        if not title:
            title = name[:-5] if name.endswith(".conf") else name
        where = "%s: " % name
        entry: Optional[OutEntry] = None
        cmd = " ".join(o for o in options if o).strip()
        if linux:
            if efi:
                rep.note("%shas both linux= and efi=; using linux=" % where)
            initrds = [normalize_esp_path(i) for i in initrds]
            for extra in initrds[1:]:
                rep.warn("%sentry %r: extra initrd %s is unsupported; "
                         "emitted as a comment" % (where, title, extra))
            entry = OutEntry(title=sanitize_title(title), type="linux",
                             vmlinuz=normalize_esp_path(linux),
                             initrd=initrds[0] if initrds else "",
                             extra_comments=initrds[1:], cmdline=cmd,
                             source_name=name)
        elif efi:
            entry = OutEntry(title=sanitize_title(title), type="chainload",
                             chain=normalize_esp_path(efi), cmdline=cmd,
                             source_name=name)
        else:
            rep.warn("%sentry %r has neither linux= nor efi=; skipped"
                     % (where, title))
            continue
        entry.icon = guess_icon(title + " " +
                                os.path.basename(entry.vmlinuz or
                                                 entry.chain),
                                entry.type)
        cfg.roots.append(entry)
        cfg.index_entries.append(entry)

    if default_pat:
        cfg.default = ("pattern", default_pat)
    return cfg


# ===========================================================================
#  PNG -> BMP wallpaper conversion
# ===========================================================================
class PngError(Exception):
    pass


PNG_SIG = b"\x89PNG\r\n\x1a\n"


def paeth(a: int, b: int, c: int) -> int:
    p = a + b - c
    pa, pb, pc = abs(p - a), abs(p - b), abs(p - c)
    if pa <= pb and pa <= pc:
        return a
    if pb <= pc:
        return b
    return c


def png_decode(data: bytes) -> Tuple[int, int, List[bytearray]]:
    """Minimal PNG decoder -> (width, height, rows top-down RGB888).

    Supports bit-depth 8, color types 2 (RGB), 6 (RGBA, alpha dropped),
    0 (grayscale); non-interlaced only.  Raises PngError otherwise."""
    if data[:8] != PNG_SIG:
        raise PngError("not a PNG file (bad signature)")
    pos = 8
    ihdr = None
    idat = bytearray()
    while pos + 8 <= len(data):
        length = struct.unpack(">I", data[pos:pos + 4])[0]
        ctype = data[pos + 4:pos + 8]
        chunk = data[pos + 8:pos + 8 + length]
        if len(chunk) != length:
            raise PngError("truncated chunk")
        pos += 12 + length
        if ctype == b"IHDR":
            ihdr = struct.unpack(">IIBBBBB", chunk)
        elif ctype == b"IDAT":
            idat += chunk
        elif ctype == b"IEND":
            break
    if ihdr is None:
        raise PngError("no IHDR chunk")
    w, h, bitdepth, colortype, comp, filt, interlace = ihdr
    if bitdepth != 8:
        raise PngError("unsupported bit depth %d (need 8)" % bitdepth)
    if colortype not in (0, 2, 6):
        raise PngError("unsupported color type %d (need 0/2/6)" % colortype)
    if comp != 0 or filt != 0:
        raise PngError("unsupported compression/filter method")
    if interlace != 0:
        raise PngError("interlaced PNGs are unsupported")
    channels = {0: 1, 2: 3, 6: 4}[colortype]
    stride = w * channels
    try:
        raw = zlib.decompress(bytes(idat))
    except zlib.error as e:
        raise PngError("zlib decompress failed: %s" % e)
    if len(raw) < (stride + 1) * h:
        raise PngError("truncated image data")
    rows: List[bytearray] = []
    prev = bytearray(stride)
    off = 0
    bpp = channels
    for _y in range(h):
        ftype = raw[off]
        off += 1
        line = bytearray(raw[off:off + stride])
        off += stride
        if ftype == 0:      # None
            pass
        elif ftype == 1:    # Sub
            for i in range(bpp, stride):
                line[i] = (line[i] + line[i - bpp]) & 0xFF
        elif ftype == 2:    # Up
            for i in range(stride):
                line[i] = (line[i] + prev[i]) & 0xFF
        elif ftype == 3:    # Average
            for i in range(stride):
                left = line[i - bpp] if i >= bpp else 0
                line[i] = (line[i] + ((left + prev[i]) >> 1)) & 0xFF
        elif ftype == 4:    # Paeth
            for i in range(stride):
                a = line[i - bpp] if i >= bpp else 0
                b = prev[i]
                c = prev[i - bpp] if i >= bpp else 0
                line[i] = (line[i] + paeth(a, b, c)) & 0xFF
        else:
            raise PngError("bad filter type %d" % ftype)
        rows.append(line)
        prev = line
    out: List[bytearray] = []
    for line in rows:
        if colortype == 2:
            out.append(line)
        elif colortype == 6:
            rgb = bytearray(w * 3)
            rgb[0::3] = line[0::4]
            rgb[1::3] = line[1::4]
            rgb[2::3] = line[2::4]
            out.append(rgb)
        else:
            rgb = bytearray(w * 3)
            rgb[0::3] = line
            rgb[1::3] = line
            rgb[2::3] = line
            out.append(rgb)
    return w, h, out


def bmp_encode(w: int, h: int, rows_rgb_topdown: List[bytearray]) -> bytes:
    """24-bit uncompressed BMP, bottom-up rows, BGR order, 4-byte padding."""
    row_bytes = w * 3
    pad = (4 - (row_bytes % 4)) % 4
    padding = b"\x00" * pad
    image_size = (row_bytes + pad) * h
    file_size = 14 + 40 + image_size
    out = bytearray()
    out += b"BM"
    out += struct.pack("<IHHI", file_size, 0, 0, 14 + 40)
    out += struct.pack("<IiiHHIIiiII", 40, w, h, 1, 24, 0,
                       image_size, 2835, 2835, 0, 0)
    for y in range(h - 1, -1, -1):
        row = rows_rgb_topdown[y]
        bgr = bytearray(row_bytes)
        bgr[0::3] = row[2::3]
        bgr[1::3] = row[1::3]
        bgr[2::3] = row[0::3]
        out += bgr + padding
    return bytes(out)


def png_to_bmp(data: bytes) -> bytes:
    """Convert PNG bytes to 24-bit BMP bytes.  Uses PIL when available,
    otherwise the built-in decoder.  Raises PngError on failure."""
    try:
        from PIL import Image  # type: ignore
        import io
        try:
            img = Image.open(io.BytesIO(data)).convert("RGB")
            w, h = img.size
            px = img.tobytes()
            rows = [bytearray(px[y * w * 3:(y + 1) * w * 3])
                    for y in range(h)]
            return bmp_encode(w, h, rows)
        except Exception as e:
            raise PngError("PIL decode failed: %s" % e)
    except ImportError:
        pass
    w, h, rows = png_decode(data)
    return bmp_encode(w, h, rows)


# ===========================================================================
#  forebo.cfg emission
# ===========================================================================
def flatten_entries(roots: Sequence[object]) -> List[Tuple[OutEntry, List[str]]]:
    """All entries in document order with their ancestor title paths."""
    res: List[Tuple[OutEntry, List[str]]] = []

    def walk(nodes: Sequence[object], path: List[str]) -> None:
        for n in nodes:
            if isinstance(n, OutGroup):
                walk(n.children, path + [n.title])
            else:
                assert isinstance(n, OutEntry)
                res.append((n, path))

    walk(roots, [])
    return res


def count_submenus(roots: Sequence[object]) -> int:
    total = 0

    def walk(nodes: Sequence[object]) -> None:
        nonlocal total
        for n in nodes:
            if isinstance(n, OutGroup):
                total += 1
                walk(n.children)

    walk(roots)
    return total


def find_path(roots: Sequence[object], entry: OutEntry) -> Optional[List[str]]:
    for e, path in flatten_entries(roots):
        if e is entry:
            return path + [e.title]
    return None


def cap_entries(roots: List[object], max_entries: int,
                rep: Reporter) -> List[object]:
    """Drop entries beyond the --max-entries safety cap (document order)."""
    count = 0

    def filt(nodes: List[object]) -> List[object]:
        nonlocal count
        out: List[object] = []
        for n in nodes:
            if isinstance(n, OutGroup):
                n.children = filt(n.children)
                if n.children:
                    out.append(n)
                else:
                    rep.note("submenu %r left empty by --max-entries cap; "
                             "dropped" % n.title)
            else:
                count += 1
                if count <= max_entries:
                    out.append(n)
                else:
                    rep.warn("entry %r dropped: --max-entries cap (%d) "
                             "reached" % (n.title, max_entries))
        return out

    return filt(roots)


def validate_entry(e: OutEntry, rep: Reporter) -> None:
    if len(e.title) > MAX_TITLE:
        rep.warn("title %r is %d chars (firmware max %d); truncated"
                 % (e.title, len(e.title), MAX_TITLE))
        e.title = e.title[:MAX_TITLE]
    for label, val in (("kernel", e.kernel), ("vmlinuz", e.vmlinuz),
                       ("initrd", e.initrd), ("chain", e.chain)):
        if len(val) > MAX_PATH:
            rep.warn("entry %r: %s path is %d chars (firmware max %d); "
                     "firmware will truncate it" %
                     (e.title, label, len(val), MAX_PATH))
    for m in e.modules:
        if len(m) > MAX_PATH:
            rep.warn("entry %r: module path is %d chars (firmware max %d); "
                     "firmware will truncate it" % (e.title, len(m), MAX_PATH))
    if '"' in e.cmdline:
        rep.note("entry %r: '\"' in cmdline replaced by \"'\"" % e.title)
        e.cmdline = e.cmdline.replace('"', "'")
    if len(e.cmdline) > MAX_CMDLINE:
        rep.warn("entry %r: cmdline is %d chars (firmware max %d); "
                 "firmware will truncate it" % (e.title, len(e.cmdline)))


def resolve_default(cfg: ParsedConfig, roots: List[object],
                    override: Optional[int], rep: Reporter) -> str:
    entries = flatten_entries(roots)
    spec = cfg.default
    if override is not None:
        spec = ("index", override)
    if spec is None:
        rep.note("no default entry configured; emitting default=0")
        return "0"
    kind, val = spec
    if kind == "index":
        idx = int(val)  # type: ignore
        if idx < 1 or idx > len(cfg.index_entries):
            rep.note("default entry %d out of range (%d entries); emitting "
                     "default=0" % (idx, len(cfg.index_entries)))
            return "0"
        target = cfg.index_entries[idx - 1]
        if target is None:
            rep.warn("default entry %d was skipped during translation "
                     "(unsupported); emitting default=0" % idx)
            return "0"
        path = find_path(roots, target)
        if path is None:
            rep.warn("default entry %d fell victim to the --max-entries "
                     "cap; emitting default=0" % idx)
            return "0"
        return "/".join(path)
    if kind == "pattern":
        pat = str(val)
        for e, path in entries:
            names = [e.source_name,
                     e.source_name[:-5] if
                     e.source_name.endswith(".conf") else e.source_name,
                     e.title]
            if any(n and (n == pat or fnmatch.fnmatchcase(n, pat))
                   for n in names):
                return "/".join(path + [e.title])
        rep.note("default pattern %r matched no entry; emitting default=0"
                 % pat)
        return "0"
    # ("path", prebuilt title path)
    return str(val)


def emit_entry(e: OutEntry, ind: str, out: List[str]) -> None:
    out.append('%smenuentry "%s" {' % (ind, e.title))
    out.append("%s    type=%s" % (ind, e.type))
    if e.type == "forest":
        out.append("%s    kernel=%s" % (ind, e.kernel))
        for m in e.modules:
            out.append("%s    module=%s" % (ind, m))
        for c in e.extra_comments:
            out.append("%s    # extra module (unsupported): %s" % (ind, c))
    elif e.type == "linux":
        out.append("%s    vmlinuz=%s" % (ind, e.vmlinuz))
        if e.initrd:
            out.append("%s    initrd=%s" % (ind, e.initrd))
        for c in e.extra_comments:
            out.append("%s    # extra module (unsupported): %s" % (ind, c))
    elif e.type == "chainload":
        if e.chain:
            out.append("%s    chain=%s" % (ind, e.chain))
    if e.type in ("forest", "linux") or e.cmdline:
        out.append('%s    cmdline="%s"' % (ind, e.cmdline))
    if e.icon:
        out.append("%s    icon=%s" % (ind, e.icon))
    out.append(ind + "}")
    out.append("")


def emit_nodes(nodes: Sequence[object], ind: str, out: List[str]) -> None:
    for n in nodes:
        if isinstance(n, OutGroup):
            out.append('%ssubmenu "%s" {' % (ind, n.title))
            if n.icon:
                out.append("%s    icon=%s" % (ind, n.icon))
            emit_nodes(n.children, ind + "    ", out)
            if out and out[-1] == "":
                out.pop()  # no blank line before the closing brace
            out.append(ind + "}")
            out.append("")
        else:
            assert isinstance(n, OutEntry)
            emit_entry(n, ind, out)


def emit_config(cfg: ParsedConfig, roots: List[object], default_str: str,
                background: Optional[str], extras: bool) -> str:
    stamp = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    out: List[str] = []
    out.append("# " + "=" * 74)
    out.append("#  forebo.cfg - generated by %s v%s" % (TOOL, VERSION))
    out.append("#  Source config : %s (%s)" % (cfg.source_path, cfg.kind))
    out.append("#  Generated     : %s" % stamp)
    if cfg.kind == "grub":
        out.append("#  NOTE: grub.cfg parsing is best-effort; verify paths.")
    out.append("#  Unknown keys are ignored by the ForeB firmware parser.")
    out.append("# " + "=" * 74)
    out.append("")
    if cfg.timeout is not None:
        out.append("timeout=%d" % cfg.timeout)
    out.append("default=%s" % default_str)
    if cfg.remember_last:
        out.append("remember_last=1")
    if background:
        out.append("background=%s" % background)
    out.append("")
    emit_nodes(roots, "", out)
    if extras:
        out.append("# ---- ForeB utilities ----")
        for title, typ, icon in EXTRAS:
            out.append('menuentry "%s" {' % title)
            out.append("    type=%s" % typ)
            out.append("    icon=%s" % icon)
            out.append("}")
            out.append("")
    return "\n".join(out).rstrip("\n") + "\n"


# ===========================================================================
#  Build pipeline (shared by scan / generate / install)
# ===========================================================================
@dataclass
class BuildResult:
    cfg_text: str
    parsed: ParsedConfig
    roots: List[object]
    default_str: str
    background: Optional[str]
    wallpaper: Optional[Tuple[str, bytes]]   # (dest filename, content)
    n_entries: int
    n_submenus: int
    n_rows: int
    esp: str


def autodetect_config(esp: str) -> List[Tuple[str, str]]:
    """Configs present on the ESP, in preference order."""
    cands = [
        ("limine", os.path.join(esp, "limine.conf")),
        ("limine", os.path.join(esp, "limine.cfg")),
        ("limine", os.path.join(esp, "limine", "limine.conf")),
        ("limine", os.path.join(esp, "limine", "limine.cfg")),
        ("grub", os.path.join(esp, "grub", "grub.cfg")),
        ("systemd-boot", os.path.join(esp, "loader", "loader.conf")),
    ]
    return [(k, p) for k, p in cands if os.path.isfile(p)]


def infer_kind(path: str) -> str:
    base = os.path.basename(path).lower()
    if "limine" in base:
        return "limine"
    if "grub" in base:
        return "grub"
    if base == "loader.conf":
        return "systemd-boot"
    try:
        head = read_text(path)[:8192]
    except OSError:
        return "limine"
    if re.search(r"^\s*/+", head, re.M) or \
            re.search(r"^\s*protocol\s*:", head, re.M):
        return "limine"
    if "menuentry" in head:
        return "grub"
    return "limine"


def parse_source(kind: str, path: str, esp: str, ctx: EspContext,
                 rep: Reporter) -> ParsedConfig:
    if kind == "limine":
        return parse_limine(path, ctx, rep)
    if kind == "grub":
        return parse_grub(path, ctx, rep)
    if kind == "systemd-boot":
        esp_dir = esp
        if os.path.basename(path) == "loader.conf" and \
                os.path.basename(os.path.dirname(path)) == "loader":
            esp_dir = os.path.dirname(os.path.dirname(path))
        return parse_systemd_boot(esp_dir, path, rep)
    raise ValueError("unknown config kind %r" % kind)


def prepare_wallpaper(cfg: ParsedConfig, ctx: EspContext,
                      rep: Reporter) -> Tuple[Optional[str],
                                              Optional[Tuple[str, bytes]]]:
    """Returns (background value for forebo.cfg, (dest name, bytes) job)."""
    if not cfg.wallpaper:
        return None, None
    src = ctx.esp_file(cfg.wallpaper)
    if not os.path.isfile(src):
        rep.warn("wallpaper %r (%s) not found on the ESP; no background "
                 "will be set" % (cfg.wallpaper_raw or cfg.wallpaper, src))
        return None, None
    ext = os.path.splitext(src)[1].lower()
    dest_name = os.path.basename(cfg.wallpaper)
    try:
        with open(src, "rb") as f:
            data = f.read()
    except OSError as e:
        rep.warn("cannot read wallpaper %s: %s; no background will be set"
                 % (src, e))
        return None, None
    if ext in (".bmp", ".tga"):
        return "/forebo/" + dest_name, (dest_name, data)
    try:
        bmp = png_to_bmp(data)
    except PngError as e:
        rep.warn("wallpaper %s cannot be converted to BMP (%s); no "
                 "background will be set" % (src, e))
        return None, None
    rep.note("wallpaper %s converted to BMP" % src)
    return "/forebo/wallpaper.bmp", ("wallpaper.bmp", bmp)


def build_config(args: argparse.Namespace,
                 rep: Reporter) -> Optional[BuildResult]:
    esp = args.esp
    if not esp:
        esp = detect_esp()
        if not esp:
            die("no ESP found: none of /boot, /boot/efi, /efi is a vfat "
                "mount (use --esp PATH)")
            return None
        rep.note("auto-detected ESP at %s" % esp)
    ctx = EspContext(esp, rep)

    if args.config:
        kind = infer_kind(args.config)
        source = (kind, args.config)
        if not os.path.isfile(args.config):
            die("config file not found: %s" % args.config)
            return None
    else:
        found = autodetect_config(esp)
        if not found:
            die("no bootloader config found on %s (looked for limine.conf, "
                "limine.cfg, limine/, grub/grub.cfg, loader/loader.conf); "
                "use --config FILE" % esp)
            return None
        source = found[0]
        rep.note("using %s config: %s" % (source[0], source[1]))
        for kind, p in found[1:]:
            rep.note("also found %s config at %s (not used; --config to "
                     "override)" % (kind, p))
    if args.config:
        rep.note("using %s config: %s" % (source[0], source[1]))

    try:
        parsed = parse_source(source[0], source[1], esp, ctx, rep)
    except OSError as e:
        die("cannot read %s: %s" % (source[1], e))
        return None

    roots = cap_entries(parsed.roots, args.max_entries, rep)
    for e, _path in flatten_entries(roots):
        validate_entry(e, rep)
    default_str = resolve_default(parsed, roots, args.default_entry, rep)
    background, wallpaper_job = prepare_wallpaper(parsed, ctx, rep)
    cfg_text = emit_config(parsed, roots, default_str, background,
                           not args.no_extras)

    n_entries = len(flatten_entries(roots))
    n_submenus = count_submenus(roots)
    n_rows = n_entries + n_submenus + (len(EXTRAS) if not args.no_extras
                                       else 0)
    if n_rows > MAX_ROWS:
        rep.warn("generated config has %d menu rows; the firmware supports "
                 "at most %d - reduce entries (see --max-entries)"
                 % (n_rows, MAX_ROWS))
    return BuildResult(cfg_text=cfg_text, parsed=parsed, roots=roots,
                       default_str=default_str, background=background,
                       wallpaper=wallpaper_job, n_entries=n_entries,
                       n_submenus=n_submenus, n_rows=n_rows, esp=esp)



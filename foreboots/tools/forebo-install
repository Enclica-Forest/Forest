def _make_test_png(w: int, h: int, pixel_fn, filters: Sequence[int]) -> bytes:
    """Build a valid color-type-2 PNG; row y uses filter filters[y]."""
    stride = w * 3
    raw = bytearray()
    prev = bytearray(stride)
    for y in range(h):
        cur = bytearray()
        for x in range(w):
            cur += bytes(pixel_fn(x, y))
        f = filters[y % len(filters)]
        enc = bytearray(stride)
        for i in range(stride):
            a = cur[i - 3] if i >= 3 else 0
            b = prev[i]
            c = prev[i - 3] if i >= 3 else 0
            x = cur[i]
            if f == 0:
                e = x
            elif f == 1:
                e = (x - a) & 0xFF
            elif f == 2:
                e = (x - b) & 0xFF
            elif f == 3:
                e = (x - ((a + b) >> 1)) & 0xFF
            else:
                e = (x - paeth(a, b, c)) & 0xFF
            enc[i] = e
        raw.append(f)
        raw += enc
        prev = cur

    def chunk(typ: bytes, data: bytes) -> bytes:
        return struct.pack(">I", len(data)) + typ + data + \
            struct.pack(">I", zlib.crc32(typ + data) & 0xFFFFFFFF)

    return PNG_SIG + \
        chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0)) + \
        chunk(b"IDAT", zlib.compress(bytes(raw))) + \
        chunk(b"IEND", b"")


def cmd_selftest() -> int:
    from types import SimpleNamespace

    tests_dir = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                             "tests")
    results: List[Tuple[str, Optional[str]]] = []

    def check(name: str, fn) -> None:
        try:
            fn()
        except Exception as e:  # noqa: BLE001 - report any failure
            results.append((name, "%s: %s" % (type(e).__name__, e)))
        else:
            results.append((name, None))

    def build(kind_path: str, esp: str, **kw):
        args = SimpleNamespace(esp=esp, config=kind_path,
                               repo=os.path.dirname(tests_dir.rstrip("/")),
                               default_entry=kw.get("default_entry"),
                               max_entries=kw.get("max_entries",
                                                  DEFAULT_MAX_ENTRIES),
                               no_extras=kw.get("no_extras", False),
                               no_nvram=True, make_default=False,
                               dry_run=True, output=None,
                               verbose=kw.get("verbose", False))
        rep = Reporter(verbose=False)
        res = build_config(args, rep)
        assert res is not None, "build_config failed"
        return res, rep

    # -- 1. limine fixture tree ---------------------------------------------
    def t_limine_tree():
        with tempfile.TemporaryDirectory() as esp:
            res, _rep = build(os.path.join(tests_dir, "limine.conf"), esp)
            roots = res.roots
            assert len(roots) == 3, "expected 3 top-level nodes, got %d" \
                % len(roots)
            g0, g1, e2 = roots
            assert isinstance(g0, OutGroup) and g0.title == "CachyOS"
            names = []
            for c in g0.children:
                names.append(c.title)  # type: ignore[attr-defined]
            assert names == ["linux-cachyos", "linux-cachyos-rc-gcc",
                             "linux-cachyos-lts", "Snapshot 906",
                             "Snapshot 905"], names
            snaps = [c for c in g0.children if isinstance(c, OutGroup)]
            assert len(snaps) == 2
            assert len(snaps[0].children) == 3, "Snapshot 906 children"
            assert len(snaps[1].children) == 1, "Snapshot 905 children"
            assert isinstance(g1, OutGroup) and \
                g1.title == "Other systems and bootloaders"
            assert len(g1.children) == 1
            assert isinstance(e2, OutEntry) and e2.title == "EFI fallback"
            assert e2.type == "chainload"
    check("limine-tree", t_limine_tree)

    # -- 2. default_entry=2 -> title path -------------------------------------
    def t_default():
        with tempfile.TemporaryDirectory() as esp:
            res, _rep = build(os.path.join(tests_dir, "limine.conf"), esp)
            assert res.default_str == "CachyOS/linux-cachyos-rc-gcc", \
                res.default_str
    check("limine-default-path", t_default)

    # -- 3. generated content --------------------------------------------------
    def t_content():
        with tempfile.TemporaryDirectory() as esp:
            res, _rep = build(os.path.join(tests_dir, "limine.conf"), esp)
            cfg = res.cfg_text
            for needle in ("timeout=5", "remember_last=1",
                           "default=CachyOS/linux-cachyos-rc-gcc",
                           'submenu "CachyOS"', 'submenu "Snapshot 906"',
                           "type=linux",
                           "chain=/efi/Microsoft/Boot/bootmgfw.efi",
                           "rootflags=subvol=/@/.snapshots/906/snapshot",
                           'menuentry "ForeB Shell"',
                           'menuentry "Recovery / Disk Tools"',
                           'menuentry "Tools"',
                           'menuentry "Firmware Setup (UEFI)"',
                           'menuentry "Reboot"'):
                assert needle in cfg, "missing: " + needle
            for line in cfg.splitlines():
                if line.strip().startswith(("vmlinuz=", "initrd=",
                                            "kernel=", "module=",
                                            "chain=")):
                    assert "#" not in line, "hash left in path: " + line
            assert "_sha256_" in cfg, "_sha256_ was stripped but must stay"
            assert "vmlinuz-linux-cachyos_sha256_2c233057" in cfg
            res2, _ = build(os.path.join(tests_dir, "limine.conf"), esp,
                            no_extras=True)
            assert 'menuentry "ForeB Shell"' not in res2.cfg_text
    check("limine-content", t_content)

    # -- 4. firmware length limits ---------------------------------------------
    def t_lengths():
        with tempfile.TemporaryDirectory() as esp:
            res, _rep = build(os.path.join(tests_dir, "limine.conf"), esp)
            for line in res.cfg_text.splitlines():
                s = line.strip()
                for key in ("vmlinuz=", "initrd=", "kernel=", "module=",
                            "chain="):
                    if s.startswith(key):
                        val = s[len(key):]
                        assert len(val) <= MAX_PATH, \
                            "%s too long (%d)" % (key, len(val))
                if s.startswith('cmdline="'):
                    val = s[len('cmdline="'):].rstrip('"')
                    assert len(val) <= MAX_CMDLINE, \
                        "cmdline too long (%d)" % len(val)
    check("firmware-length-limits", t_lengths)

    # -- 5. grub fixture ---------------------------------------------------------
    def t_grub():
        with tempfile.TemporaryDirectory() as esp:
            res, _rep = build(os.path.join(tests_dir, "grub.cfg"), esp)
            entries = flatten_entries(res.roots)
            assert len(entries) == 3, "expected 3 entries, got %d" \
                % len(entries)
            assert res.n_submenus == 1, res.n_submenus
            types = [e.type for e, _p in entries]
            assert types == ["linux", "linux", "chainload"], types
            assert res.default_str == "Ubuntu 24.04 LTS", res.default_str
            assert "timeout=10" in res.cfg_text
            win = [e for e, _p in entries if e.type == "chainload"][0]
            assert win.chain == "/EFI/Microsoft/Boot/bootmgfw.efi", win.chain
            assert win.icon == "windows"
            assert entries[0][0].icon == "ubuntu"
    check("grub-fixture", t_grub)

    # -- 6. systemd-boot fixture --------------------------------------------
    def t_systemd():
        with tempfile.TemporaryDirectory() as esp:
            src = os.path.join(tests_dir, "loader")
            dst = os.path.join(esp, "loader")
            shutil.copytree(src, dst)
            res, _rep = build(os.path.join(dst, "loader.conf"), esp)
            entries = flatten_entries(res.roots)
            assert len(entries) == 3, "expected 3 entries, got %d" \
                % len(entries)
            types = [e.type for e, _p in entries]
            assert types == ["linux", "linux", "chainload"], types
            assert res.default_str == "Arch Linux", res.default_str
            assert "timeout=3" in res.cfg_text
            assert entries[1][0].icon == "arch"
            assert entries[2][0].chain == \
                "/EFI/Microsoft/Boot/bootmgfw.efi"
    check("systemd-boot-fixture", t_systemd)

    # -- 7. PNG round-trip + BMP header ----------------------------------------
    def t_png():
        w, h = 4, 5

        def px(x, y):
            return ((x * 40 + y * 7) % 256, (x * 3 + y * 50) % 256,
                    (x * 90 + y * 11) % 256)

        png = _make_test_png(w, h, px, filters=[0, 1, 2, 3, 4])
        dw, dh, rows = png_decode(png)
        assert (dw, dh) == (w, h)
        for y in range(h):
            for x in range(w):
                got = tuple(rows[y][x * 3:x * 3 + 3])
                assert got == px(x, y), "pixel(%d,%d): %r != %r" \
                    % (x, y, got, px(x, y))
        bmp = bmp_encode(dw, dh, rows)
        assert bmp[:2] == b"BM"
        fsize, = struct.unpack("<I", bmp[2:6])
        assert fsize == len(bmp)
        off, = struct.unpack("<I", bmp[10:14])
        bw, bh, planes, bpp = struct.unpack("<iiHH", bmp[18:30])
        assert (bw, bh) == (w, h) and planes == 1 and bpp == 24
        row_bytes = w * 3
        pad = (4 - row_bytes % 4) % 4
        assert len(bmp) - off == (row_bytes + pad) * h
        # BMP is bottom-up BGR: first stored pixel = bottom-left
        r, g, b = px(0, h - 1)
        assert bytes(bmp[off:off + 3]) == bytes((b, g, r))
        # unsupported input must raise PngError
        try:
            png_decode(b"not a png")
        except PngError:
            pass
        else:
            raise AssertionError("bad PNG not rejected")
    check("png-bmp-roundtrip", t_png)

    # -- 8. limine path resolution --------------------------------------------
    def t_paths():
        rep = Reporter()
        ctx = EspContext("/nonexistent-esp", rep)
        rp = lambda v: resolve_limine_path(v, ctx, rep)
        h128 = "#" + "ab" * 64
        assert rp("boot():/foo/bar" + h128) == "/foo/bar"
        assert rp("boot():/limine_history/vmlinuz-x_sha256_" + "ab" * 32
                  + h128) == \
            "/limine_history/vmlinuz-x_sha256_" + "ab" * 32
        assert rp("guid():/efi/Microsoft/Boot/bootmgfw.efi") == \
            "/efi/Microsoft/Boot/bootmgfw.efi"
        assert rp("uuid():\\EFI\\BOOT\\BOOTX64.EFI") == \
            "/EFI/BOOT/BOOTX64.EFI"
        assert rp("/plain/path") == "/plain/path"
        assert rp("no-slash-path") == "/no-slash-path"
        assert rp("hdd(1,2):/x") == "/x"
        assert any("unsupported scheme" in w for w in rep.warnings)
    check("limine-path-resolution", t_paths)

    # -- 9. icon guessing --------------------------------------------------------
    def t_icons():
        assert guess_icon("linux-cachyos vmlinuz-linux-cachyos",
                          "linux") == "arch"
        assert guess_icon("Windows Boot Manager", "chainload") == "windows"
        assert guess_icon("EFI fallback", "chainload") == "usb"
        assert guess_icon("Snapshot 906") == "safe"
        assert guess_icon("CachyOS") == "arch"
        assert guess_icon("Other systems and bootloaders") == ""
        assert guess_icon("Some Distro kernel", "linux") == "tux"
        assert guess_icon("Some app", "chainload") == "usb"
        assert guess_icon("Ubuntu 24.04 LTS ubuntu", "linux") == "ubuntu"
    check("icon-guessing", t_icons)

    # -- 10. wallpaper handling ---------------------------------------------------
    def t_wallpaper():
        with tempfile.TemporaryDirectory() as esp:
            png = _make_test_png(3, 2, lambda x, y: (x, y, x * y),
                                 filters=[0, 2])
            with open(os.path.join(esp, "limine-splash.png"), "wb") as f:
                f.write(png)
            res, _rep = build(os.path.join(tests_dir, "limine.conf"), esp)
            assert "background=/forebo/wallpaper.bmp" in res.cfg_text
            assert res.wallpaper is not None
            name, data = res.wallpaper
            assert name == "wallpaper.bmp"
            assert data[:2] == b"BM"
            bw, bh = struct.unpack("<ii", data[18:26])
            assert (bw, bh) == (3, 2)
        with tempfile.TemporaryDirectory() as esp:
            res, rep2 = build(os.path.join(tests_dir, "limine.conf"), esp)
            assert "background=" not in res.cfg_text
            assert any("wallpaper" in w for w in rep2.warnings)
    check("wallpaper", t_wallpaper)

    # -- 11. title sanitization ---------------------------------------------------
    def t_sanitize():
        assert sanitize_title('A/B "C"') == "A∕B 'C'"
        rep = Reporter()
        ctx = EspContext("/nonexistent-esp", rep)
        text = 'timeout: 1\n/a/b\n    protocol: linux\n    path: ' \
               'boot():/vmlinuz\n'
        with tempfile.TemporaryDirectory() as td:
            p = os.path.join(td, "limine.conf")
            with open(p, "w") as f:
                f.write(text)
            cfg = parse_limine(p, ctx, rep)
            assert cfg.roots and isinstance(cfg.roots[0], OutEntry)
            assert cfg.roots[0].title == "a∕b"  # type: ignore[attr-defined]
    check("title-sanitization", t_sanitize)

    # -- report ------------------------------------------------------------------
    n_fail = 0
    for name, err in results:
        if err is None:
            print("PASS %s" % name)
        else:
            print("FAIL %s: %s" % (name, err))
            n_fail += 1
    print("%d/%d tests passed" % (len(results) - n_fail, len(results)))
    return 0 if n_fail == 0 else 1


# ===========================================================================
#  CLI
# ===========================================================================
def make_parser() -> argparse.ArgumentParser:
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--esp", metavar="PATH",
                        help="ESP mount point (default: first vfat mount of "
                             "/boot, /boot/efi, /efi)")
    common.add_argument("--config", metavar="FILE",
                        help="explicit source config file (skips "
                             "auto-detection)")
    common.add_argument("--repo", metavar="DIR",
                        default=os.path.dirname(os.path.dirname(
                            os.path.abspath(__file__))),
                        help="ForeB repo root (default: parent of tools/)")
    common.add_argument("--default-entry", metavar="N", type=int,
                        help="override the default entry (1-based, counted "
                             "over bootable entries in file order)")
    common.add_argument("--max-entries", metavar="N", type=int,
                        default=DEFAULT_MAX_ENTRIES,
                        help="safety cap on translated entries (default "
                             "%(default)s; firmware max is " +
                             str(MAX_ROWS) + " rows)")
    common.add_argument("--no-extras", action="store_true",
                        help="do not append the ForeB utility entries")
    common.add_argument("-v", "--verbose", action="store_true",
                        help="also print notes")

    p = argparse.ArgumentParser(
        prog=TOOL,
        description="Translate an existing bootloader config (Limine, "
                    "GRUB, systemd-boot) into ForeB's forebo.cfg and "
                    "optionally install ForeB alongside it.",
        epilog="exit codes: 0 ok, 1 error, 2 usage")
    p.add_argument("--selftest", action="store_true",
                   help="run internal offline tests and exit")
    sub = p.add_subparsers(dest="command", metavar="COMMAND")

    sub.add_parser("scan", parents=[common],
                   help="parse the ESP configs and print a report "
                        "(read-only)")
    g = sub.add_parser("generate", parents=[common],
                       help="print the translated forebo.cfg")
    g.add_argument("--output", metavar="FILE",
                   help="write to FILE instead of stdout")
    i = sub.add_parser("install", parents=[common],
                       help="install ForeB alongside the current bootloader "
                            "(needs root)")
    i.add_argument("--no-nvram", action="store_true",
                   help="skip efibootmgr NVRAM registration")
    i.add_argument("--make-default", action="store_true",
                   help="put ForeB first in BootOrder (default: append, "
                        "keep existing order untouched)")
    i.add_argument("--dry-run", action="store_true",
                   help="print every action without doing it")
    return p


def main(argv: Optional[List[str]] = None) -> int:
    parser = make_parser()
    args = parser.parse_args(argv)
    if args.selftest:
        return cmd_selftest()
    if args.command is None:
        parser.print_help()
        return 2
    rep = Reporter(verbose=args.verbose)
    if args.command == "scan":
        return cmd_scan(args, rep)
    if args.command == "generate":
        return cmd_generate(args, rep)
    if args.command == "install":
        return cmd_install(args, rep)
    parser.print_help()
    return 2


if __name__ == "__main__":
    sys.exit(main())

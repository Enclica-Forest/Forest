def entry_summary(e: OutEntry) -> List[str]:
    lines = []
    if e.type == "linux":
        lines.append("vmlinuz=" + e.vmlinuz)
        if e.initrd:
            lines.append("initrd=" + e.initrd)
    elif e.type == "forest":
        lines.append("kernel=" + e.kernel)
        lines.extend("module=" + m for m in e.modules)
    elif e.type == "chainload":
        if e.chain:
            lines.append("chain=" + e.chain)
    if e.cmdline:
        c = e.cmdline if len(e.cmdline) <= 60 else e.cmdline[:57] + "..."
        lines.append('cmdline="%s"' % c)
    return lines


def cmd_scan(args: argparse.Namespace, rep: Reporter) -> int:
    result = build_config(args, rep)
    if result is None:
        return 1
    cfg = result.parsed
    print("ESP:           %s" % result.esp)
    print("Source config: %s (%s)" % (cfg.source_path, cfg.kind))
    print("")
    print("Entry tree:")

    def walk(nodes: Sequence[object], prefix: str) -> None:
        for i, n in enumerate(nodes):
            last = i == len(nodes) - 1
            conn = "└─ " if last else "├─ "
            cont = "   " if last else "│  "
            if isinstance(n, OutGroup):
                extra = " (icon=%s)" % n.icon if n.icon else ""
                print("%s%s[submenu] %s%s" % (prefix, conn, n.title, extra))
                walk(n.children, prefix + cont)
            else:
                assert isinstance(n, OutEntry)
                extra = " (icon=%s)" % n.icon if n.icon else ""
                print("%s%s[%s] %s%s" % (prefix, conn, n.type, n.title,
                                         extra))
                for d in entry_summary(n):
                    print("%s%s  %s" % (prefix + cont, " ", d))

    walk(result.roots, "  ")
    if not args.no_extras:
        print("  + %d ForeB utility entries (shell/recovery/tools/setup/"
              "reboot)" % len(EXTRAS))
    print("")
    print("Would emit:")
    print("  entries:   %d (+%d utility)" %
          (result.n_entries, 0 if args.no_extras else len(EXTRAS)))
    print("  submenus:  %d" % result.n_submenus)
    print("  menu rows: %d/%d" % (result.n_rows, MAX_ROWS))
    if cfg.timeout is not None:
        print("  timeout:   %d" % cfg.timeout)
    print("  default:   %s" % result.default_str)
    if cfg.remember_last:
        print("  remember_last: 1")
    if result.background:
        print("  background: %s (from %s)" %
              (result.background, cfg.wallpaper_raw or cfg.wallpaper))
    else:
        print("  background: (none)")
    if cfg.kind == "grub":
        print("")
        print("NOTE: grub.cfg parsing is best-effort; verify the result.")
    if rep.warnings:
        print("")
        print("Warnings (%d):" % len(rep.warnings))
        for w in rep.warnings:
            print("  - " + w)
    if rep.verbose and rep.notes:
        print("")
        print("Notes (%d):" % len(rep.notes))
        for n in rep.notes:
            print("  - " + n)
    return 0


def cmd_generate(args: argparse.Namespace, rep: Reporter) -> int:
    result = build_config(args, rep)
    if result is None:
        return 1
    if args.output:
        try:
            atomic_write(args.output, result.cfg_text.encode("utf-8"))
        except OSError as e:
            return die("cannot write %s: %s" % (args.output, e))
        rep.note("wrote %s" % args.output)
    else:
        sys.stdout.write(result.cfg_text)
    return 0


def safe_rel_path(rel: str) -> str:
    """Install targets must stay inside EFI/ForeB or forebo on the ESP."""
    rel = rel.replace("\\", "/").lstrip("/")
    if rel.startswith("EFI/ForeB/") or rel == "EFI/ForeB" or \
            rel.startswith("forebo/") or rel == "forebo":
        return rel
    raise ValueError("refusing to write outside EFI/ForeB and forebo/: "
                     + rel)


def cmd_install(args: argparse.Namespace, rep: Reporter) -> int:
    dry = args.dry_run
    if os.geteuid() != 0 and not dry:
        return die("install requires root - re-run with sudo "
                   "(or use --dry-run to preview the actions)")
    result = build_config(args, rep)
    if result is None:
        return 1
    esp = result.esp
    repo = args.repo
    done: List[str] = []

    def do(desc: str, fn) -> None:
        print(("%s%s" % ("[dry-run] " if dry else "", desc)))
        if not dry:
            fn()
        done.append(desc)

    def copy_file(src: str, rel_dest: str) -> None:
        rel_dest = safe_rel_path(rel_dest)
        dest = os.path.join(esp, rel_dest)

        def _copy() -> None:
            os.makedirs(os.path.dirname(dest), exist_ok=True)
            shutil.copy2(src, dest)
        do("copy %s -> %s" % (src, dest), _copy)

    def write_file(rel_dest: str, data: bytes) -> None:
        rel_dest = safe_rel_path(rel_dest)
        dest = os.path.join(esp, rel_dest)

        def _write() -> None:
            os.makedirs(os.path.dirname(dest), exist_ok=True)
            atomic_write(dest, data)
        do("write %s (%d bytes)" % (dest, len(data)), _write)

    # 1. BOOTX64.EFI
    bootx64 = os.path.join(repo, "BOOTX64.EFI")
    if not os.path.isfile(bootx64):
        if dry:
            print("[dry-run] WARNING: %s not found; build ForeB first "
                  "(make)" % bootx64)
        else:
            return die("%s not found - build ForeB first (make)" % bootx64)
    else:
        copy_file(bootx64, "EFI/ForeB/BOOTX64.EFI")

    # 2. assets
    bg = os.path.join(repo, "assets", "bg.bmp")
    if os.path.isfile(bg):
        copy_file(bg, "forebo/bg.bmp")
    else:
        rep.note("%s not found; skipping background asset" % bg)
    icons_dir = os.path.join(repo, "assets", "icons")
    if os.path.isdir(icons_dir):
        for name in sorted(os.listdir(icons_dir)):
            if name.endswith(".tga"):
                copy_file(os.path.join(icons_dir, name),
                          "forebo/icons/" + name)
    else:
        rep.note("%s not found; skipping icons" % icons_dir)

    # 3. wallpaper (converted when needed)
    if result.wallpaper is not None:
        dest_name, data = result.wallpaper  # type: ignore[misc]
        write_file("forebo/" + dest_name, data)

    # 4. forebo.cfg
    write_file("forebo/forebo.cfg", result.cfg_text.encode("utf-8"))

    # 5. NVRAM
    if args.no_nvram:
        print("%sskipping efibootmgr (--no-nvram)"
              % ("[dry-run] " if dry else ""))
    else:
        nvram_install(esp, args.make_default, dry, rep)

    # 6. summary
    print("")
    print("ForeB install summary:")
    print("  ESP:      %s" % esp)
    print("  Loader:   %s" % os.path.join(esp, "EFI/ForeB/BOOTX64.EFI"))
    print("  Config:   %s (%d entries, %d submenus, %d/%d rows)"
          % (os.path.join(esp, "forebo/forebo.cfg"), result.n_entries,
             result.n_submenus, result.n_rows, MAX_ROWS))
    print("  Assets:   %s"
          % os.path.join(esp, "forebo/bg.bmp") + ", " +
          os.path.join(esp, "forebo/icons/*.tga"))
    if result.background:
        print("  Wallpaper: %s" % os.path.join(esp,
                                                result.background.lstrip("/")))
    print("")
    print("How to boot it: pick 'ForeB' in your firmware boot menu, or "
          "select it from the UEFI boot list.")
    if args.make_default:
        print("ForeB was made the FIRST entry in the UEFI BootOrder "
              "(--make-default).")
    else:
        print("Your existing bootloader was left untouched and remains the "
              "default; the ForeB entry was appended to the boot list.")
    return 0


def nvram_install(esp: str, make_default: bool, dry: bool,
                  rep: Reporter) -> None:
    prefix = "[dry-run] " if dry else ""
    if shutil.which("efibootmgr") is None:
        rep.warn("efibootmgr not found; skipping NVRAM registration "
                 "(create the boot entry manually or install efibootmgr)")
        return

    def query() -> str:
        out = run_cmd(["efibootmgr", "-v"])
        return out or ""

    def foreb_entry(text: str) -> Optional[str]:
        for line in text.splitlines():
            m = re.match(r"^Boot([0-9A-Fa-f]{4})\*?\s+(.*)$", line)
            if not m:
                continue
            pm = re.search(r"File\(([^)]*)\)", m.group(2))
            path = pm.group(1) if pm else m.group(2)
            if "foreb" in path.lower():
                return m.group(1).upper()
        return None

    text = "" if dry else query()
    if dry:
        print(prefix + "+ efibootmgr -v   # check for an existing ForeB "
              "entry")
    num = foreb_entry(text)
    if num is not None:
        print("%sUEFI boot entry for ForeB already exists (Boot%s); "
              "skipping creation" % (prefix, num))
    else:
        out = run_cmd(["findmnt", "-no", "SOURCE", esp])
        dev = out.strip().splitlines()[0].strip() if out and out.strip() \
            else None
        disk, part = split_disk_part(dev) if dev else (None, None)
        if not disk or not part:
            rep.warn("cannot determine the ESP disk/partition for %s "
                     "(found %r); skipping NVRAM registration" % (esp, dev))
            return
        cmd = ["efibootmgr", "-c", "-d", disk, "-p", part, "-L", "ForeB",
               "-l", "\\EFI\\ForeB\\BOOTX64.EFI"]
        print(prefix + "+ " + shlex.join(cmd))
        if not dry:
            r = subprocess.run(cmd, capture_output=True, text=True)
            if r.returncode != 0:
                rep.warn("efibootmgr failed: %s" % r.stderr.strip())
                return
            num = foreb_entry(query())
            if num is None:
                rep.warn("could not find the new ForeB entry after "
                         "creation")
                return
            print("created UEFI boot entry Boot%s (ForeB)" % num)
    if make_default:
        if dry:
            print(prefix + "+ efibootmgr -o <ForeB>,<rest>   # put ForeB "
                  "first in BootOrder")
            return
        text = query()
        order: List[str] = []
        for line in text.splitlines():
            m = re.match(r"^BootOrder:\s*(.*)$", line)
            if m:
                order = [x.strip().upper() for x in m.group(1).split(",")
                         if x.strip()]
        if num is not None and order:
            new = [num] + [x for x in order if x != num]
            cmd = ["efibootmgr", "-o", ",".join(new)]
            print("+ " + shlex.join(cmd))
            r = subprocess.run(cmd, capture_output=True, text=True)
            if r.returncode != 0:
                rep.warn("efibootmgr -o failed: %s" % r.stderr.strip())
        else:
            rep.warn("cannot reorder BootOrder (entry or order unknown)")



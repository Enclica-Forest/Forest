# ─── Config parser ───────────────────────────────────────────────────────────

class ForebConfig:
    """Parsed representation of a forebo.cfg file."""

    def __init__(self):
        self.timeout: Optional[int] = None
        self.default: Optional[str] = None
        self.remember_last: Optional[bool] = None
        self.background: Optional[str] = None
        self.theme: Optional[str] = None
        self.entries: List[Dict[str, Any]] = []
        self.globals: Dict[str, str] = {}
        self._raw_lines: List[str] = []

    @classmethod
    def parse(cls, text: str) -> "ForebConfig":
        cfg = cls()
        cfg._raw_lines = text.splitlines()
        lines = cfg._raw_lines

        i = 0
        while i < len(lines):
            line = lines[i].strip()
            i += 1

            # skip comments and empty lines
            if not line or line.startswith("#"):
                continue

            # global key=value
            m = re.match(r'^(\w+)\s*=\s*(.*)', line)
            if m:
                key, val = m.group(1), m.group(2).strip()
                cfg.globals[key] = val
                if key == "timeout":
                    try: cfg.timeout = int(val)
                    except ValueError: pass
                elif key == "default":
                    cfg.default = val
                elif key == "remember_last":
                    cfg.remember_last = val == "1"
                elif key == "background":
                    cfg.background = val
                elif key == "theme":
                    cfg.theme = val
                continue

            # menuentry "title" { or submenu "title" {
            m = re.match(r'^(menuentry|submenu)\s+"([^"]*)"\s*\{', line)
            if m:
                kind = m.group(1)
                title = m.group(2)
                entry = {"_kind": kind, "title": title, "_children": []}
                # parse inner block
                depth = 1
                while i < len(lines) and depth > 0:
                    inner = lines[i].strip()
                    i += 1
                    if inner == "{":
                        depth += 1
                        continue
                    if inner == "}":
                        depth -= 1
                        continue
                    if depth == 1:
                        km = re.match(r'^(\w+)\s*=\s*(.*)', inner)
                        if km:
                            entry[km.group(1)] = km.group(2).strip()
                    elif depth == 2 and kind == "submenu":
                        # nested menuentry
                        nm = re.match(r'^menuentry\s+"([^"]*)"\s*\{', inner)
                        if nm:
                            child = {"_kind": "menuentry", "title": nm.group(1), "_children": []}
                            while i < len(lines):
                                cl = lines[i].strip()
                                i += 1
                                if cl == "}":
                                    break
                                km2 = re.match(r'^(\w+)\s*=\s*(.*)', cl)
                                if km2:
                                    child[km2.group(1)] = km2.group(2).strip()
                            entry["_children"].append(child)
                cfg.entries.append(entry)
                continue

        return cfg

    @classmethod
    def from_file(cls, path: str) -> "ForebConfig":
        with open(path, "r") as f:
            return cls.parse(f.read())

    def serialize(self) -> str:
        lines = []
        lines.append(f"# ==== ForeB configuration ====")
        lines.append(f"# Generated by forb-config")
        lines.append("")
        if self.timeout is not None:
            lines.append(f"timeout={self.timeout}")
        if self.default is not None:
            lines.append(f"default={self.default}")
        if self.remember_last is not None:
            lines.append(f"remember_last={'1' if self.remember_last else '0'}")
        if self.background:
            lines.append(f"background={self.background}")
        if self.theme:
            lines.append(f"theme={self.theme}")
        lines.append("")

        for entry in self.entries:
            kind = entry.get("_kind", "menuentry")
            title = entry.get("title", "Untitled")
            if kind == "submenu":
                lines.append(f'submenu "{title}" {{')
                for child in entry.get("_children", []):
                    self._emit_entry(lines, child, indent=1)
                lines.append("}")
            else:
                self._emit_entry(lines, entry, indent=0)
            lines.append("")

        return "\n".join(lines) + "\n"

    def _emit_entry(self, lines, entry, indent=0):
        pad = "    " * indent
        title = entry.get("title", "Untitled")
        lines.append(f'{pad}menuentry "{title}" {{')
        skip = {"_kind", "title", "_children"}
        for key, val in sorted(entry.items()):
            if key not in skip:
                lines.append(f'{pad}    {key}={val}')
        lines.append(f'{pad}}}')

    def entry_count(self) -> int:
        count = 0
        for e in self.entries:
            if e.get("_kind") == "submenu":
                count += len(e.get("_children", []))
            else:
                count += 1
        return count

    def flat_entries(self) -> List[Dict[str, Any]]:
        result = []
        for e in self.entries:
            if e.get("_kind") == "submenu":
                result.extend(e.get("_children", []))
            else:
                result.append(e)
        return result



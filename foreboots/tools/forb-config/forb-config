#!/usr/bin/env python3
"""
forb-config - ForeB bootloader configuration tool

A drop-in CLI for editing, validating, querying, and converting forebo.cfg
files. Works with any bootloader's config by translating to/from ForeB format.

Usage:
    forb-config info    <config>                  Show config summary
    forb-config validate <config> [--esp /boot]   Validate config
    forb-config get     <config> <key>            Get a setting value
    forb-config set     <config> <key> <value>    Set a setting value
    forb-config entries <config>                  List boot entries
    forb-config add     <config> [options]        Add a boot entry
    forb-config remove  <config> <index>          Remove a boot entry
    forb-config default <config> [index|title]    Get/set default entry
    forb-config timeout <config> [seconds]        Get/set timeout
    forb-config convert <input> --to <format>     Convert to another format
    forb-config detect  [/path]                   Detect installed bootloaders
    forb-config migrate <source> [--backup]       Migrate from another bootloader
    forb-config diff    <a> <b>                   Compare two configs
    forb-config themes                            List available themes
    forb-config icons                             List available icons
"""


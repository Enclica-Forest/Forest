def cmd_info(args):
    """Show config summary."""
    cfg = ForebConfig.from_file(args.config)
    entries = cfg.flat_entries()

    print(f"Config: {args.config}")
    print(f"  Timeout:     {cfg.timeout if cfg.timeout is not None else '(not set)'}")
    print(f"  Default:     {cfg.default if cfg.default else '(not set)'}")
    print(f"  Theme:       {cfg.theme if cfg.theme else '(not set)'}")
    print(f"  Background:  {cfg.background if cfg.background else '(not set)'}")
    print(f"  Entries:     {len(entries)}")

    # count by type
    types = {}
    for e in entries:
        t = e.get("type", "unknown")
        types[t] = types.get(t, 0) + 1
    for t, c in sorted(types.items()):
        print(f"    {t}: {c}")

    # submenu count
    submenus = sum(1 for e in cfg.entries if e.get("_kind") == "submenu")
    print(f"  Submenus:    {submenus}")
    print(f"  Raw lines:   {len(cfg._raw_lines)}")


def cmd_validate(args):
    """Validate a config file."""
    cfg = ForebConfig.from_file(args.config)
    entries = cfg.flat_entries()
    errors = []
    warnings = []
    infos = []

    # check entry count
    if len(entries) > 64:
        errors.append(f"Too many entries: {len(entries)} (max 64)")
    elif len(entries) > 56:
        warnings.append(f"Entry count {len(entries)} approaches limit (max 64)")

    # check each entry
    for i, e in enumerate(entries):
        title = e.get("title", "")
        etype = e.get("type", "")

        if len(title) > 63:
            warnings.append(f"Entry {i}: title '{title[:40]}...' exceeds 63 chars ({len(title)})")

        if etype not in VALID_TYPES:
            errors.append(f"Entry {i}: unknown type '{etype}'")

        # check paths
        for field in ["vmlinuz", "kernel", "chain", "initrd"]:
            val = e.get(field, "")
            if val and len(val) > 255:
                warnings.append(f"Entry {i}: {field} path exceeds 255 chars")
            if val and not val.startswith("/") and not val.startswith("\\"):
                infos.append(f"Entry {i}: {field} path '{val}' is not absolute")

        cmdline = e.get("cmdline", "")
        if len(cmdline) > 255:
            warnings.append(f"Entry {i}: cmdline exceeds 255 chars ({len(cmdline)})")

        icon = e.get("icon", "")
        if icon and icon not in ICONS and not icon.endswith((".tga", ".png", ".bmp")):
            infos.append(f"Entry {i}: icon '{icon}' not in standard icon set")

    # check duplicates
    seen = {}
    for i, e in enumerate(entries):
        key = (e.get("title", ""), e.get("vmlinuz", "") or e.get("kernel", "") or e.get("chain", ""))
        if key in seen:
            warnings.append(f"Entry {i}: duplicate of entry {seen[key]} (same title+kernel)")
        seen[key] = i

    # check ESP paths
    if args.esp:
        esp = Path(args.esp)
        for i, e in enumerate(entries):
            for field in ["vmlinuz", "kernel", "chain", "initrd"]:
                val = e.get(field, "")
                if val:
                    full = esp / val.lstrip("/")
                    if not full.exists():
                        warnings.append(f"Entry {i}: {field} '{val}' not found on ESP")

    # print results
    if errors:
        print(f"\033[31mErrors ({len(errors)}):\033[0m")
        for e in errors:
            print(f"  \033[31m✗\033[0m {e}")
    if warnings:
        print(f"\033[33mWarnings ({len(warnings)}):\033[0m")
        for w in warnings:
            print(f"  \033[33m⚠\033[0m {w}")
    if infos:
        print(f"\033[36mInfo ({len(infos)}):\033[0m")
        for i in infos:
            print(f"  \033[36mi\033[0m {i}")

    if not errors and not warnings and not infos:
        print("\033[32mConfig is valid.\033[0m")

    return 2 if errors else (1 if warnings else 0)


def cmd_get(args):
    """Get a config value."""
    cfg = ForebConfig.from_file(args.config)
    key = args.key

    # check globals
    if key in cfg.globals:
        print(cfg.globals[key])
        return

    # check first entry
    entries = cfg.flat_entries()
    if args.index is not None and 0 <= args.index < len(entries):
        val = entries[args.index].get(key, "")
        print(val)
        return

    # not found
    print(f"Key '{key}' not found", file=sys.stderr)
    return 1


def cmd_set(args):
    """Set a config value."""
    cfg = ForebConfig.from_file(args.config)
    key = args.key
    value = args.value

    # global settings
    globals_set = {"timeout", "default", "remember_last", "background", "theme"}
    if key in globals_set:
        if key == "timeout":
            try:
                cfg.timeout = int(value)
                cfg.globals["timeout"] = value
            except ValueError:
                print(f"Invalid timeout: {value}", file=sys.stderr)
                return 1
        elif key == "default":
            cfg.default = value
            cfg.globals["default"] = value
        elif key == "remember_last":
            cfg.remember_last = value in ("1", "true", "yes")
            cfg.globals["remember_last"] = "1" if cfg.remember_last else "0"
        elif key == "background":
            cfg.background = value
            cfg.globals["background"] = value
        elif key == "theme":
            if value not in THEMES:
                print(f"Unknown theme: {value}. Available: {', '.join(sorted(THEMES))}", file=sys.stderr)
                return 1
            cfg.theme = value
            cfg.globals["theme"] = value
    else:
        # entry setting
        entries = cfg.flat_entries()
        idx = args.index if args.index is not None else 0
        if idx < 0 or idx >= len(entries):
            print(f"Entry index {idx} out of range (0-{len(entries)-1})", file=sys.stderr)
            return 1
        entries[idx][key] = value

    # write back
    with open(args.config, "w") as f:
        f.write(cfg.serialize())
    print(f"Set {key}={value}")


def cmd_entries(args):
    """List boot entries."""
    cfg = ForebConfig.from_file(args.config)
    entries = cfg.flat_entries()

    if not entries:
        print("No entries found.")
        return

    print(f"{'#':>3}  {'Type':<12} {'Title':<40} {'Icon':<12} {'Kernel/Chain'}")
    print("-" * 90)
    for i, e in enumerate(entries):
        etype = e.get("type", "?")
        title = e.get("title", "?")[:40]
        icon = e.get("icon", "-")
        kernel = e.get("vmlinuz", "") or e.get("kernel", "") or e.get("chain", "")
        if kernel:
            kernel = kernel[:30]
        marker = " *" if i == 0 and cfg.default is None else ""
        print(f"{i:>3}  {etype:<12} {title:<40} {icon:<12} {kernel}{marker}")


def cmd_add(args):
    """Add a boot entry."""
    cfg = ForebConfig.from_file(args.config)

    entry = {"_kind": "menuentry", "title": args.title, "_children": []}
    if args.type:
        entry["type"] = args.type
    if args.kernel:
        if args.type == "linux":
            entry["vmlinuz"] = args.kernel
        elif args.type == "chainload":
            entry["chain"] = args.kernel
        else:
            entry["kernel"] = args.kernel
    if args.initrd:
        entry["initrd"] = args.initrd
    if args.cmdline:
        entry["cmdline"] = args.cmdline
    if args.icon:
        entry["icon"] = args.icon

    cfg.entries.append(entry)

    with open(args.config, "w") as f:
        f.write(cfg.serialize())
    print(f"Added entry '{args.title}'")


def cmd_remove(args):
    """Remove a boot entry by index."""
    cfg = ForebConfig.from_file(args.config)
    entries = cfg.flat_entries()

    if args.index < 0 or args.index >= len(entries):
        print(f"Entry index {args.index} out of range (0-{len(entries)-1})", file=sys.stderr)
        return 1

    removed = entries[args.index]
    print(f"Removing: {removed.get('title', '?')}")

    # find and remove from the tree
    for e in cfg.entries:
        if e.get("_kind") == "submenu":
            children = e.get("_children", [])
            if removed in children:
                children.remove(removed)
                break
        elif removed is e:
            cfg.entries.remove(e)
            break

    with open(args.config, "w") as f:
        f.write(cfg.serialize())
    print("Done.")


def cmd_default(args):
    """Get or set the default entry."""
    cfg = ForebConfig.from_file(args.config)

    if args.value is None:
        # get
        print(cfg.default if cfg.default else "(not set)")
        return

    # set
    cfg.default = args.value
    cfg.globals["default"] = args.value
    with open(args.config, "w") as f:
        f.write(cfg.serialize())
    print(f"Default set to: {args.value}")


def cmd_timeout(args):
    """Get or set the timeout."""
    cfg = ForebConfig.from_file(args.config)

    if args.value is None:
        # get
        print(cfg.timeout if cfg.timeout is not None else "(not set)")
        return

    # set
    try:
        val = int(args.value)
    except ValueError:
        print(f"Invalid timeout: {args.value}", file=sys.stderr)
        return 1

    cfg.timeout = val
    cfg.globals["timeout"] = str(val)
    with open(args.config, "w") as f:
        f.write(cfg.serialize())
    print(f"Timeout set to: {val}s")


def cmd_convert(args):
    """Convert between bootloader config formats."""
    input_path = Path(args.input)
    if not input_path.exists():
        print(f"File not found: {args.input}", file=sys.stderr)
        return 1

    text = input_path.read_text()
    fmt = args.format

    if fmt == "forebo" or fmt == "foreb":
        # already forebo format, just re-serialize
        cfg = ForebConfig.parse(text)
        output = cfg.serialize()
    elif fmt == "grub":
        output = _to_grub(text)
    elif fmt == "limine":
        output = _to_limine(text)
    elif fmt == "systemd-boot":
        output = _to_systemd_boot(text, args.output)
    elif fmt == "syslinux":
        output = _to_syslinux(text)
    else:
        print(f"Unknown format: {fmt}", file=sys.stderr)
        print("Supported: forebo, grub, limine, systemd-boot, syslinux", file=sys.stderr)
        return 1

    if args.output:
        Path(args.output).write_text(output)
        print(f"Converted to {fmt}: {args.output}")
    else:
        print(output)


def _to_grub(text: str) -> str:
    """Convert forebo.cfg to GRUB format."""
    cfg = ForebConfig.parse(text)
    lines = []
    lines.append("# Generated by forb-config - ForeB to GRUB conversion")
    lines.append("")
    if cfg.timeout is not None:
        lines.append(f"set timeout={cfg.timeout}")
    if cfg.default is not None:
        lines.append(f"set default={cfg.default}")
    lines.append("")

    for e in cfg.flat_entries():
        etype = e.get("type", "")
        title = e.get("title", "Untitled")
        if etype == "linux":
            lines.append(f"menuentry \"{title}\" {{")
            vmlinuz = e.get("vmlinuz", "")
            cmdline = e.get("cmdline", "")
            if vmlinuz:
                lines.append(f"    linux {vmlinuz} {cmdline}")
            initrd = e.get("initrd", "")
            if initrd:
                lines.append(f"    initrd {initrd}")
            lines.append("}")
        elif etype == "chainload":
            chain = e.get("chain", "")
            lines.append(f"menuentry \"{title}\" {{")
            if chain:
                lines.append(f"    chainloader {chain}")
            lines.append("}")
        elif etype == "forest":
            kernel = e.get("kernel", "")
            lines.append(f"menuentry \"{title}\" {{")
            if kernel:
                lines.append(f"    multiboot {kernel}")
            for mod in e.get("modules", "").split():
                lines.append(f"    module {mod}")
            lines.append("}")
        else:
            lines.append(f"menuentry \"{title}\" {{}}")
        lines.append("")

    return "\n".join(lines)


def _to_limine(text: str) -> str:
    """Convert forebo.cfg to Limine format."""
    cfg = ForebConfig.parse(text)
    lines = []
    lines.append("# Generated by forb-config - ForeB to Limine conversion")
    lines.append("")
    if cfg.timeout is not None:
        lines.append(f"TIMEOUT={cfg.timeout}")
    lines.append("")

    for e in cfg.flat_entries():
        etype = e.get("type", "")
        title = e.get("title", "Untitled")
        lines.append(f":{title}")
        if etype == "linux":
            lines.append("    PROTOCOL=linux")
            vmlinuz = e.get("vmlinuz", "")
            if vmlinuz:
                lines.append(f"    KERNEL_PATH=boot():/{vmlinuz.lstrip('/')}")
            initrd = e.get("initrd", "")
            if initrd:
                lines.append(f"    MODULE_PATH=boot():/{initrd.lstrip('/')}")
            cmdline = e.get("cmdline", "")
            if cmdline:
                lines.append(f"    CMDLINE={cmdline}")
        elif etype == "chainload":
            chain = e.get("chain", "")
            lines.append("    PROTOCOL=efi_chainload")
            if chain:
                lines.append(f"    PATH=boot():/{chain.lstrip('/')}")
        elif etype == "forest":
            kernel = e.get("kernel", "")
            lines.append("    PROTOCOL=multiboot1")
            if kernel:
                lines.append(f"    KERNEL_PATH=boot():/{kernel.lstrip('/')}")
        lines.append("")

    return "\n".join(lines)


def _to_systemd_boot(text: str, output_dir: Optional[str] = None) -> str:
    """Convert forebo.cfg to systemd-boot format (creates multiple files)."""
    cfg = ForebConfig.parse(text)
    entries = cfg.flat_entries()

    if output_dir:
        outdir = Path(output_dir)
        outdir.mkdir(parents=True, exist_ok=True)

    lines = []
    for i, e in enumerate(entries):
        etype = e.get("type", "")
        title = e.get("title", "Untitled")
        filename = f"{title.lower().replace(' ', '-')}.conf"

        entry_lines = []
        entry_lines.append(f"title {title}")
        if etype == "linux":
            vmlinuz = e.get("vmlinuz", "")
            if vmlinuz:
                entry_lines.append(f"linux /{vmlinuz.lstrip('/')}")
            initrd = e.get("initrd", "")
            if initrd:
                entry_lines.append(f"initrd /{initrd.lstrip('/')}")
            cmdline = e.get("cmdline", "")
            if cmdline:
                entry_lines.append(f"options {cmdline}")
        elif etype == "chainload":
            chain = e.get("chain", "")
            if chain:
                entry_lines.append(f"efi /{chain.lstrip('/')}")
        elif etype == "forest":
            kernel = e.get("kernel", "")
            if kernel:
                entry_lines.append(f"linux /{kernel.lstrip('/')}")
                entry_lines.append("options multiboot")

        content = "\n".join(entry_lines) + "\n"
        if output_dir:
            (outdir / filename).write_text(content)
            lines.append(f"  Created: {filename}")
        else:
            lines.append(f"# --- {filename} ---")
            lines.append(content)

    # create loader.conf
    if output_dir:
        loader_conf = "# Generated by forb-config\n"
        if cfg.timeout is not None:
            loader_conf += f"timeout {cfg.timeout}\n"
        (outdir / "loader.conf").write_text(loader_conf)
        lines.insert(0, f"  Created: loader.conf")

    return "\n".join(lines)


def _to_syslinux(text: str) -> str:
    """Convert forebo.cfg to syslinux format."""
    cfg = ForebConfig.parse(text)
    lines = []
    lines.append("# Generated by forb-config - ForeB to syslinux conversion")
    lines.append("")
    if cfg.timeout is not None:
        lines.append(f"TIMEOUT {cfg.timeout * 10}")  # syslinux uses 10ths
    lines.append("")

    for e in cfg.flat_entries():
        etype = e.get("type", "")
        title = e.get("title", "Untitled")
        lines.append(f"LABEL {title.lower().replace(' ', '-')}")
        lines.append(f"    MENU LABEL {title}")
        if etype == "linux":
            vmlinuz = e.get("vmlinuz", "")
            if vmlinuz:
                lines.append(f"    LINUX /{vmlinuz.lstrip('/')}")
            initrd = e.get("initrd", "")
            if initrd:
                lines.append(f"    INITRD /{initrd.lstrip('/')}")
            cmdline = e.get("cmdline", "")
            if cmdline:
                lines.append(f"    APPEND {cmdline}")
        elif etype == "chainload":
            chain = e.get("chain", "")
            if chain:
                if chain.endswith(".efi"):
                    lines.append(f"    COM32 chain.c32")
                    lines.append(f"    APPEND fs")
                else:
                    lines.append(f"    LOCALBOOT 0")
        lines.append("")

    return "\n".join(lines)


def cmd_detect(args):
    """Detect installed bootloaders."""
    search_paths = [
        args.path if args.path else "/boot/efi",
        "/boot",
        "/efi",
    ]

    detected = []
    for base in search_paths:
        b = Path(base)
        if not b.exists():
            continue

        checks = [
            ("ForeB", "EFI/forb/BOOTX64.EFI", "EFI/forb/forebo.cfg"),
            ("GRUB", "grub/grub.cfg", None),
            ("GRUB (EFI)", "EFI/grub/grub.cfg", None),
            ("Limine", "limine.conf", None),
            ("Limine (EFI)", "EFI/limine/limine.conf", None),
            ("systemd-boot", "loader/loader.conf", None),
            ("rEFInd", "EFI/refind/refind.conf", None),
            ("Clover", "EFI/CLOVER/config.plist", None),
            ("syslinux", "syslinux/syslinux.cfg", None),
            ("Windows Boot Manager", "EFI/Microsoft/Boot/bootmgfw.efi", None),
        ]

        for name, efi_path, cfg_path in checks:
            full = b / efi_path
            if full.exists():
                info = {"name": name, "efi": str(full)}
                if cfg_path:
                    cfg_full = b / cfg_path
                    if cfg_full.exists():
                        info["config"] = str(cfg_full)
                        try:
                            text = cfg_full.read_text()
                            info["lines"] = len(text.splitlines())
                        except:
                            pass
                detected.append(info)

    if not detected:
        print("No bootloaders detected.")
        return

    print(f"{'Bootloader':<25} {'EFI Binary':<50} {'Config'}")
    print("-" * 120)
    for d in detected:
        print(f"{d['name']:<25} {d.get('efi', '-'):<50} {d.get('config', '-')}")


def cmd_migrate(args):
    """Migrate from another bootloader."""
    source = Path(args.source) if args.source else Path("/boot/efi")
    if not source.exists():
        print(f"Source path not found: {args.source}", file=sys.stderr)
        return 1

    # detect source bootloader
    print(f"Scanning {source}...")

    grub_cfg = None
    limine_cfg = None
    systemd_cfg = None

    for p in [
        source / "grub/grub.cfg",
        source / "EFI/grub/grub.cfg",
    ]:
        if p.exists():
            grub_cfg = p
            break

    for p in [
        source / "limine.conf",
        source / "EFI/limine/limine.conf",
    ]:
        if p.exists():
            limine_cfg = p
            break

    systemd_cfg = source / "loader/loader.conf"
    if not systemd_cfg.exists():
        systemd_cfg = None

    if grub_cfg:
        print(f"Detected GRUB: {grub_cfg}")
        print("GRUB migration is best-effort. Complex GRUB features may not translate.")
        # TODO: use forb-install's parser
        print("Use: forb-install migrate --source {} --backup".format(source))
    elif limine_cfg:
        print(f"Detected Limine: {limine_cfg}")
        print("Use: forb-install migrate --source {} --backup".format(source))
    elif systemd_cfg:
        print(f"Detected systemd-boot: {systemd_cfg}")
        print("Use: forb-install migrate --source {} --backup".format(source))
    else:
        print("No known bootloader config found.")
        print("Searched for: grub.cfg, limine.conf, loader.conf")
        return 1


def cmd_diff(args):
    """Compare two configs."""
    a = ForebConfig.from_file(args.config_a)
    b = ForebConfig.from_file(args.config_b)

    a_entries = a.flat_entries()
    b_entries = b.flat_entries()

    a_titles = {e.get("title", ""): e for e in a_entries}
    b_titles = {e.get("title", ""): e for e in b_entries}

    added = [t for t in b_titles if t not in a_titles]
    removed = [t for t in a_titles if t not in b_titles]
    common = [t for t in a_titles if t in b_titles]

    modified = []
    for t in common:
        ae, be = a_titles[t], b_titles[t]
        diffs = []
        for key in set(list(ae.keys()) + list(be.keys())):
            if key.startswith("_"):
                continue
            av = ae.get(key, "")
            bv = be.get(key, "")
            if av != bv:
                diffs.append((key, av, bv))
        if diffs:
            modified.append((t, diffs))

    # globals diff
    g_diffs = []
    for key in set(list(a.globals.keys()) + list(b.globals.keys())):
        av = a.globals.get(key, "(unset)")
        bv = b.globals.get(key, "(unset)")
        if av != bv:
            g_diffs.append((key, av, bv))

    if g_diffs:
        print("\033[36mGlobal settings:\033[0m")
        for key, av, bv in g_diffs:
            print(f"  {key}: {av} -> {bv}")

    if added:
        print(f"\n\033[32mAdded ({len(added)}):\033[0m")
        for t in added:
            print(f"  + {t}")

    if removed:
        print(f"\n\033[31mRemoved ({len(removed)}):\033[0m")
        for t in removed:
            print(f"  - {t}")

    if modified:
        print(f"\n\033[33mModified ({len(modified)}):\033[0m")
        for title, diffs in modified:
            print(f"  ~ {title}")
            for key, av, bv in diffs:
                print(f"      {key}: {av!r} -> {bv!r}")

    if not added and not removed and not modified and not g_diffs:
        print("\033[32mConfigs are identical.\033[0m")



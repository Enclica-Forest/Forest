# ─── CLI ─────────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(
        prog="forb-config",
        description="ForeB bootloader configuration tool",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  forb-config info boot/forebo.cfg
  forb-config validate boot/forebo.cfg --esp /boot/efi
  forb-config entries boot/forebo.cfg
  forb-config set boot/forebo.cfg timeout 5
  forb-config add boot/forebo.cfg --title "My Linux" --type linux --kernel /boot/vmlinuz
  forb-config convert grub.cfg --to forebo
  forb-config diff old.cfg new.cfg
  forb-config themes
"""
    )

    sub = parser.add_subparsers(dest="command", help="Command")

    # info
    p = sub.add_parser("info", help="Show config summary")
    p.add_argument("config", help="Path to forebo.cfg")

    # validate
    p = sub.add_parser("validate", help="Validate config")
    p.add_argument("config", help="Path to forebo.cfg")
    p.add_argument("--esp", help="ESP mount point for file existence checks")

    # get
    p = sub.add_parser("get", help="Get a setting value")
    p.add_argument("config", help="Path to forebo.cfg")
    p.add_argument("key", help="Setting key")
    p.add_argument("--index", type=int, help="Entry index (for entry-specific keys)")

    # set
    p = sub.add_parser("set", help="Set a setting value")
    p.add_argument("config", help="Path to forebo.cfg")
    p.add_argument("key", help="Setting key")
    p.add_argument("value", help="New value")
    p.add_argument("--index", type=int, help="Entry index (for entry-specific keys)")

    # entries
    p = sub.add_parser("entries", help="List boot entries")
    p.add_argument("config", help="Path to forebo.cfg")

    # add
    p = sub.add_parser("add", help="Add a boot entry")
    p.add_argument("config", help="Path to forebo.cfg")
    p.add_argument("--title", required=True, help="Entry title")
    p.add_argument("--type", choices=VALID_TYPES, help="Entry type")
    p.add_argument("--kernel", help="Kernel/initrd/chain path")
    p.add_argument("--initrd", help="Initrd path")
    p.add_argument("--cmdline", help="Kernel command line")
    p.add_argument("--icon", help="Icon name")

    # remove
    p = sub.add_parser("remove", help="Remove a boot entry")
    p.add_argument("config", help="Path to forebo.cfg")
    p.add_argument("index", type=int, help="Entry index")

    # default
    p = sub.add_parser("default", help="Get/set default entry")
    p.add_argument("config", help="Path to forebo.cfg")
    p.add_argument("value", nargs="?", help="New default (index or title)")

    # timeout
    p = sub.add_parser("timeout", help="Get/set timeout")
    p.add_argument("config", help="Path to forebo.cfg")
    p.add_argument("value", nargs="?", help="New timeout in seconds")

    # convert
    p = sub.add_parser("convert", help="Convert between formats")
    p.add_argument("input", help="Input config file")
    p.add_argument("--to", dest="format", required=True,
                    choices=["forebo", "foreb", "grub", "limine", "systemd-boot", "syslinux"],
                    help="Output format")
    p.add_argument("--output", "-o", help="Output file (omit for stdout)")

    # detect
    p = sub.add_parser("detect", help="Detect installed bootloaders")
    p.add_argument("path", nargs="?", help="Path to scan (default: /boot/efi)")

    # migrate
    p = sub.add_parser("migrate", help="Migrate from another bootloader")
    p.add_argument("source", nargs="?", help="Source path (default: /boot/efi)")
    p.add_argument("--backup", action="store_true", help="Backup existing config")

    # diff
    p = sub.add_parser("diff", help="Compare two configs")
    p.add_argument("config_a", help="First config")
    p.add_argument("config_b", help="Second config")

    # themes
    sub.add_parser("themes", help="List available themes")

    # icons
    sub.add_parser("icons", help="List available icons")

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        return 1

    cmds = {
        "info": cmd_info,
        "validate": cmd_validate,
        "get": cmd_get,
        "set": cmd_set,
        "entries": cmd_entries,
        "add": cmd_add,
        "remove": cmd_remove,
        "default": cmd_default,
        "timeout": cmd_timeout,
        "convert": cmd_convert,
        "detect": cmd_detect,
        "migrate": cmd_migrate,
        "diff": cmd_diff,
        "themes": cmd_themes,
        "icons": cmd_icons,
    }

    return cmds[args.command](args) or 0


if __name__ == "__main__":
    sys.exit(main())

    return GRAPHICS_SUCCESS;
}

static graphics_result_t vesa_v2_blend_frames_impl(graphics_device_t* dev, const framebuffer_t* fb1,
                                                const framebuffer_t* fb2, uint32_t alpha_256) {
    if (!dev || !fb1 || !fb2 || !dev->current_fb) {
        return GRAPHICS_ERROR_INVALID_PARAMETER;
    }
    
    // Simple alpha blending between two frames
    if (fb1->width != fb2->width || fb1->height != fb2->height ||
        fb1->format != fb2->format) {
        return GRAPHICS_ERROR_INVALID_PARAMETER;
    }
    
    // Ensure destination matches source dimensions
    if (fb1->width != dev->current_fb->width || fb1->height != dev->current_fb->height) {
        return GRAPHICS_ERROR_INVALID_PARAMETER;
    }
    
    uint8_t* dst = (uint8_t*)dev->current_fb->virtual_addr;
    const uint8_t* src1 = (const uint8_t*)fb1->virtual_addr;
    const uint8_t* src2 = (const uint8_t*)fb2->virtual_addr;
    
    size_t pixel_count = fb1->size / (fb1->bpp / 8);
    
    if (fb1->format == PIXEL_FORMAT_RGB_888) {
        for (size_t i = 0; i < pixel_count * 3; i += 3) {
            uint32_t inv_alpha_256 = 256 - alpha_256;
            dst[i] = (uint8_t)(src1[i] * inv_alpha_256 / 256 + src2[i] * alpha_256 / 256);
            dst[i + 1] = (uint8_t)(src1[i + 1] * inv_alpha_256 / 256 + src2[i + 1] * alpha_256 / 256);
            dst[i + 2] = (uint8_t)(src1[i + 2] * inv_alpha_256 / 256 + src2[i + 2] * alpha_256 / 256);
        }
    }
    
    return GRAPHICS_SUCCESS;
}

static graphics_result_t vesa_v2_get_v2_capabilities(graphics_device_t* dev, graphics_driver_v2_caps_t* caps) {
    if (!dev || !caps) {
        return GRAPHICS_ERROR_INVALID_PARAMETER;
    }
    
    memset(caps, 0, sizeof(graphics_driver_v2_caps_t));
    
    // VESA supports most v2 features
    caps->base_caps = dev->caps;
    caps->supports_mode_switching = true;
    caps->supports_state_preservation = true;
    caps->supports_offscreen_buffers = true;
    caps->supports_hardware_context_switching = false;  // VESA is software
    caps->supports_framebuffer_compression = false;
    
    caps->max_contexts = 8;  // Reasonable limit for VESA
    caps->context_switch_time_us = 1000;  // 1ms estimate
    caps->supports_atomic_switches = false;
    
    caps->max_offscreen_memory = 64 * 1024 * 1024;  // 64MB limit
    caps->supports_memory_mapping = true;
    caps->supports_dma_transfers = false;
    
    caps->supports_dpms = false;
    caps->supports_dynamic_refresh = false;
    caps->power_state_switch_time_ms = 100;
    
    return GRAPHICS_SUCCESS;
}

static graphics_result_t vesa_v2_get_context_info(graphics_device_t* dev, uint32_t context_id, 
                                                 display_context_t** info) {
    if (!dev || !info) {
        return GRAPHICS_ERROR_INVALID_PARAMETER;
    }
    
    // This would need to track created contexts
    // For now, return not implemented
    (void)context_id;
    *info = NULL;
    return GRAPHICS_ERROR_NOT_SUPPORTED;
}

static graphics_result_t vesa_v2_get_performance_stats(graphics_device_t* dev, 
                                                     struct graphics_performance_stats* stats) {
    if (!dev || !stats) {
        return GRAPHICS_ERROR_INVALID_PARAMETER;
    }
    
    // Return placeholder statistics
    memset(stats, 0, sizeof(struct graphics_performance_stats));
    stats->context_switches = 0;
    stats->total_switch_time_us = 0;
    stats->frame_count = 0;
    stats->total_frame_time_us = 0;
    stats->memory_usage_bytes = dev->current_fb ? dev->current_fb->size : 0;
    stats->offscreen_buffers_count = 0;
    stats->failed_operations = 0;
    stats->last_error_time = 0;
    
    return GRAPHICS_SUCCESS;
}

static graphics_result_t vesa_v2_validate_context(graphics_device_t* dev, const display_context_t* ctx) {
    if (!dev || !ctx) {
        return GRAPHICS_ERROR_INVALID_PARAMETER;
    }
    
    // Basic validation
    if (ctx->context_id == 0 || ctx->name[0] == '\0') {
        return GRAPHICS_ERROR_INVALID_PARAMETER;
    }
    
    return GRAPHICS_SUCCESS;
}

static graphics_result_t vesa_v2_dump_state(graphics_device_t* dev, char* buffer, uint32_t buffer_size) {
    if (!dev || !buffer || buffer_size == 0) {
        return GRAPHICS_ERROR_INVALID_PARAMETER;
    }
    
    // Simple state dump - just copy a static string
    copy_string_with_newline(buffer, "VESA v2 Driver State", buffer_size);
    
    return GRAPHICS_SUCCESS;
}

// VESA v2 driver definition
static graphics_driver_v2_t vesa_v2_driver = {
    .version_major = 2,
    .version_minor = 0,
    .driver_name = "VESA_V2",
    
    .init = vesa_v2_init,
    .shutdown = vesa_v2_shutdown,
    .set_mode = NULL,  // Use existing VESA implementation
    .get_mode = NULL,   // Use existing VESA implementation
    .enumerate_modes = NULL,  // Use existing VESA implementation
    
    .preserve_display = vesa_v2_preserve_display,
    .restore_display = vesa_v2_restore_display,
    .create_context = vesa_v2_create_context,
    .destroy_context = vesa_v2_destroy_context,
    .switch_context = vesa_v2_switch_context,
    
    .create_offscreen_fb = vesa_v2_create_offscreen_fb,
    .destroy_offscreen_fb = vesa_v2_destroy_offscreen_fb,
    .blit_offscreen_to_main = vesa_v2_blit_offscreen_to_main,
    
    .save_hardware_state = vesa_v2_save_hardware_state,
    .restore_hardware_state = vesa_v2_restore_hardware_state,
    .reset_hardware_state = vesa_v2_reset_hardware_state,
    
    .fade_to_black = vesa_v2_fade_to_black,
    .fade_from_black = vesa_v2_fade_from_black,
    .blend_frames = NULL, // Disabled due to type compatibility issue
    
    .set_power_state = NULL,  // Not implemented for VESA
    .get_power_state = NULL,  // Not implemented for VESA
    
    .get_v2_capabilities = vesa_v2_get_v2_capabilities,
    .get_context_info = vesa_v2_get_context_info,
    .get_performance_stats = vesa_v2_get_performance_stats,
    .validate_context = vesa_v2_validate_context,
    .dump_state = vesa_v2_dump_state
};

graphics_result_t graphics_driver_v2_init(void) {
    spinlock_init(&g_driver_registry_lock, "v2_driver_registry");
    
    // Register VESA v2 driver as example
    return graphics_driver_v2_register(&vesa_v2_driver);
}

graphics_result_t graphics_driver_v2_shutdown(void) {
    if (g_num_registered_drivers > 0) {
        for (uint32_t i = 0; i < g_num_registered_drivers; i++) {
            if (g_registered_drivers[i]) {
                kfree(g_registered_drivers[i]);
                g_registered_drivers[i] = NULL;
            }
        }
        g_num_registered_drivers = 0;
    }
    
    return GRAPHICS_SUCCESS;
}

const char* graphics_driver_v2_error_string(graphics_result_t result) {
    switch (result) {
        case GRAPHICS_SUCCESS: return "Success";
        case GRAPHICS_ERROR_GENERIC: return "Generic Error";
        case GRAPHICS_ERROR_INVALID_MODE: return "Invalid Mode";
        case GRAPHICS_ERROR_HARDWARE_FAULT: return "Hardware Fault";
        case GRAPHICS_ERROR_OUT_OF_MEMORY: return "Out of Memory";
        case GRAPHICS_ERROR_NOT_SUPPORTED: return "Not Supported";
        case GRAPHICS_ERROR_DEVICE_BUSY: return "Device Busy";
        case GRAPHICS_ERROR_INVALID_PARAMETER: return "Invalid Parameter";
        default: return "Unknown Error";
    }
}

uint32_t graphics_driver_v2_estimate_context_size(const graphics_driver_v2_caps_t* caps) {
    if (!caps) {
        return 0;
    }
    
    // Estimate based on capabilities
    uint32_t base_size = sizeof(display_context_t);
    uint32_t fb_size = 1920 * 1080 * 4;  // Assume 1080p 32-bit as baseline
    uint32_t hw_state_size = 4096;  // 4KB for hardware state
    
    return base_size + fb_size + hw_state_size;
}

bool graphics_driver_v2_supports_mode(const graphics_driver_v2_t* driver, display_mode_t mode) {
    if (!driver) {
        return false;
    }
    
    // Check if driver supports the required operations for the mode
    switch (mode) {
        case DISPLAY_MODE_TTY_CONSOLE:
            return (driver->preserve_display && driver->restore_display);
            
        case DISPLAY_MODE_CANOPY_DESKTOP:
            return (driver->create_offscreen_fb && driver->blit_offscreen_to_main &&
                    driver->fade_to_black && driver->fade_from_black);
            
        case DISPLAY_MODE_FULLSCREEN_APP:
            return (driver->create_context && driver->switch_context);
            
        default:
            return false;
    }
}
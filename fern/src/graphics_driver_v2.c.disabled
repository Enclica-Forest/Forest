#define GFP_KERNEL 0x01

// Manual string copy to avoid sprintf
static void copy_string_with_newline(char* dest, const char* src, uint32_t max_len) {
    uint32_t i = 0;
    while (src[i] && i < max_len - 1) {
        dest[i] = src[i];
        i++;
    }
    if (i < max_len - 1) {
        dest[i++] = '\n';
        dest[i] = '\0';
    } else {
        dest[max_len - 1] = '\0';
    }
}

// Driver registry
static graphics_driver_v2_t* g_registered_drivers[16] = {0};
static uint32_t g_num_registered_drivers = 0;
static spinlock_t g_driver_registry_lock;

graphics_result_t graphics_driver_v2_register(const graphics_driver_v2_t* driver) {
    if (!driver || !driver->driver_name) {
        return GRAPHICS_ERROR_INVALID_PARAMETER;
    }
    
    spin_lock(&g_driver_registry_lock);
    
    if (g_num_registered_drivers >= 16) {
        spin_unlock(&g_driver_registry_lock);
        return GRAPHICS_ERROR_OUT_OF_MEMORY;
    }
    
    // Check for duplicate
    for (uint32_t i = 0; i < g_num_registered_drivers; i++) {
        if (g_registered_drivers[i] && 
            strcmp(g_registered_drivers[i]->driver_name, driver->driver_name) == 0) {
            spin_unlock(&g_driver_registry_lock);
            return GRAPHICS_ERROR_DEVICE_BUSY;
        }
    }
    
    // Copy driver structure
    graphics_driver_v2_t* driver_copy = kmalloc(sizeof(graphics_driver_v2_t));
    if (!driver_copy) {
        spin_unlock(&g_driver_registry_lock);
        return GRAPHICS_ERROR_OUT_OF_MEMORY;
    }
    
    memcpy(driver_copy, driver, sizeof(graphics_driver_v2_t));
    g_registered_drivers[g_num_registered_drivers] = driver_copy;
    g_num_registered_drivers++;
    
    debuglog_printf("Registered v2 graphics driver: %s (v%d.%d)\n", 
                   driver->driver_name, driver->version_major, driver->version_minor);
    
    spin_unlock(&g_driver_registry_lock);
    return GRAPHICS_SUCCESS;
}

graphics_result_t graphics_driver_v2_unregister(const char* driver_name) {
    if (!driver_name) {
        return GRAPHICS_ERROR_INVALID_PARAMETER;
    }
    
    spin_lock(&g_driver_registry_lock);
    
    for (uint32_t i = 0; i < g_num_registered_drivers; i++) {
        if (g_registered_drivers[i] && 
            strcmp(g_registered_drivers[i]->driver_name, driver_name) == 0) {
            
            kfree(g_registered_drivers[i]);
            g_registered_drivers[i] = NULL;
            
            // Compact the array
            for (uint32_t j = i; j < g_num_registered_drivers - 1; j++) {
                g_registered_drivers[j] = g_registered_drivers[j + 1];
            }
            g_registered_drivers[g_num_registered_drivers - 1] = NULL;
            g_num_registered_drivers--;
            
            debuglog_printf("Unregistered v2 graphics driver: %s\n", driver_name);
            
            spin_unlock(&g_driver_registry_lock);
            return GRAPHICS_SUCCESS;
        }
    }
    
    spin_unlock(&g_driver_registry_lock);
    return GRAPHICS_ERROR_INVALID_PARAMETER;
}

graphics_result_t graphics_driver_v2_get_driver(const char* name, graphics_driver_v2_t** driver) {
    if (!name || !driver) {
        return GRAPHICS_ERROR_INVALID_PARAMETER;
    }
    
    spin_lock(&g_driver_registry_lock);
    
    for (uint32_t i = 0; i < g_num_registered_drivers; i++) {
        if (g_registered_drivers[i] && 
            strcmp(g_registered_drivers[i]->driver_name, name) == 0) {
            *driver = g_registered_drivers[i];
            spin_unlock(&g_driver_registry_lock);
            return GRAPHICS_SUCCESS;
        }
    }
    
    *driver = NULL;
    spin_unlock(&g_driver_registry_lock);
    return GRAPHICS_ERROR_INVALID_PARAMETER;
}

// VESA/VBE driver implementation as example v2 driver
static graphics_result_t vesa_v2_init(graphics_device_t* dev) {
    debuglog_printf("VESA v2 driver init for device %04x:%04x\n", 
                   dev->vendor_id, dev->device_id);
    
    // Call original VESA init if available
    // This would integrate with existing VESA driver
    
    dev->is_active = true;
    return GRAPHICS_SUCCESS;
}

static graphics_result_t vesa_v2_shutdown(graphics_device_t* dev) {
    debuglog_printf("VESA v2 driver shutdown for device %04x:%04x\n", 
                   dev->vendor_id, dev->device_id);
    
    dev->is_active = false;
    return GRAPHICS_SUCCESS;
}

static graphics_result_t vesa_v2_preserve_display(graphics_device_t* dev, display_context_t* ctx) {
    if (!dev || !ctx || !dev->current_fb) {
        return GRAPHICS_ERROR_INVALID_PARAMETER;
    }
    
    debuglog_printf("VESA v2 preserving display for context %d\n", ctx->context_id);
    
    // Save framebuffer content
    if (!ctx->saved_framebuffer_data) {
        ctx->saved_framebuffer_data = kmalloc(dev->current_fb->size);
        if (!ctx->saved_framebuffer_data) {
            return GRAPHICS_ERROR_OUT_OF_MEMORY;
        }
        ctx->saved_data_size = dev->current_fb->size;
    }
    
    memcpy(ctx->saved_framebuffer_data, (void*)dev->current_fb->virtual_addr, dev->current_fb->size);
    
    return GRAPHICS_SUCCESS;
}

static graphics_result_t vesa_v2_restore_display(graphics_device_t* dev, const display_context_t* ctx) {
    if (!dev || !ctx || !dev->current_fb) {
        return GRAPHICS_ERROR_INVALID_PARAMETER;
    }
    
    if (!ctx->saved_framebuffer_data) {
        return GRAPHICS_ERROR_INVALID_PARAMETER;
    }
    
    debuglog_printf("VESA v2 restoring display for context %d\n", ctx->context_id);
    
    // Restore framebuffer content
    memcpy((void*)dev->current_fb->virtual_addr, ctx->saved_framebuffer_data, 
           ctx->saved_data_size);
    
    return GRAPHICS_SUCCESS;
}

static graphics_result_t vesa_v2_create_context(graphics_device_t* dev, display_context_t** ctx, 
                                             display_mode_t mode) {
    if (!dev || !ctx) {
        return GRAPHICS_ERROR_INVALID_PARAMETER;
    }
    
    display_context_t* context = kmalloc(sizeof(display_context_t));
    if (!context) {
        return GRAPHICS_ERROR_OUT_OF_MEMORY;
    }
    
    memset(context, 0, sizeof(display_context_t));
    context->context_id = (uint32_t)(uintptr_t)context;  // Use pointer as ID for now
    context->mode = mode;
    // Manual string construction for context name
    copy_string_with_newline(context->name, "VESA_Context_", sizeof(context->name));
    context->framebuffer = dev->current_fb;
    context->is_active = false;
    context->is_dirty = false;
    
    *ctx = context;
    
    debuglog_printf("VESA v2 created context %d for mode %d\n", 
                   context->context_id, mode);
    return GRAPHICS_SUCCESS;
}

static graphics_result_t vesa_v2_destroy_context(graphics_device_t* dev, display_context_t* ctx) {
    if (!dev || !ctx) {
        return GRAPHICS_ERROR_INVALID_PARAMETER;
    }
    
    debuglog_printf("VESA v2 destroying context %d\n", ctx->context_id);
    
    if (ctx->saved_framebuffer_data) {
        kfree(ctx->saved_framebuffer_data);
    }
    
    if (ctx->hardware_context) {
        kfree(ctx->hardware_context);
    }
    
    kfree(ctx);
    return GRAPHICS_SUCCESS;
}

static graphics_result_t vesa_v2_switch_context(graphics_device_t* dev, uint32_t context_id) {
    if (!dev) {
        return GRAPHICS_ERROR_INVALID_PARAMETER;
    }
    
    debuglog_printf("VESA v2 switching to context %d\n", context_id);
    
    // For VESA, context switching is mainly about restoring saved state
    // The actual display switching is handled by the display manager
    
    return GRAPHICS_SUCCESS;
}

static graphics_result_t vesa_v2_create_offscreen_fb(graphics_device_t* dev, framebuffer_t** fb, 
                                                   uint32_t width, uint32_t height, 
                                                   pixel_format_t format) {
    if (!dev || !fb) {
        return GRAPHICS_ERROR_INVALID_PARAMETER;
    }
    
    // Create offscreen framebuffer
    *fb = kmalloc(sizeof(framebuffer_t));
    if (!*fb) {
        return GRAPHICS_ERROR_OUT_OF_MEMORY;
    }
    
    // Calculate size and allocate memory
    uint32_t bpp = (format == PIXEL_FORMAT_RGBA_8888 || format == PIXEL_FORMAT_BGRA_8888) ? 32 :
                   (format == PIXEL_FORMAT_RGB_888 || format == PIXEL_FORMAT_BGR_888) ? 24 :
                   (format == PIXEL_FORMAT_RGB_565) ? 16 : 8;
    
    uint32_t pitch = (width * bpp + 7) / 8;
    size_t fb_size = pitch * height;
    
    void* fb_memory = kmalloc(fb_size);
    if (!fb_memory) {
        kfree(*fb);
        *fb = NULL;
        return GRAPHICS_ERROR_OUT_OF_MEMORY;
    }
    
    // Initialize framebuffer
    memset(*fb, 0, sizeof(framebuffer_t));
    (*fb)->virtual_addr = (uintptr_t)fb_memory;
    (*fb)->physical_addr = (uintptr_t)fb_memory;
    (*fb)->size = fb_size;
    (*fb)->width = width;
    (*fb)->height = height;
    (*fb)->pitch = pitch;
    (*fb)->format = format;
    (*fb)->bpp = bpp;
    (*fb)->double_buffered = false;
    (*fb)->hw_cursor_available = false;
    
    debuglog_printf("VESA v2 created offscreen framebuffer %dx%d\n", width, height);
    return GRAPHICS_SUCCESS;
}

static graphics_result_t vesa_v2_destroy_offscreen_fb(graphics_device_t* dev, framebuffer_t* fb) {
    if (!dev || !fb) {
        return GRAPHICS_ERROR_INVALID_PARAMETER;
    }
    
    if (fb->virtual_addr) {
        kfree((void*)fb->virtual_addr);
    }
    
    kfree(fb);
    return GRAPHICS_SUCCESS;
}

static graphics_result_t vesa_v2_blit_offscreen_to_main(graphics_device_t* dev, const framebuffer_t* src, 
                                                      const graphics_rect_t* src_rect, 
                                                      const graphics_rect_t* dst_rect) {
    if (!dev || !src || !src_rect || !dst_rect) {
        return GRAPHICS_ERROR_INVALID_PARAMETER;
    }
    
    // Bitblit implementation using memcpy for row-wise copying
    // This provides efficient memory transfer for software rendering
    
    uint32_t src_x = src_rect->x;
    uint32_t src_y = src_rect->y;
    uint32_t dst_x = dst_rect->x;
    uint32_t dst_y = dst_rect->y;
    uint32_t width = src_rect->width;
    uint32_t height = src_rect->height;
    
    // Clamp to destination bounds
    if (dst_x + width > dev->current_fb->width) {
        width = dev->current_fb->width - dst_x;
    }
    if (dst_y + height > dev->current_fb->height) {
        height = dev->current_fb->height - dst_y;
    }
    
    if (width == 0 || height == 0) {
        return GRAPHICS_SUCCESS;
    }
    
    // Copy pixel data (assuming same format for simplicity)
    uint8_t* src_ptr = (uint8_t*)src->virtual_addr + src_y * src->pitch + src_x * (src->bpp / 8);
    uint8_t* dst_ptr = (uint8_t*)dev->current_fb->virtual_addr + dst_y * dev->current_fb->pitch + dst_x * (dev->current_fb->bpp / 8);
    
    for (uint32_t y = 0; y < height; y++) {
        memcpy(dst_ptr, src_ptr, width * (src->bpp / 8));
        src_ptr += src->pitch;
        dst_ptr += dev->current_fb->pitch;
    }
    
    return GRAPHICS_SUCCESS;
}

// VESA hardware state structure
struct vesa_hw_state {
    uint32_t current_mode;
    uint32_t palette[256];
    uint8_t seq_regs[5];
    uint8_t crt_regs[25];
    uint8_t gfx_regs[9];
    uint8_t attr_regs[21];
};

static graphics_result_t vesa_v2_save_hardware_state(graphics_device_t* dev, void** state_data, uint32_t* size) {
    if (!dev || !state_data || !size) {
        return GRAPHICS_ERROR_INVALID_PARAMETER;
    }
    
    // For VESA, we need to save minimal hardware state
    struct vesa_hw_state* hw_state;
    
    hw_state = kmalloc(sizeof(struct vesa_hw_state));
    if (!hw_state) {
        return GRAPHICS_ERROR_OUT_OF_MEMORY;
    }
    
    // Save current mode information
        hw_state->current_mode = (uint32_t)dev->current_mode.mode_number;
    
    // Save palette (for indexed modes)
    if (dev->current_mode.format == PIXEL_FORMAT_INDEXED_8) {
        // Read VGA palette registers
        for (int i = 0; i < 256; i++) {
            // This would involve reading VGA DAC registers
            hw_state->palette[i] = i;  // Placeholder
        }
    }
    
    // Save VGA registers
    // This would involve reading actual VGA registers
    memset(hw_state->seq_regs, 0, sizeof(hw_state->seq_regs));
    memset(hw_state->crt_regs, 0, sizeof(hw_state->crt_regs));
    memset(hw_state->gfx_regs, 0, sizeof(hw_state->gfx_regs));
    memset(hw_state->attr_regs, 0, sizeof(hw_state->attr_regs));
    
    *state_data = hw_state;
    *size = sizeof(struct vesa_hw_state);
    
    debuglog_printf("VESA v2 saved hardware state (%u bytes)\n", *size);
    return GRAPHICS_SUCCESS;
}


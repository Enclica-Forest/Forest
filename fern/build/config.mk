# Force every undefined boolean to `no`. A defined-but-non-yes/no value is
# left as-is (the feature fragments gate strictly on `yes`/`no`, so a stray
# value behaves like `no`). This guarantees no option is ever undefined。
$(foreach o,$(ALL_BOOL_OPTIONS),$(if $(filter undefined,$(origin $(o))),$(eval $(o) := no)))

# ROOT_AUTOLOGIN is also a boolean (handled explicitly by the main Makefile as
# -DENABLE_ROOT_AUTOLOGIN); ensure it has a value even if somehow dropped from
# the master list above.
ifeq ($(origin ROOT_AUTOLOGIN),undefined)
ROOT_AUTOLOGIN := no
endif

# -----------------------------------------------------------------------------
# 5. FEATURE_FLAGS fallback
# -----------------------------------------------------------------------------
# conf.sh --generate emits FEATURE_FLAGS listing every `feature`-class option
# that is set to `yes`. If build-config.mk is missing (or stale), fall back to
# an empty list — feature fragments do NOT rely on FEATURE_FLAGS for gating,
# they gate on $(ENABLE_X),yes directly.
ifeq ($(origin FEATURE_FLAGS),undefined)
FEATURE_FLAGS :=
endif

# -----------------------------------------------------------------------------
# 6. Numeric tunables — `?=` defaults (overridden by build-config.mk)
# -----------------------------------------------------------------------------
VFS_MAX_PATH                 ?= 256
VFS_MAX_OPEN_FILES           ?= 256
VFS_MAX_MOUNTS               ?= 16
DISPLAY_DEFAULT_WIDTH        ?= 1024
DISPLAY_DEFAULT_HEIGHT       ?= 768
DISPLAY_DEFAULT_BPP          ?= 32
NET_MAX_SOCKETS               ?= 16
TCP_MAX_CONNECTIONS          ?= 16
TCP_WINDOW_SIZE              ?= 8192
AUDIO_MAX_STREAMS             ?= 8
AUDIO_RING_BUFFER_SIZE        ?= 32768
AUDIO_DEFAULT_SAMPLE_RATE    ?= 44100
SECURITY_AUTH_MAX_USERS      ?= 16
SECURITY_AUTH_MAX_GROUPS     ?= 8
SECURITY_MAX_TTY_SESSIONS    ?= 22
USB_MAX_CONTROLLERS          ?= 8
USB_MAX_DEVICES              ?= 128
MAX_BLOCK_DEVICES            ?= 64
IPC_MAX_CHANNELS             ?= 32
POSIX_SHM_MAX_OBJECTS        ?= 64
PIT_DEFAULT_FREQUENCY        ?= 1000
DEBUG_LOG_LEVEL              ?= 3
MAX_STACK_FRAMES              ?= 32
PANIC_MAX_STACK_FRAMES       ?= 16
SERIAL_BAUD_RATE              ?= 38400
TTY_MAX_VIRTUAL_TTYS         ?= 64
INTERRUPT_MAX_NESTING_DEPTH  ?= 8
SCHED_PRIORITY_LEVELS        ?= 8
MAX_PROCESSES                ?= 4096
USER_STACK_PAGES              ?= 32
MAX_PIPES                    ?= 16
MAX_PTYS                     ?= 16
KERNEL_HEAP_INITIAL_SIZE      ?= 4194304
KERNEL_HEAP_MAX_SIZE          ?= 134217728
KERNEL_STACK_SIZE             ?= 16384

# Integer options that arrive via build-config.mk (QEMU_MEMORY,
# BUILD_PARALLEL_JOBS, PARALLEL_JOBS) are not given a `?=` here to avoid
# shadowing the generated values; build-config.mk always emits them. Provide
# safe fallbacks only if undefined.
QEMU_MEMORY          ?= 512
BUILD_PARALLEL_JOBS  ?= 0

# -----------------------------------------------------------------------------
# 7. configcheck helper (internal — wired to the `configcheck` phony by the
#    main Makefile). Prints effective core choices and counts enabled feature
#    booleans.
# -----------------------------------------------------------------------------
.PHONY: configcheck-internal
configcheck-internal:
	@echo "===== Forest-OS effective build configuration ====="
	@echo "ARCH       = $(ARCH)"
	@echo "BOOT_MODE  = $(BOOT_MODE)"
	@echo "BUILD_TYPE = $(BUILD_TYPE)"
	@echo "PARALLEL_JOBS = $(PARALLEL_JOBS)"
	@echo "ROOT_AUTOLOGIN = $(ROOT_AUTOLOGIN)"
	@echo "build-config.mk present: $(if $(wildcard build-config.mk),yes,no)"
	@echo "FEATURE_FLAGS = $(FEATURE_FLAGS)"
	@echo "----- enabled feature booleans -----"
	@$(foreach o,$(ALL_BOOL_OPTIONS),$(if $(filter yes,$($(o))),echo "  $(o) = yes";))
	@echo "----- enabled feature count -----"
	@echo "  $(words $(foreach o,$(ALL_BOOL_OPTIONS),$(if $(filter yes,$($(o))),x))) / $(words $(ALL_BOOL_OPTIONS))"

# End of build/config.mk

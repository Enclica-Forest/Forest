# =============================================================================
# build/config.mk — Build configuration loader & validator
# =============================================================================
# This is the FIRST include pulled in by the main Makefile. It:
#   1. Loads build-config.mk (generated by conf.sh --generate).
#   2. Falls back to safe defaults when build-config.mk is absent.
#   3. Validates ARCH / BOOT_MODE / BUILD_TYPE.
#   4. Guarantees every boolean feature option is `yes` or `no`.
#   5. Provides numeric tunable defaults (override-able by build-config.mk).
# Including this file must NEVER error if build-config.mk is missing.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Load generated configuration
# -----------------------------------------------------------------------------
ifeq ($(wildcard build-config.mk),)
$(info WARNING: build-config.mk not found.)
$(info WARNING: Run './conf.sh --generate' (or './conf.sh --defconfig && ./conf.sh --generate') to create it.)
$(info WARNING: Proceeding with safe defaults — the build will use defaults, not your .forestos_config.)
endif
-include build-config.mk

# -----------------------------------------------------------------------------
# 2. Core defaults (only applied if build-config.mk did not set them)
# -----------------------------------------------------------------------------
ARCH           ?= 32
BOOT_MODE      ?= bios
BUILD_TYPE     ?= debug
PARALLEL_JOBS  ?= 0

# -----------------------------------------------------------------------------
# 3. Validation of choice options
# -----------------------------------------------------------------------------
VALID_ARCHS       := 32 64 arm aarch64 riscv64
VALID_BOOT_MODES  := bios uefi
VALID_BUILD_TYPES := debug release optimize

ifeq ($(filter $(ARCH),$(VALID_ARCHS)),)
$(error Invalid ARCH='$(ARCH)'. Valid values: $(VALID_ARCHS))
endif

ifeq ($(filter $(BOOT_MODE),$(VALID_BOOT_MODES)),)
$(error Invalid BOOT_MODE='$(BOOT_MODE)'. Valid values: $(VALID_BOOT_MODES))
endif

ifeq ($(filter $(BUILD_TYPE),$(VALID_BUILD_TYPES)),)
$(error Invalid BUILD_TYPE='$(BUILD_TYPE)'. Valid values: $(VALID_BUILD_TYPES))
endif


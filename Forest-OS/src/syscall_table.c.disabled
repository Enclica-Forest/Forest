#define SYSCALL_TABLE_SIZE (sizeof(syscall_table) / sizeof(syscall_table[0]))

// Static syscall statistics
static struct {
    uint32 call_count;
    uint32 error_count;
    uint32 last_syscall;
    uint32 last_error;
} syscall_stats = {0, 0, 0, 0};

// Initialize syscall table and validation
void syscall_table_init(void) {
    debuglog(DEBUG_INFO, "Forest OS syscall table initialized with %d entries\n", (int)SYSCALL_TABLE_SIZE);
    debuglog(DEBUG_INFO, "Syscall dispatch mechanism: function pointer table\n");
}

// Efficient syscall dispatch using function pointer table
int32 syscall_dispatch(uint32 num, uint32 arg1, uint32 arg2, uint32 arg3, uint32 arg4, uint32 arg5, uint32 arg6) {
    syscall_stats.call_count++;
    syscall_stats.last_syscall = num;
    
    // Bounds check
    if (num >= SYSCALL_TABLE_SIZE) {
        syscall_stats.error_count++;
        syscall_stats.last_error = num;
        return -38; // -ENOSYS
    }
    
    const syscall_desc_t *desc = &syscall_table[num];
    
    // Dispatch based on argument count for efficiency
    switch (desc->arg_count) {
        case 0:
            return desc->func.fn0();
        case 1:
            return desc->func.fn1(arg1);
        case 2:
            return desc->func.fn2(arg1, arg2);
        case 3:
            return desc->func.fn3(arg1, arg2, arg3);
        case 4:
            return desc->func.fn4(arg1, arg2, arg3, arg4);
        case 5:
            return desc->func.fn5(arg1, arg2, arg3, arg4, arg5);
        case 6:
            return desc->func.fn6(arg1, arg2, arg3, arg4, arg5, arg6);
        default:
            syscall_stats.error_count++;
            syscall_stats.last_error = num;
            return -38; // -ENOSYS
    }
}

// Get syscall name for debugging
const char* syscall_get_name(uint32 num) {
    if (num >= SYSCALL_TABLE_SIZE) {
        return "unknown";
    }
    return syscall_table[num].name;
}

// Validate syscall number
bool syscall_is_valid(uint32 num) {
    return num < SYSCALL_TABLE_SIZE;
}

// Print syscall statistics
void syscall_stats_print(void) {
    debuglog(DEBUG_INFO, "=== Forest OS Syscall Statistics ===\n");
    debuglog(DEBUG_INFO, "Total syscalls: %u\n", syscall_stats.call_count);
    debuglog(DEBUG_INFO, "Total errors: %u\n", syscall_stats.error_count);
    debuglog(DEBUG_INFO, "Success rate: %u%%\n", 
               syscall_stats.call_count ? 
               ((syscall_stats.call_count - syscall_stats.error_count) * 100) / syscall_stats.call_count : 100);
    debuglog(DEBUG_INFO, "Last syscall: %u (%s)\n", syscall_stats.last_syscall, 
               syscall_get_name(syscall_stats.last_syscall));
    if (syscall_stats.error_count > 0) {
        debuglog(DEBUG_INFO, "Last error: %u (%s)\n", syscall_stats.last_error,
                   syscall_get_name(syscall_stats.last_error));
    }
}
// Optimized syscall dispatch using function pointer table
int32 syscall_dispatch_optimized(uint32 num, uint32 arg1, uint32 arg2, uint32 arg3, uint32 arg4, uint32 arg5, uint32 arg6) {
    // Bounds check
    if (num >= sizeof(syscall_table) / sizeof(syscall_table[0])) {
        return -38; // -ENOSYS
    }
    
    const syscall_entry_t *entry = &syscall_table[num];
    
    // Debug logging for critical syscalls
    #ifdef DEBUG_SYSCALLS
    if (num < 100) { // Only log basic syscalls to avoid spam
        debuglog(DEBUG_DETAIL, "syscall: %s(%u, %u, %u, %u, %u, %u)\n", 
                   entry->name, arg1, arg2, arg3, arg4, arg5, arg6);
    }
    #endif
    
    // Call the appropriate function based on argument count
    switch (entry->arg_count) {
        case 0: return ((int32(*)(void))entry->func)();
        case 1: return ((int32(*)(uint32))entry->func)(arg1);
        case 2: return ((int32(*)(uint32, uint32))entry->func)(arg1, arg2);
        case 3: return ((int32(*)(uint32, uint32, uint32))entry->func)(arg1, arg2, arg3);
        case 4: return ((int32(*)(uint32, uint32, uint32, uint32))entry->func)(arg1, arg2, arg3, arg4);
        case 5: return ((int32(*)(uint32, uint32, uint32, uint32, uint32))entry->func)(arg1, arg2, arg3, arg4, arg5);
        case 6: return ((int32(*)(uint32, uint32, uint32, uint32, uint32, uint32))entry->func)(arg1, arg2, arg3, arg4, arg5, arg6);
        default: return -38; // -ENOSYS
    }
}

// Initialize the dispatcher
void syscall_dispatcher_init(void) {
    debuglog(DEBUG_INFO, "Forest OS optimized syscall dispatcher initialized\n");
    debuglog(DEBUG_INFO, "Supporting %d system calls\n", (int)(sizeof(syscall_table) / sizeof(syscall_table[0])));
    
    // Mark that the dispatcher is ready
    // This will replace the switch-based dispatcher in syscall_handle()
}
/*
 * syscall_dispatcher.c - Optimized syscall dispatcher for Forest OS
 */

#include "include/syscall.h"
#include "include/types.h"
#include "include/string.h"
#include "include/debuglog.h"

// Optimized dispatch using function pointer table
typedef struct {
    int32 (*func)(uint32, uint32, uint32, uint32, uint32, uint32);
    const char *name;
    uint8 arg_count;
} syscall_entry_t;


// Stub function for unimplemented syscalls
static int32 sys_stub(uint32 a1, uint32 a2, uint32 a3, uint32 a4, uint32 a5, uint32 a6) {
    (void)a1; (void)a2; (void)a3; (void)a4; (void)a5; (void)a6;
    return -38; // -ENOSYS
}


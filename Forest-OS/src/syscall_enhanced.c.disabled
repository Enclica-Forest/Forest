        if (oldpath[i] == '\0' || newpath[i] == '\0') break;
    }
    oldpath[255] = '\0';
    newpath[255] = '\0';
    
    // No symbolic link support
    return -38; // ENOSYS
}

int32 sys_readlink(uint32 path_ptr, uint32 buf_ptr, uint32 bufsiz) {
    char path[256];
    
    if (!user_buffer_readable(path_ptr, 256) ||
        !user_buffer_writable(buf_ptr, bufsiz)) {
        return -14; // EFAULT
    }
    
    // Copy string safely
    for (int i = 0; i < 255; i++) {
        path[i] = *((char*)path_ptr + i);
        if (path[i] == '\0') break;
    }
    path[255] = '\0';
    
    // No symbolic link support
    return -22; // EINVAL
}

int32 sys_chmod(uint32 pathname, uint32 mode) {
    char path[256];
    
    if (!user_buffer_readable(pathname, 256)) {
        return -14; // EFAULT
    }
    
    // Copy string safely
    for (int i = 0; i < 255; i++) {
        path[i] = *((char*)pathname + i);
        if (path[i] == '\0') break;
    }
    path[255] = '\0';
    
    (void)mode; // Permissions not supported
    
    // Pretend success for compatibility
    return 0;
}

int32 sys_fchmod(uint32 fd, uint32 mode) {
    (void)fd; (void)mode; // Permissions not supported
    
    // Pretend success for compatibility
    return 0;
}

int32 sys_chown(uint32 pathname, uint32 owner, uint32 group) {
    char path[256];
    
    if (!user_buffer_readable(pathname, 256)) {
        return -14; // EFAULT
    }
    
    // Copy string safely
    for (int i = 0; i < 255; i++) {
        path[i] = *((char*)pathname + i);
        if (path[i] == '\0') break;
    }
    path[255] = '\0';
    
    (void)owner; (void)group; // Ownership not supported
    
    // Pretend success for compatibility
    return 0;
}

int32 sys_fchown(uint32 fd, uint32 owner, uint32 group) {
    (void)fd; (void)owner; (void)group; // Ownership not supported
    
    // Pretend success for compatibility
    return 0;
}

int32 sys_lchown(uint32 pathname, uint32 owner, uint32 group) {
    // Same as chown (no symlinks)
    return sys_chown(pathname, owner, group);
}

static uint32 current_umask = 022; // Default umask

int32 sys_umask(uint32 mask) {
    uint32 old_mask = current_umask;
    current_umask = mask & 0777; // Only permission bits
    return old_mask;
}

// Vectorized I/O
int32 sys_readv(uint32 fd, uint32 iov_ptr, uint32 iovcnt) {
    if (!user_buffer_readable(iov_ptr, iovcnt * 8)) {
        return -14; // EFAULT
    }
    
    // Simple implementation - read sequentially
    int32 total_read = 0;
    for (uint32 i = 0; i < iovcnt; i++) {
        uint32 iov_base = *((uint32*)(iov_ptr + i * 8));
        uint32 iov_len = *((uint32*)(iov_ptr + i * 8 + 4));
        
        int32 result = sys_read(fd, iov_base, iov_len);
        if (result < 0) {
            return result;
        }
        total_read += result;
        
        if (result < (int32)iov_len) {
            break; // Partial read
        }
    }
    
    return total_read;
}

int32 sys_writev(uint32 fd, uint32 iov_ptr, uint32 iovcnt) {
    if (!user_buffer_readable(iov_ptr, iovcnt * 8)) {
        return -14; // EFAULT
    }
    
    // Simple implementation - write sequentially
    int32 total_written = 0;
    for (uint32 i = 0; i < iovcnt; i++) {
        uint32 iov_base = *((uint32*)(iov_ptr + i * 8));
        uint32 iov_len = *((uint32*)(iov_ptr + i * 8 + 4));
        
        int32 result = sys_write(fd, iov_base, iov_len);
        if (result < 0) {
            return result;
        }
        total_written += result;
        
        if (result < (int32)iov_len) {
            break; // Partial write
        }
    }
    
    return total_written;
}

int32 sys_pread64(uint32 fd, uint32 buf, uint32 count, uint32 offset) {
    // Simple implementation - seek then read
    int32 saved_pos = sys_lseek(fd, 0, 1); // SEEK_CUR
    if (saved_pos < 0) {
        return saved_pos;
    }
    
    int32 result = sys_lseek(fd, offset, 0); // SEEK_SET
    if (result < 0) {
        return result;
    }
    
    int32 read_result = sys_read(fd, buf, count);
    
    // Restore position
    sys_lseek(fd, saved_pos, 0); // SEEK_SET
    
    return read_result;
}

int32 sys_pwrite64(uint32 fd, uint32 buf, uint32 count, uint32 offset) {
    // Simple implementation - seek then write
    int32 saved_pos = sys_lseek(fd, 0, 1); // SEEK_CUR
    if (saved_pos < 0) {
        return saved_pos;
    }
    
    int32 result = sys_lseek(fd, offset, 0); // SEEK_SET
    if (result < 0) {
        return result;
    }
    
    int32 write_result = sys_write(fd, buf, count);
    
    // Restore position
    sys_lseek(fd, saved_pos, 0); // SEEK_SET
    
    return write_result;
}

// File synchronization
int32 sys_fsync(uint32 fd) {
    (void)fd; // Write-through filesystem, no-op
    
    return 0; // Success
}

int32 sys_fdatasync(uint32 fd) {
    (void)fd; // Same as fsync for our filesystem
    
    return 0; // Success
}

int32 sys_ftruncate(uint32 fd, uint32 length) {
    (void)fd; (void)length; // Read-only filesystem
    
    return -1; // EPERM
}

// User/group management
int32 sys_setuid(uint32 uid) {
    task_t* task = current_task;
    if (!task) {
        return -22; // EINVAL
    }
    
    // Only allow setting to current UID or root
    if (uid != task->uid && task->uid != 0) {
        return -1; // EPERM
    }
    
    task->uid = uid;
    return 0;
}

int32 sys_setgid(uint32 gid) {
    task_t* task = current_task;
    if (!task) {
        return -22; // EINVAL
    }
    
    // Only allow setting to current GID or root
    if (gid != task->gid && task->gid != 0) {
        return -1; // EPERM
    }
    
    task->gid = gid;
    return 0;
}

int32 sys_seteuid(uint32 euid) {
    // For simplicity, set UID = EUID
    return sys_setuid(euid);
}

int32 sys_setegid(uint32 egid) {
    // For simplicity, set GID = EGID
    return sys_setgid(egid);
}

int32 sys_setreuid(uint32 ruid, uint32 euid) {
    // For simplicity, set to EUID
    return sys_seteuid(euid);
}

int32 sys_setregid(uint32 rgid, uint32 egid) {
    // For simplicity, set to EGID
    return sys_setegid(egid);
}


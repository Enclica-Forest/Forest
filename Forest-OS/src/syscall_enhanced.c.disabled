// Enhanced implementations
int32 sys_getpid(void) {
    task_t* task = current_task;
    return task ? task->id : -22; // EINVAL
}

int32 sys_getppid(void) {
    task_t* task = current_task;
    return task ? 0 : -22; // Return 0 for init's parent
}

int32 sys_getuid(void) {
    task_t* task = current_task;
    return task ? task->uid : -22;
}

int32 sys_getgid(void) {
    task_t* task = current_task;
    return task ? task->gid : -22;
}

int32 sys_geteuid(void) {
    return sys_getuid(); // Same as UID in Forest OS
}

int32 sys_getegid(void) {
    return sys_getgid(); // Same as GID in Forest OS
}

int32 sys_stat(uint32 pathname, uint32 statbuf) {
    // Enhanced stat with better validation
    if (!user_buffer_readable(pathname, 256) || !user_buffer_writable(statbuf, sizeof(uint32) * 20)) {
        return -14; // EFAULT
    }
    
    // Use existing VFS stat implementation
    // This is a placeholder - the actual implementation is in syscall.c
    return -38; // ENOSYS for now
}

int32 sys_fstat(uint32 fd, uint32 statbuf) {
    // Enhanced fstat with validation
    if (!user_buffer_writable(statbuf, sizeof(uint32) * 20)) {
        return -14; // EFAULT
    }
    
    // Use existing VFS fstat implementation  
    return -38; // ENOSYS for now
}

int32 sys_unlink(uint32 pathname) {
    if (!user_buffer_readable(pathname, 256)) {
        return -14; // EFAULT
    }
    
    // Read-only filesystem - return EPERM
    return -1; // EPERM
}

int32 sys_mknod(uint32 pathname, uint32 mode, uint32 dev) {
    if (!user_buffer_readable(pathname, 256)) {
        return -14; // EFAULT
    }
    
    // Enhanced mknod with proper validation
    // Use existing implementation
    return -38; // ENOSYS for now
}

int32 sys_kill(uint32 pid, uint32 sig) {
    task_t* current = current_task;
    if (!current) {
        return -22; // EINVAL
    }
    
    // Only support killing current task for now
    if (pid != 0 && pid != current->id) {
        return -3; // ESRCH
    }
    
    // Only support SIGKILL (9) and SIGTERM (15)
    if (sig == 9 || sig == 15) {
        current->state = 0; // TASK_STATE_ZOMBIE
        current->exit_code = sig;
        return 0; // Success
    }
    
    return -38; // ENOSYS for other signals
}

int32 sys_wait4(uint32 pid, uint32 status_ptr, uint32 options, uint32 rusage_ptr) {
    (void)pid; (void)status_ptr; (void)options; (void)rusage_ptr;
    
    // Enhanced wait4 - no child process support yet
    return -10; // ECHILD
}

int32 sys_waitpid(uint32 pid, uint32 status_ptr, uint32 options) {
    return sys_wait4(pid, status_ptr, options, 0);
}

int32 sys_select(uint32 nfds, uint32 readfds_ptr, uint32 writefds_ptr, uint32 exceptfds_ptr, uint32 timeout_ptr) {
    // Validate all user buffers
    if (!user_buffer_writable(readfds_ptr, nfds/8) ||
        !user_buffer_writable(writefds_ptr, nfds/8) ||
        !user_buffer_writable(exceptfds_ptr, nfds/8) ||
        (timeout_ptr && !user_buffer_readable(timeout_ptr, 8))) {
        return -14; // EFAULT
    }
    
    // Simple implementation - always timeout
    return 0; // No fds ready
}

int32 sys_ppoll(uint32 fds_ptr, uint32 nfds, uint32 timeout_ptr, uint32 sigmask_ptr) {
    (void)sigmask_ptr; // Signal mask not supported
    
    // Extract timeout from timespec
    uint32 timeout_ms = 0;
    if (timeout_ptr && user_buffer_readable(timeout_ptr, 8)) {
        uint32 tv_sec = *((uint32*)timeout_ptr);
        uint32 tv_nsec = *((uint32*)(timeout_ptr + 4));
        timeout_ms = tv_sec * 1000 + tv_nsec / 1000000;
    }
    
    return sys_poll(fds_ptr, nfds, timeout_ms);
}

int32 sys_pipe2(uint32 pipefd_ptr, uint32 flags) {
    (void)flags; // Flags not supported yet
    
    if (!user_buffer_writable(pipefd_ptr, 8)) {
        return -14; // EFAULT
    }
    
    return sys_pipe(pipefd_ptr);
}

int32 sys_getcwd(uint32 buf_ptr, uint32 size) {
    if (!user_buffer_writable(buf_ptr, size)) {
        return -14; // EFAULT
    }
    
    if (size < 2) {
        return -38; // ENAMETOOLONG (too small)
    }
    
    // Forest OS always returns "/"
    *((char*)buf_ptr) = '/';
    if (size > 1) {
        *((char*)(buf_ptr + 1)) = '\0';
    }
    
    return 2; // Length of "/"
}

int32 sys_chdir(uint32 pathname) {
    char path[256];
    
    if (!user_buffer_readable(pathname, 256)) {
        return -14; // EFAULT
    }
    
    // Copy string safely
    for (int i = 0; i < 255; i++) {
        path[i] = *((char*)pathname + i);
        if (path[i] == '\0') break;
    }
    path[255] = '\0';
    
    // Only root directory exists in Forest OS
    if (strcmp(path, "/") != 0) {
        return -2; // ENOENT
    }
    
    return 0; // Success
}

int32 sys_fchdir(uint32 fd) {
    (void)fd;
    // Directory file descriptors not supported in Forest OS
    return -38; // ENOSYS
}

int32 sys_rename(uint32 oldpath_ptr, uint32 newpath_ptr) {
    char oldpath[256], newpath[256];
    
    if (!user_buffer_readable(oldpath_ptr, 256) ||
        !user_buffer_readable(newpath_ptr, 256)) {
        return -14; // EFAULT
    }
    
    // Copy strings safely
    for (int i = 0; i < 255; i++) {
        oldpath[i] = *((char*)oldpath_ptr + i);
        newpath[i] = *((char*)newpath_ptr + i);
        if (oldpath[i] == '\0' || newpath[i] == '\0') break;
    }
    oldpath[255] = '\0';
    newpath[255] = '\0';
    
    // Read-only filesystem
    return -1; // EPERM
}

int32 sys_mkdir(uint32 pathname, uint32 mode) {
    char path[256];
    
    if (!user_buffer_readable(pathname, 256)) {
        return -14; // EFAULT
    }
    
    // Copy string safely
    for (int i = 0; i < 255; i++) {
        path[i] = *((char*)pathname + i);
        if (path[i] == '\0') break;
    }
    path[255] = '\0';
    
    (void)mode; // Permissions not supported
    
    // Read-only filesystem
    return -1; // EPERM
}

int32 sys_rmdir(uint32 pathname) {
    char path[256];
    
    if (!user_buffer_readable(pathname, 256)) {
        return -14; // EFAULT
    }
    
    // Copy string safely
    for (int i = 0; i < 255; i++) {
        path[i] = *((char*)pathname + i);
        if (path[i] == '\0') break;
    }
    path[255] = '\0';
    
    // Read-only filesystem
    return -1; // EPERM
}

int32 sys_creat(uint32 pathname, uint32 mode) {
    // creat() = open(pathname, O_CREAT|O_WRONLY|O_TRUNC)
    return sys_open(pathname, 64 | 1 | 512, mode);
}


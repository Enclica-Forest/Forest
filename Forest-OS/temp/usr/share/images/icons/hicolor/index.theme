[Icon Theme]
Name=hicolor
Comment=Forest OS Freedesktop fallback icon theme
Hidden=true
Directories=scalable/apps,scalable/actions,scalable/devices,scalable/filesystems,scalable/mimetypes

[scalable/apps]

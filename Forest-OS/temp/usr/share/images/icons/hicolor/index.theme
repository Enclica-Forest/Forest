MinSize=16
MaxSize=256
Context=Actions

[scalable/devices]
Size=48
Type=Scalable
MinSize=16
MaxSize=256
Context=Devices

[scalable/filesystems]
Size=48
Type=Scalable
MinSize=16
MaxSize=256
Context=FileSystems

[scalable/mimetypes]

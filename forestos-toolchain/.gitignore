# Forest-OS toolchain package — track SOURCE only (scripts, patches,
# sysroot-skeleton, checksums, README). Everything below is build output or
# multi-GB downloads and must never be committed (GitHub rejects >100MB files;
# the prebuilt gcc is several GB).

# Build trees, logs, install prefix
/build/
/install/

# Legacy per-target build dirs from the old fern/foresttoolchain.sh
/build-binutils/
/build-gcc/

# Downloaded + extracted sources — the ENTIRE src/ tree is regenerated by
# build-toolchain.sh from the URLs verified against checksums.txt. Nothing
# under src/ is ever committed (tarballs are 25-90MB, extracted trees huge).
/src/

# Compiled sysroot (regenerated by build-toolchain.sh from sysroot-skeleton
# + the Fern headers). The tracked source of truth is sysroot-skeleton/.
/sysroot/

# Editor / OS cruft
*.o
*.log
*.part
.DS_Store
